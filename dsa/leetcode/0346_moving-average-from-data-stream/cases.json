{
  "schema_version": 1,
  "challenge_id": "lc_346",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: window fills then expires",
      "kind": "sample",
      "visible": true,
      "input": {"size": 3, "stream": [1, 10, 3, 5]},
      "expected": [1.0, 5.5, 4.666666666666667, 6.0],
      "tags": ["sample", "source-example", "expiration"]
    },
    {
      "id": "trial-size-one",
      "name": "a one-value window always returns the newest value",
      "kind": "trial",
      "visible": true,
      "input": {"size": 1, "stream": [4, -2, 7]},
      "expected": [4.0, -2.0, 7.0],
      "tags": ["minimum-size", "expiration"]
    },
    {
      "id": "trial-partial-window",
      "name": "stream remains shorter than capacity",
      "kind": "trial",
      "visible": true,
      "input": {"size": 5, "stream": [2, 4]},
      "expected": [2.0, 3.0],
      "tags": ["partial-window", "growing-denominator"]
    },
    {
      "id": "trial-empty-stream",
      "name": "no next calls produce no averages",
      "kind": "trial",
      "visible": true,
      "input": {"size": 3, "stream": []},
      "expected": [],
      "tags": ["zero-calls", "app-adapter"]
    },
    {
      "id": "trial-single-call",
      "name": "first call averages the sole live value",
      "kind": "trial",
      "visible": true,
      "input": {"size": 4, "stream": [9]},
      "expected": [9.0],
      "tags": ["single-call", "partial-window"]
    },
    {
      "id": "trial-negatives",
      "name": "negative rolling averages retain their sign",
      "kind": "trial",
      "visible": true,
      "input": {"size": 2, "stream": [-1, -3, -5]},
      "expected": [-1.0, -2.0, -4.0],
      "tags": ["negative", "expiration"]
    },
    {
      "id": "trial-duplicates",
      "name": "duplicate values remain separate window entries",
      "kind": "trial",
      "visible": true,
      "input": {"size": 2, "stream": [7, 7, 7]},
      "expected": [7.0, 7.0, 7.0],
      "tags": ["duplicates", "expiration"]
    },
    {
      "id": "trial-growing-then-fixed",
      "name": "denominator transitions from live count to full capacity",
      "kind": "trial",
      "visible": true,
      "input": {"size": 4, "stream": [1, 2, 3, 4, 5]},
      "expected": [1.0, 1.5, 2.0, 2.5, 3.5],
      "tags": ["transition", "partial-window", "full-window"]
    },
    {
      "id": "trial-several-expirations",
      "name": "several oldest values expire in sequence",
      "kind": "trial",
      "visible": true,
      "input": {"size": 3, "stream": [5, 1, 9, 2, 8]},
      "expected": [5.0, 3.0, 5.0, 4.0, 6.333333333333333],
      "tags": ["several-expirations", "fractional-average"]
    },
    {
      "id": "trial-source-bounds",
      "name": "maximum capacity receives both value bounds",
      "kind": "trial",
      "visible": true,
      "input": {"size": 1000, "stream": [100000, -100000, 100000]},
      "expected": [100000.0, 0.0, 33333.333333333336],
      "tags": ["maximum-size", "minimum-value", "maximum-value"]
    }
  ]
}
