{
  "schema_version": 1,
  "challenge_id": "lc_1258",
  "cases": [
    {
      "id": "sample-transitive",
      "name": "sample: transitive and independent synonym groups",
      "kind": "sample",
      "visible": true,
      "input": {
        "synonyms": [["happy", "joy"], ["sad", "sorrow"], ["joy", "cheerful"]],
        "text": "I am happy today but was sad yesterday"
      },
      "expected": [
        "I am cheerful today but was sad yesterday",
        "I am cheerful today but was sorrow yesterday",
        "I am happy today but was sad yesterday",
        "I am happy today but was sorrow yesterday",
        "I am joy today but was sad yesterday",
        "I am joy today but was sorrow yesterday"
      ],
      "tags": ["sample", "source-example-1", "transitive", "independent-groups"]
    },
    {
      "id": "sample-unused-component",
      "name": "sample: disconnected group absent from the sentence",
      "kind": "sample",
      "visible": true,
      "input": {
        "synonyms": [["happy", "joy"], ["cheerful", "glad"]],
        "text": "I am happy today but was sad yesterday"
      },
      "expected": [
        "I am happy today but was sad yesterday",
        "I am joy today but was sad yesterday"
      ],
      "tags": ["sample", "source-example-2", "unused-component", "unchanged-words"]
    },
    {
      "id": "trial-transitive-repeated-group",
      "name": "one transitive group is chosen independently at two positions",
      "kind": "trial",
      "visible": true,
      "input": {
        "synonyms": [["a", "b"], ["b", "c"]],
        "text": "a is c"
      },
      "expected": [
        "a is a",
        "a is b",
        "a is c",
        "b is a",
        "b is b",
        "b is c",
        "c is a",
        "c is b",
        "c is c"
      ],
      "tags": ["transitive", "repeated-component", "independent-positions"]
    },
    {
      "id": "trial-no-pairs",
      "name": "no synonym pairs leave the sentence unchanged",
      "kind": "trial",
      "visible": true,
      "input": {
        "synonyms": [],
        "text": "no replacements"
      },
      "expected": ["no replacements"],
      "tags": ["minimum-pair-count", "unchanged"]
    },
    {
      "id": "trial-one-pair",
      "name": "one pair changes one replaceable position",
      "kind": "trial",
      "visible": true,
      "input": {
        "synonyms": [["fast", "quick"]],
        "text": "run fast"
      },
      "expected": ["run fast", "run quick"],
      "tags": ["single-pair", "single-position"]
    },
    {
      "id": "trial-text-outside-graph",
      "name": "words outside every synonym component remain unchanged",
      "kind": "trial",
      "visible": true,
      "input": {
        "synonyms": [["hot", "warm"]],
        "text": "cold day"
      },
      "expected": ["cold day"],
      "tags": ["unused-component", "unchanged-words"]
    },
    {
      "id": "trial-merge-order",
      "name": "a later pair merges two previously separate components",
      "kind": "trial",
      "visible": true,
      "input": {
        "synonyms": [["a", "b"], ["c", "d"], ["b", "c"]],
        "text": "d a"
      },
      "expected": [
        "a a", "a b", "a c", "a d",
        "b a", "b b", "b c", "b d",
        "c a", "c b", "c c", "c d",
        "d a", "d b", "d c", "d d"
      ],
      "tags": ["component-merge", "pair-order", "lexicographic-order"]
    },
    {
      "id": "trial-repeated-word",
      "name": "three occurrences of one word receive independent choices",
      "kind": "trial",
      "visible": true,
      "input": {
        "synonyms": [["x", "y"]],
        "text": "x x x"
      },
      "expected": [
        "x x x", "x x y", "x y x", "x y y",
        "y x x", "y x y", "y y x", "y y y"
      ],
      "tags": ["repeated-word", "independent-positions", "cartesian-product"]
    },
    {
      "id": "trial-undirected-equivalence",
      "name": "the second endpoint of a pair can be replaced by the first",
      "kind": "trial",
      "visible": true,
      "input": {
        "synonyms": [["calm", "quiet"]],
        "text": "quiet mind"
      },
      "expected": ["calm mind", "quiet mind"],
      "tags": ["undirected-equivalence", "reverse-endpoint"]
    },
    {
      "id": "trial-maximum-pair-count",
      "name": "ten unique pairs form one eleven-word component",
      "kind": "trial",
      "visible": true,
      "input": {
        "synonyms": [["aa", "ab"], ["ab", "ac"], ["ac", "ad"], ["ad", "ae"], ["ae", "af"], ["af", "ag"], ["ag", "ah"], ["ah", "ai"], ["ai", "aj"], ["aj", "ak"]],
        "text": "ak"
      },
      "expected": ["aa", "ab", "ac", "ad", "ae", "af", "ag", "ah", "ai", "aj", "ak"],
      "tags": ["maximum-pair-count", "transitive-chain", "lexicographic-order"]
    },
    {
      "id": "trial-maximum-word-count",
      "name": "a ten-word sentence without replaceable words stays intact",
      "kind": "trial",
      "visible": true,
      "input": {
        "synonyms": [],
        "text": "one two three four five six seven eight nine ten"
      },
      "expected": ["one two three four five six seven eight nine ten"],
      "tags": ["maximum-word-count", "single-spaces", "unchanged"]
    },
    {
      "id": "trial-maximum-synonym-length",
      "name": "ten-character synonym strings remain complete tokens",
      "kind": "trial",
      "visible": true,
      "input": {
        "synonyms": [["abcdefghij", "klmnopqrst"]],
        "text": "abcdefghij stays"
      },
      "expected": ["abcdefghij stays", "klmnopqrst stays"],
      "tags": ["maximum-synonym-length", "token-boundary"]
    }
  ]
}
