    {
      "id": "trial-ascii-lexicographic",
      "name": "codes use ascending ASCII lexicographical order",
      "kind": "trial",
      "visible": true,
      "input": {
        "code": [
          "a",
          "A",
          "1",
          "_",
          "0MvB",
          "1OFw"
        ],
        "businessLine": [
          "grocery",
          "grocery",
          "grocery",
          "grocery",
          "grocery",
          "grocery"
        ],
        "isActive": [
          true,
          true,
          true,
          true,
          true,
          true
        ]
      },
      "expected": [
        "0MvB",
        "1",
        "1OFw",
        "A",
        "_",
        "a"
      ],
      "tags": [
        "real",
        "lexicographical",
        "case-sensitive"
      ]
    },
    {
