{
  "schema_version": 1,
  "challenge_id": "lc_3606",
  "cases": [
    {
      "id": "sample-invalid-codes",
      "name": "sample: empty and punctuation-bearing codes are rejected",
      "kind": "sample",
      "visible": true,
      "input": {
        "code": [
          "SAVE20",
          "",
          "PHARMA5",
          "SAVE@20"
        ],
        "businessLine": [
          "restaurant",
          "grocery",
          "pharmacy",
          "restaurant"
        ],
        "isActive": [
          true,
          true,
          true,
          true
        ]
      },
      "expected": [
        "PHARMA5",
        "SAVE20"
      ],
      "tags": [
        "sample",
        "code-validation",
        "category-order"
      ]
    },
    {
      "id": "sample-inactive-and-category",
      "name": "sample: inactive and unknown-category coupons are rejected",
      "kind": "sample",
      "visible": true,
      "input": {
        "code": [
          "GROCERY15",
          "ELECTRONICS_50",
          "DISCOUNT10"
        ],
        "businessLine": [
          "grocery",
          "electronics",
          "invalid"
        ],
        "isActive": [
          false,
          true,
          true
        ]
      },
      "expected": [
        "ELECTRONICS_50"
      ],
      "tags": [
        "sample",
        "inactive",
        "invalid-category"
      ]
    },
