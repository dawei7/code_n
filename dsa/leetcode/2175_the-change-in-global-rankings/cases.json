{
  "schema_version": 1,
  "challenge_id": "lc_2175",
  "cases": [
    {
      "id": "sample-rank-changes",
      "name": "sample: updated tie is broken by country name",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "TeamPoints": [
            {
              "team_id": 3,
              "name": "Algeria",
              "points": 1431
            },
            {
              "team_id": 1,
              "name": "Senegal",
              "points": 2132
            },
            {
              "team_id": 2,
              "name": "New Zealand",
              "points": 1402
            },
            {
              "team_id": 4,
              "name": "Croatia",
              "points": 1817
            }
          ],
          "PointsChange": [
            {
              "team_id": 3,
              "points_change": 399
            },
            {
              "team_id": 2,
              "points_change": 0
            },
            {
              "team_id": 4,
              "points_change": 13
            },
            {
              "team_id": 1,
              "points_change": -22
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "team_id",
          "name",
          "rank_diff"
        ],
        "rows": [
          [
            1,
            "Senegal",
            0
          ],
          [
            4,
            "Croatia",
            -1
          ],
          [
            3,
            "Algeria",
            1
          ],
          [
            2,
            "New Zealand",
            0
          ]
        ]
      },
      "validator": {
        "kind": "unordered_table"
      },
      "tags": [
        "sample",
        "tie-break",
        "signed-difference"
      ]
    },
