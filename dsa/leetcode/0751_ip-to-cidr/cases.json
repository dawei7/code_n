{
  "schema_version": 1,
  "challenge_id": "lc_751",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: unaligned ten-address range",
      "kind": "sample",
      "visible": true,
      "input": {
        "ip": "255.0.0.7",
        "n": 10
      },
      "expected": [
        "255.0.0.7/32",
        "255.0.0.8/29",
        "255.0.0.16/32"
      ],
      "tags": [
        "sample",
        "unaligned"
      ]
    },
    {
      "id": "sample-2",
      "name": "sample: range split around two alignment boundaries",
      "kind": "sample",
      "visible": true,
      "input": {
        "ip": "117.145.102.62",
        "n": 8
      },
      "expected": [
        "117.145.102.62/31",
        "117.145.102.64/30",
        "117.145.102.68/31"
      ],
      "tags": [
        "sample",
        "unaligned"
      ]
    },
    {
