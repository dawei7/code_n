{
  "schema_version": 1,
  "challenge_id": "lc_341",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: sibling lists around an integer",
      "kind": "sample",
      "visible": true,
      "input": {
        "nestedList": [
          [
            1,
            1
          ],
          2,
          [
            1,
            1
          ]
        ]
      },
      "expected": [
        1,
        1,
        2,
        1,
        1
      ],
      "tags": [
        "sample"
      ]
    },
    {
      "id": "sample-2",
      "name": "sample: increasing nesting depth",
      "kind": "sample",
      "visible": true,
      "input": {
        "nestedList": [
          1,
          [
            4,
            [
              6
            ]
          ]
        ]
      },
      "expected": [
        1,
        4,
        6
      ],
      "tags": [
        "sample",
        "depth"
      ]
    },
    {
      "id": "sample-3",
      "name": "sample: only empty branches",
      "kind": "sample",
      "visible": true,
      "input": {
        "nestedList": [
          [],
          [
            []
          ]
        ]
      },
      "expected": [],
      "tags": [
        "sample",
        "empty"
      ]
    },
    {
      "id": "trial-empty",
      "name": "trial: empty outer list",
      "kind": "trial",
      "visible": true,
      "input": {
        "nestedList": []
      },
      "expected": [],
      "tags": [
        "trial",
        "empty"
      ]
    },
    {
      "id": "trial-single",
      "name": "trial: one integer",
      "kind": "trial",
      "visible": true,
      "input": {
        "nestedList": [
          7
        ]
      },
      "expected": [
        7
      ],
      "tags": [
        "trial",
        "boundary"
      ]
    },
    {
      "id": "trial-empty-between-values",
      "name": "empty branches do not interrupt order",
      "kind": "trial",
      "visible": true,
      "input": {
        "nestedList": [
          [],
          1,
          [
            [],
            2
          ],
          [
            []
          ],
          3
        ]
      },
      "expected": [
        1,
        2,
        3
      ],
      "tags": [
        "empty"
      ]
    },
    {
      "id": "trial-signed-values",
      "name": "zero and negative integers",
      "kind": "trial",
      "visible": true,
      "input": {
        "nestedList": [
          [
            -1
          ],
          0,
          [
            2,
            [
              -3
            ]
          ]
        ]
      },
      "expected": [
        -1,
        0,
        2,
        -3
      ],
      "tags": [
        "signed"
      ]
    },
    {
      "id": "trial-order",
      "name": "preserve depth-first left-to-right order",
      "kind": "trial",
      "visible": true,
      "input": {
        "nestedList": [
          1,
          [
            2,
            [
              3
            ],
            4
          ],
          5
        ]
      },
      "expected": [
        1,
        2,
        3,
        4,
        5
      ],
      "tags": [
        "order"
      ]
    }
  ]
}