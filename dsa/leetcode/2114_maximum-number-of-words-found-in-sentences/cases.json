{
  "schema_version": 1,
  "challenge_id": "lc_2114",
  "cases": [
    {
      "id": "sample-distinct-counts",
      "name": "sample: the final sentence contains the most words",
      "kind": "sample",
      "visible": true,
      "input": {
        "sentences": [
          "alice and bob love leetcode",
          "i think so too",
          "this is great thanks very much"
        ]
      },
      "expected": 6,
      "tags": [
        "sample",
        "distinct-counts"
      ]
    },
    {
      "id": "sample-tied-maximum",
      "name": "sample: two sentences tie for the maximum",
      "kind": "sample",
      "visible": true,
      "input": {
        "sentences": [
          "please wait",
          "continue to fight",
          "continue to win"
        ]
      },
      "expected": 3,
      "tags": [
        "sample",
        "tie"
      ]
    },
    {
      "id": "trial-single-word",
      "name": "one sentence with no spaces still has one word",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentences": [
          "solitary"
        ]
      },
      "expected": 1,
      "tags": [
        "minimum",
        "no-spaces"
      ]
    },
    {
      "id": "trial-three-way-tie",
      "name": "all maximum sentences may have the same count",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentences": [
          "one two three",
          "four five six",
          "red blue green",
          "last"
        ]
      },
      "expected": 3,
      "tags": [
        "tie",
        "multiple-sentences"
      ]
    },
    {
      "id": "trial-first-is-longest",
      "name": "the first sentence establishes the maximum",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentences": [
          "a b c d e",
          "f",
          "g h"
        ]
      },
      "expected": 5,
      "tags": [
        "first-maximum"
      ]
    },
    {
      "id": "trial-last-overtakes",
      "name": "later sentences repeatedly raise the maximum",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentences": [
          "a",
          "b c",
          "d e f",
          "g h i j",
          "k l m n o"
        ]
      },
      "expected": 5,
      "tags": [
        "increasing-counts"
      ]
    },
    {
      "id": "trial-maximum-length",
      "name": "a 99-character sentence contains fifty words",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentences": [
          "a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a",
          "short sentence"
        ]
      },
      "expected": 50,
      "tags": [
        "maximum-length",
        "many-words"
      ]
    },
    {
      "id": "trial-boundary-8",
      "name": "single element in sentences",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentences": [
          "alice and bob love leetcode"
        ]
      },
      "expected": 5,
      "tags": [
        "boundary",
        "single-element"
      ]
    },
    {
      "id": "trial-boundary-9",
      "name": "identical elements in sentences",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentences": [
          "alice and bob love leetcode",
          "alice and bob love leetcode"
        ]
      },
      "expected": 5,
      "tags": [
        "boundary",
        "duplicates"
      ]
    }
  ]
