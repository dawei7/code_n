{
  "schema_version": 1,
  "challenge_id": "lc_1364",
  "cases": [
    {
      "id": "sample-source-example",
      "name": "sample: exact source example with mixed trust and repeated invoices",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Customers": [
            {"customer_id": 1, "customer_name": "Alice", "email": "alice@leetcode.com"},
            {"customer_id": 2, "customer_name": "Bob", "email": "bob@leetcode.com"},
            {"customer_id": 13, "customer_name": "John", "email": "john@leetcode.com"},
            {"customer_id": 6, "customer_name": "Alex", "email": "alex@leetcode.com"}
          ],
          "Contacts": [
            {"user_id": 1, "contact_name": "Bob", "contact_email": "bob@leetcode.com"},
            {"user_id": 1, "contact_name": "John", "contact_email": "john@leetcode.com"},
            {"user_id": 1, "contact_name": "Jal", "contact_email": "jal@leetcode.com"},
            {"user_id": 2, "contact_name": "Omar", "contact_email": "omar@leetcode.com"},
            {"user_id": 2, "contact_name": "Meir", "contact_email": "meir@leetcode.com"},
            {"user_id": 6, "contact_name": "Alice", "contact_email": "alice@leetcode.com"}
          ],
          "Invoices": [
            {"invoice_id": 77, "price": 100, "user_id": 1},
            {"invoice_id": 88, "price": 200, "user_id": 1},
            {"invoice_id": 99, "price": 300, "user_id": 2},
            {"invoice_id": 66, "price": 400, "user_id": 2},
            {"invoice_id": 55, "price": 500, "user_id": 13},
            {"invoice_id": 44, "price": 60, "user_id": 6}
          ]
        }
      },
      "expected": {
        "columns": ["invoice_id", "customer_name", "price", "contacts_cnt", "trusted_contacts_cnt"],
        "rows": [
          [44, "Alex", 60, 1, 1],
          [55, "John", 500, 0, 0],
          [66, "Bob", 400, 2, 0],
          [77, "Alice", 100, 3, 2],
          [88, "Alice", 200, 3, 2],
          [99, "Bob", 300, 2, 0]
        ]
      },
      "tags": ["sample", "source-exact", "mixed-trust", "ordered-output"]
    },
    {
      "id": "trial-no-trusted",
      "name": "trial: all contacts are external",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Customers": [
            {"customer_id": 1, "customer_name": "A", "email": "a@shop.com"},
            {"customer_id": 2, "customer_name": "B", "email": "b@shop.com"}
          ],
          "Contacts": [
            {"user_id": 1, "contact_name": "X", "contact_email": "x@outside.com"},
            {"user_id": 2, "contact_name": "Y", "contact_email": "y@outside.com"}
          ],
          "Invoices": [{"invoice_id": 1, "price": 10, "user_id": 1}, {"invoice_id": 2, "price": 20, "user_id": 2}]
        }
      },
      "expected": {
        "columns": ["invoice_id", "customer_name", "price", "contacts_cnt", "trusted_contacts_cnt"],
        "rows": [[1, "A", 10, 1, 0], [2, "B", 20, 1, 0]]
      },
      "tags": ["trial", "external-contacts", "zero-trusted"]
    },
    {
      "id": "trial-no-contacts",
      "name": "trial: invoiced customer has no contacts",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Customers": [
            {"customer_id": 1, "customer_name": "A", "email": "a@shop.com"},
            {"customer_id": 2, "customer_name": "B", "email": "b@shop.com"}
          ],
          "Contacts": [{"user_id": 2, "contact_name": "A", "contact_email": "a@shop.com"}],
          "Invoices": [{"invoice_id": 5, "price": 50, "user_id": 1}]
        }
      },
      "expected": {
        "columns": ["invoice_id", "customer_name", "price", "contacts_cnt", "trusted_contacts_cnt"],
        "rows": [[5, "A", 50, 0, 0]]
      },
      "tags": ["trial", "zero-contacts", "left-join"]
    },
    {
      "id": "trial-repeat-invoices",
      "name": "trial: two invoices reuse one owner's counts",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Customers": [
            {"customer_id": 1, "customer_name": "A", "email": "a@shop.com"},
            {"customer_id": 2, "customer_name": "B", "email": "b@shop.com"}
          ],
          "Contacts": [{"user_id": 1, "contact_name": "B", "contact_email": "b@shop.com"}],
          "Invoices": [{"invoice_id": 9, "price": 90, "user_id": 1}, {"invoice_id": 3, "price": 30, "user_id": 1}]
        }
      },
      "expected": {
        "columns": ["invoice_id", "customer_name", "price", "contacts_cnt", "trusted_contacts_cnt"],
        "rows": [[3, "A", 30, 1, 1], [9, "A", 90, 1, 1]]
      },
      "tags": ["trial", "multiple-invoices", "ordered-output"]
    },
    {
      "id": "trial-name-does-not-determine-trust",
      "name": "trial: email determines trust despite a different contact name",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Customers": [
            {"customer_id": 1, "customer_name": "A", "email": "a@shop.com"},
            {"customer_id": 2, "customer_name": "Registered", "email": "trusted@shop.com"}
          ],
          "Contacts": [{"user_id": 1, "contact_name": "Different Alias", "contact_email": "trusted@shop.com"}],
          "Invoices": [{"invoice_id": 4, "price": 44, "user_id": 1}]
        }
      },
      "expected": {
        "columns": ["invoice_id", "customer_name", "price", "contacts_cnt", "trusted_contacts_cnt"],
        "rows": [[4, "A", 44, 1, 1]]
      },
      "tags": ["trial", "email-membership", "name-irrelevant"]
    },
    {
      "id": "trial-self-email",
      "name": "trial: the owner's registered email is trusted",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Customers": [{"customer_id": 1, "customer_name": "A", "email": "a@shop.com"}],
          "Contacts": [{"user_id": 1, "contact_name": "Self", "contact_email": "a@shop.com"}],
          "Invoices": [{"invoice_id": 2, "price": 12, "user_id": 1}]
        }
      },
      "expected": {
        "columns": ["invoice_id", "customer_name", "price", "contacts_cnt", "trusted_contacts_cnt"],
        "rows": [[2, "A", 12, 1, 1]]
      },
      "tags": ["trial", "self-email", "registered-email"]
    },
    {
      "id": "trial-order-and-zero",
      "name": "trial: invoice ordering includes an owner with zero contacts",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Customers": [
            {"customer_id": 1, "customer_name": "A", "email": "a@shop.com"},
            {"customer_id": 2, "customer_name": "B", "email": "b@shop.com"}
          ],
          "Contacts": [{"user_id": 1, "contact_name": "B", "contact_email": "b@shop.com"}],
          "Invoices": [{"invoice_id": 20, "price": 2, "user_id": 1}, {"invoice_id": 10, "price": 1, "user_id": 2}]
        }
      },
      "expected": {
        "columns": ["invoice_id", "customer_name", "price", "contacts_cnt", "trusted_contacts_cnt"],
        "rows": [[10, "B", 1, 0, 0], [20, "A", 2, 1, 1]]
      },
      "tags": ["trial", "ordered-output", "zero-contacts"]
    }
  ]
}
