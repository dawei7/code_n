          -2,
          -8
        ]
      },
      "expected": 6,
      "tags": [
        "all-negative"
      ]
    },
    {
      "id": "trial-increasing-positive",
      "name": "the final singleton beats alternating prefixes",
      "kind": "trial",
      "visible": true,
      "input": {
        "nums": [
