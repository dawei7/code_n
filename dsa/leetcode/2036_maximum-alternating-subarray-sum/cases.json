      "visible": true,
      "input": {
        "nums": [
          -10,
          100,
          -10
        ]
      },
      "expected": 110,
      "tags": [
        "restart",
        "contiguous"
      ]
    },
    {
      "id": "trial-all-negative",
      "name": "an even all-negative segment can be positive",
