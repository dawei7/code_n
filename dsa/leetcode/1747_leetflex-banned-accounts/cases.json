      ]
    },
    {
      "id": "trial-shared-endpoint",
      "name": "different addresses meet at one timestamp",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "LogInfo": [
            {
              "account_id": 4,
              "ip_address": "left",
              "login": "2023-01-01 08:00:00",
              "logout": "2023-01-01 09:00:00"
            },
            {
              "account_id": 4,
              "ip_address": "right",
              "login": "2023-01-01 09:00:00",
              "logout": "2023-01-01 10:00:00"
            }
          ]
        }
      },
      "expected": {
