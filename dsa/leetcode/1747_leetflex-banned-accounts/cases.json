{
  "schema_version": 1,
  "challenge_id": "lc_1747",
  "cases": [
    {
      "id": "sample-overlapping-addresses",
      "name": "sample: one account overlaps across addresses",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "LogInfo": [
            {
              "account_id": 1,
              "ip_address": "10.0.0.1",
              "login": "2021-02-01 09:00:00",
              "logout": "2021-02-01 10:00:00"
            },
            {
              "account_id": 1,
              "ip_address": "10.0.0.2",
              "login": "2021-02-01 09:30:00",
              "logout": "2021-02-01 11:00:00"
            },
            {
              "account_id": 2,
              "ip_address": "10.0.0.3",
              "login": "2021-02-01 08:00:00",
              "logout": "2021-02-01 08:30:00"
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "account_id"
        ],
        "rows": [
          [
            1
          ]
        ]
      },
      "tags": [
        "sample",
        "partial-overlap"
      ]
    },
    {
      "id": "trial-sequential-addresses",
      "name": "trial: different addresses used sequentially",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "LogInfo": [
            {
              "account_id": 2,
