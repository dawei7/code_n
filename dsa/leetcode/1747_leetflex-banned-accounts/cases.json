            {
              "account_id": 2,
              "ip_address": "b",
              "login": "2022-01-01 10:00:01",
              "logout": "2022-01-01 11:00:00"
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "account_id"
        ],
        "rows": []
      },
      "tags": [
        "nonoverlap",
        "empty-result"
      ]
    },
    {
      "id": "trial-same-address-overlap",
