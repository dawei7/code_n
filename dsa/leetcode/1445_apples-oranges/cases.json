{
  "schema_version": 1,
  "challenge_id": "lc_1445",
  "cases": [
    {
      "id": "sample-source-example",
      "name": "source example: positive, zero, and negative differences",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Sales": [
            {"sale_date": "2020-05-01", "fruit": "apples", "sold_num": 10},
            {"sale_date": "2020-05-01", "fruit": "oranges", "sold_num": 8},
            {"sale_date": "2020-05-02", "fruit": "apples", "sold_num": 15},
            {"sale_date": "2020-05-02", "fruit": "oranges", "sold_num": 15},
            {"sale_date": "2020-05-03", "fruit": "apples", "sold_num": 20},
            {"sale_date": "2020-05-03", "fruit": "oranges", "sold_num": 0},
            {"sale_date": "2020-05-04", "fruit": "apples", "sold_num": 15},
            {"sale_date": "2020-05-04", "fruit": "oranges", "sold_num": 16}
          ]
        }
      },
      "expected": {
        "columns": ["sale_date", "diff"],
        "rows": [
          ["2020-05-01", 2],
          ["2020-05-02", 0],
          ["2020-05-03", 20],
          ["2020-05-04", -1]
        ]
      },
      "tags": ["sample", "source-example", "ordered-result"]
    },
    {
      "id": "trial-equal-sales",
      "name": "equal apple and orange sales produce zero",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Sales": [
            {"sale_date": "2021-01-10", "fruit": "oranges", "sold_num": 7},
            {"sale_date": "2021-01-10", "fruit": "apples", "sold_num": 7}
          ]
        }
      },
      "expected": {
        "columns": ["sale_date", "diff"],
        "rows": [["2021-01-10", 0]]
      },
      "tags": ["trial", "zero-difference", "reversed-fruit-order"]
    },
    {
      "id": "trial-orange-lead",
      "name": "oranges exceed apples and preserve a negative difference",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Sales": [
            {"sale_date": "2021-02-01", "fruit": "apples", "sold_num": 2},
            {"sale_date": "2021-02-01", "fruit": "oranges", "sold_num": 9}
          ]
        }
      },
      "expected": {
        "columns": ["sale_date", "diff"],
        "rows": [["2021-02-01", -7]]
      },
      "tags": ["trial", "negative-difference"]
    },
    {
      "id": "trial-zero-oranges",
      "name": "zero orange sales leave the apple quantity",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Sales": [
            {"sale_date": "2022-03-15", "fruit": "oranges", "sold_num": 0},
            {"sale_date": "2022-03-15", "fruit": "apples", "sold_num": 25}
          ]
        }
      },
      "expected": {
        "columns": ["sale_date", "diff"],
        "rows": [["2022-03-15", 25]]
      },
      "tags": ["trial", "zero-units", "positive-difference"]
    },
    {
      "id": "trial-zero-apples",
      "name": "zero apple sales negate the orange quantity",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Sales": [
            {"sale_date": "2022-03-16", "fruit": "apples", "sold_num": 0},
            {"sale_date": "2022-03-16", "fruit": "oranges", "sold_num": 31}
          ]
        }
      },
      "expected": {
        "columns": ["sale_date", "diff"],
        "rows": [["2022-03-16", -31]]
      },
      "tags": ["trial", "zero-units", "negative-difference"]
    },
    {
      "id": "trial-both-zero",
      "name": "both fruit quantities may be zero",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Sales": [
            {"sale_date": "2022-03-17", "fruit": "oranges", "sold_num": 0},
            {"sale_date": "2022-03-17", "fruit": "apples", "sold_num": 0}
          ]
        }
      },
      "expected": {
        "columns": ["sale_date", "diff"],
        "rows": [["2022-03-17", 0]]
      },
      "tags": ["trial", "both-zero", "zero-difference"]
    },
    {
      "id": "trial-chronological-order",
      "name": "shuffled input dates must be returned chronologically",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Sales": [
            {"sale_date": "2023-12-31", "fruit": "oranges", "sold_num": 18},
            {"sale_date": "2020-01-01", "fruit": "apples", "sold_num": 5},
            {"sale_date": "2023-12-31", "fruit": "apples", "sold_num": 20},
            {"sale_date": "2020-01-01", "fruit": "oranges", "sold_num": 8},
            {"sale_date": "2022-06-30", "fruit": "oranges", "sold_num": 3},
            {"sale_date": "2022-06-30", "fruit": "apples", "sold_num": 11}
          ]
        }
      },
      "expected": {
        "columns": ["sale_date", "diff"],
        "rows": [
          ["2020-01-01", -3],
          ["2022-06-30", 8],
          ["2023-12-31", 2]
        ]
      },
      "tags": ["trial", "chronological-order", "shuffled-input"]
    },
    {
      "id": "trial-large-quantities",
      "name": "large legal integer quantities remain signed",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Sales": [
            {"sale_date": "2040-07-07", "fruit": "apples", "sold_num": 2147483647},
            {"sale_date": "2040-07-07", "fruit": "oranges", "sold_num": 2147483646},
            {"sale_date": "2040-07-08", "fruit": "oranges", "sold_num": 2147483647},
            {"sale_date": "2040-07-08", "fruit": "apples", "sold_num": 0}
          ]
        }
      },
      "expected": {
        "columns": ["sale_date", "diff"],
        "rows": [
          ["2040-07-07", 1],
          ["2040-07-08", -2147483647]
        ]
      },
      "tags": ["trial", "integer-boundaries", "signed-difference"]
    },
    {
      "id": "trial-empty-sales",
      "name": "an empty Sales table produces an empty ordered result",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Sales": {
            "columns": ["sale_date", "fruit", "sold_num"],
            "rows": []
          }
        }
      },
      "expected": {
        "columns": ["sale_date", "diff"],
        "rows": []
      },
      "tags": ["trial", "empty-table", "empty-output"]
    }
  ]
}
