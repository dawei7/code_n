      "visible": true,
      "input": {
        "arr": [1, 3, 2, 3, 5, 0]
      },
      "expected": 3,
      "tags": ["trial", "mixed-order", "lower-bound"]
    },
    {
      "id": "trial-duplicate-values",
      "name": "trial: duplicate values share one successor",
      "kind": "trial",
      "visible": true,
      "input": {
        "arr": [1, 1, 2]
      },
      "expected": 2,
      "tags": ["trial", "duplicate-values", "successor-reuse"]
    },
    {
      "id": "trial-duplicate-successors",
      "name": "trial: duplicate successors do not multiply a contribution",
