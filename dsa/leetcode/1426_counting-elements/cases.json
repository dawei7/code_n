      },
      "expected": 2,
      "tags": ["sample", "source-example", "chain"]
    },
    {
      "id": "sample-source-example-2",
      "name": "sample: exact source with no successors",
      "kind": "sample",
      "visible": true,
      "input": {
        "arr": [1, 1, 3, 3, 5, 5, 7, 7]
      },
      "expected": 0,
      "tags": ["sample", "source-example", "duplicates", "no-successors"]
    },
    {
      "id": "trial-mixed-order",
      "name": "trial: several qualifying values in mixed order",
