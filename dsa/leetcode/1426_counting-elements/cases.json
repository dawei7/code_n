      "visible": true,
      "input": {
        "arr": [1, 2, 2]
      },
      "expected": 1,
      "tags": ["trial", "duplicate-successors", "presence-only"]
    },
    {
      "id": "trial-singleton",
      "name": "trial: a singleton has no successor",
      "kind": "trial",
      "visible": true,
      "input": {
        "arr": [0]
      },
      "expected": 0,
      "tags": ["trial", "singleton", "lower-bound"]
    },
    {
      "id": "trial-one-successor-many-values",
      "name": "trial: one successor qualifies many equal values",
      "kind": "trial",
      "visible": true,
      "input": {
        "arr": [4, 4, 4, 5]
      },
      "expected": 3,
      "tags": ["trial", "multiplicity", "successor-reuse"]
    },
    {
      "id": "trial-upper-bound",
      "name": "trial: upper-bound values cannot have a legal successor",
      "kind": "trial",
      "visible": true,
      "input": {
        "arr": [999, 1000, 1000]
      },
