{
  "schema_version": 1,
  "challenge_id": "lc_702",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample 1: target occurs at index four",
      "kind": "sample",
      "visible": true,
      "input": {"reader": [-1,0,3,5,9,12], "target": 9},
      "expected": 4,
      "tags": ["sample", "source-example", "found"]
    },
    {
      "id": "sample-2",
      "name": "sample 2: target is absent between stored values",
      "kind": "sample",
      "visible": true,
      "input": {"reader": [-1,0,3,5,9,12], "target": 2},
      "expected": -1,
      "tags": ["sample", "source-example", "not-found", "interior-gap"]
    },
    {
      "id": "trial-1",
      "name": "trial: minimum-length reader contains the minimum value",
      "kind": "trial",
      "visible": true,
      "input": {"reader": [-10000], "target": -10000},
      "expected": 0,
      "tags": ["trial", "minimum-length", "minimum-value", "minimum-target", "first-index"]
    },
    {
      "id": "trial-2",
      "name": "trial: singleton miss spans both value extrema",
      "kind": "trial",
      "visible": true,
      "input": {"reader": [10000], "target": -10000},
      "expected": -1,
      "tags": ["trial", "minimum-length", "maximum-value", "minimum-target", "below-range"]
    },
    {
      "id": "trial-3",
      "name": "trial: target lies below the first stored value",
      "kind": "trial",
      "visible": true,
      "input": {"reader": [-9999,-5,10000], "target": -10000},
      "expected": -1,
      "tags": ["trial", "minimum-target", "below-range"]
    },
    {
      "id": "trial-4",
      "name": "trial: target lies above the final stored value",
      "kind": "trial",
      "visible": true,
      "input": {"reader": [-10000,-5,9999], "target": 10000},
      "expected": -1,
      "tags": ["trial", "maximum-target", "above-range", "sentinel"]
    },
    {
      "id": "trial-5",
      "name": "trial: repeated doubling reaches the final value",
      "kind": "trial",
      "visible": true,
      "input": {"reader": [1,2,4,8,16], "target": 16},
      "expected": 4,
      "tags": ["trial", "last-index", "exponential-bracketing"]
    },
    {
      "id": "trial-6",
      "name": "trial: negative target occurs at the first index",
      "kind": "trial",
      "visible": true,
      "input": {"reader": [-20,-10,-3,0,11], "target": -20},
      "expected": 0,
      "tags": ["trial", "negative-values", "first-index"]
    },
    {
      "id": "trial-7",
      "name": "trial: target is missing immediately below the maximum value",
      "kind": "trial",
      "visible": true,
      "input": {"reader": [-10000,-1,0,1,10000], "target": 9999},
      "expected": -1,
      "tags": ["trial", "interior-gap", "near-maximum"]
    },
    {
      "id": "trial-8",
      "name": "trial: maximum value occurs after expansion crosses the boundary",
      "kind": "trial",
      "visible": true,
      "input": {"reader": [-10000,-5,0,5,9999,10000], "target": 10000},
      "expected": 5,
      "tags": ["trial", "maximum-value", "maximum-target", "last-index", "sentinel"]
    },
    {
      "id": "trial-9",
      "name": "trial: target is found at the initial right boundary",
      "kind": "trial",
      "visible": true,
      "input": {"reader": [-5,0,5], "target": 0},
      "expected": 1,
      "tags": ["trial", "initial-bracket", "interior-index"]
    }
  ]
}
