  "cases": [
    {
      "id": "sample-1",
      "name": "sample: insufficient hours and an employee without logs",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Employees": [
            {
              "employee_id": 1,
              "needed_hours": 20
            },
            {
              "employee_id": 2,
              "needed_hours": 12
            },
            {
              "employee_id": 3,
              "needed_hours": 2
            }
          ],
          "Logs": [
            {
              "employee_id": 1,
              "in_time": "2022-10-01 09:00:00",
              "out_time": "2022-10-01 17:00:00"
            },
            {
              "employee_id": 1,
              "in_time": "2022-10-06 09:05:04",
              "out_time": "2022-10-06 17:09:03"
            },
            {
              "employee_id": 1,
              "in_time": "2022-10-12 23:00:00",
              "out_time": "2022-10-13 03:00:01"
            },
            {
              "employee_id": 2,
              "in_time": "2022-10-29 12:00:00",
              "out_time": "2022-10-29 23:58:58"
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "employee_id"
        ],
        "rows": [
          [
            2
          ],
          [
            3
          ]
        ]
      },
      "tags": [
        "sample",
        "no-logs",
        "overnight"
      ]
    },
