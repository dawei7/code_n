      },
      "expected": [
        0,
        1,
        2
      ],
      "tags": [
        "non-preemptive",
        "arrival-during-task"
      ]
    },
    {
      "id": "real-arrival-at-completion",
      "name": "task arriving exactly at completion is eligible",
      "kind": "trial",
      "visible": true,
      "input": {
        "tasks": [
          [
            1,
            3
          ],
          [
            4,
            1
          ],
          [
            1,
            5
          ]
        ]
      },
      "expected": [
        0,
        1,
        2
      ],
      "tags": [
        "completion-time",
        "eligibility"
      ]
    },
    {
      "id": "real-unsorted-enqueue-input",
