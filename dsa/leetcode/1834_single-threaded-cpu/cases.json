{
  "schema_version": 1,
  "challenge_id": "lc_1834",
  "cases": [
    {
      "id": "example-overlapping-arrivals",
      "name": "sample: shorter waiting tasks run first",
      "kind": "sample",
      "visible": true,
      "input": {
        "tasks": [
          [
            1,
            2
          ],
          [
            2,
            4
          ],
          [
            3,
            2
          ],
          [
            4,
            1
          ]
        ]
      },
      "expected": [
        0,
        2,
        3,
        1
      ],
      "tags": [
        "example",
        "overlap"
      ]
    },
    {
      "id": "example-same-enqueue",
      "name": "sample: all tasks arrive together",
      "kind": "sample",
      "visible": true,
      "input": {
        "tasks": [
          [
            7,
            10
          ],
          [
            7,
            12
          ],
          [
            7,
            5
          ],
          [
            7,
            4
          ],
          [
            7,
            2
          ]
        ]
      },
      "expected": [
        4,
        3,
        2,
        0,
        1
      ],
      "tags": [
        "example",
        "same-enqueue"
      ]
    },
    {
      "id": "trial-idle-gaps",
      "name": "separate arrivals require clock jumps",
      "kind": "trial",
      "visible": true,
      "input": {
        "tasks": [
          [
            5,
            2
          ],
          [
            100,
            1
          ]
        ]
      },
      "expected": [
        0,
        1
      ],
      "tags": [
        "idle",
        "clock-jump"
      ]
    },
    {
      "id": "trial-processing-tie",
      "name": "equal durations use original indices",
      "kind": "trial",
      "visible": true,
      "input": {
        "tasks": [
          [
            1,
            3
          ],
          [
            1,
            3
          ],
          [
            1,
            3
          ]
        ]
      },
      "expected": [
        0,
        1,
        2
      ],
      "tags": [
        "tie-break",
        "same-enqueue"
      ]
    },
    {
      "id": "trial-nonpreemptive",
