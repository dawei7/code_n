              "product_id": 1,
              "store": "B",
              "price": 20
            },
            {
              "product_id": 2,
              "store": "A",
              "price": 30
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "product_id",
          "A",
          "B"
        ],
        "rows": [
          [
            1,
            null,
            20
          ],
          [
            2,
            30,
            null
          ]
        ]
      },
      "validator": {
        "kind": "unordered_table"
      },
      "tags": [
        "column-order"
      ]
    },
    {
