{
  "schema_version": 1,
  "challenge_id": "lc_2252",
  "cases": [
    {
      "id": "sample-four-stores",
      "name": "sample: sparse prices across four ordered stores",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Products": [
            {
              "product_id": 1,
              "store": "Shop",
              "price": 110
            },
            {
              "product_id": 1,
              "store": "LC_Store",
              "price": 100
            },
            {
              "product_id": 2,
              "store": "Nozama",
              "price": 200
            },
            {
              "product_id": 2,
              "store": "Souq",
              "price": 190
            },
            {
              "product_id": 3,
              "store": "Shop",
              "price": 1000
            },
            {
              "product_id": 3,
              "store": "Souq",
              "price": 1900
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "product_id",
          "LC_Store",
          "Nozama",
          "Shop",
          "Souq"
        ],
        "rows": [
          [
            1,
            100,
            null,
            110,
            null
          ],
          [
            2,
            null,
            200,
            null,
            190
          ],
          [
            3,
            null,
            null,
            1000,
            1900
          ]
        ]
      },
      "validator": {
        "kind": "unordered_table"
      },
      "tags": [
        "sample",
        "sparse-pivot"
      ]
    },
    {
      "id": "trial-one-store",
      "name": "one store creates one dynamic price column",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Products": [
            {
              "product_id": 7,
              "store": "Only",
              "price": 42
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "product_id",
          "Only"
        ],
        "rows": [
          [
            7,
            42
          ]
        ]
      },
      "validator": {
        "kind": "unordered_table"
      },
      "tags": [
        "single-store"
      ]
    },
    {
      "id": "trial-column-order",
      "name": "store columns are lexicographically ordered",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Products": [
