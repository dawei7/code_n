{
  "schema_version": 1,
  "challenge_id": "lc_333",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: invalid right subtree",
      "kind": "sample",
      "visible": true,
      "input": {
        "root": [10, 5, 15, 1, 8, null, 7]
      },
      "expected": 3,
      "tags": ["sample", "source-example"]
    },
    {
      "id": "sample-2",
      "name": "sample: largest BST below repeated values",
      "kind": "sample",
      "visible": true,
      "input": {
        "root": [4, 2, 7, 2, 3, 5, null, 2, null, null, null, null, null, 1]
      },
      "expected": 2,
      "tags": ["sample", "source-example", "duplicates"]
    },
    {
      "id": "trial-empty",
      "name": "empty tree",
      "kind": "trial",
      "visible": true,
      "input": {
        "root": []
      },
      "expected": 0,
      "tags": ["empty", "minimum-size"]
    },
    {
      "id": "trial-single-minimum",
      "name": "single node at the minimum value",
      "kind": "trial",
      "visible": true,
      "input": {
        "root": [-10000]
      },
      "expected": 1,
      "tags": ["single-node", "minimum-value"]
    },
    {
      "id": "trial-duplicate-boundary",
      "name": "duplicate left child violates strict ordering",
      "kind": "trial",
      "visible": true,
      "input": {
        "root": [2, 2, 3]
      },
      "expected": 1,
      "tags": ["duplicates", "strict-ordering"]
    },
    {
      "id": "trial-deep-boundary-violation",
      "name": "valid child BSTs cannot be joined across the root",
      "kind": "trial",
      "visible": true,
      "input": {
        "root": [10, 5, 15, 1, 8, 6, 20]
      },
      "expected": 3,
      "tags": ["global-boundary", "largest-descendant"]
    },
    {
      "id": "trial-value-extremes",
      "name": "whole BST uses both value bounds",
      "kind": "trial",
      "visible": true,
      "input": {
        "root": [0, -10000, 10000]
      },
      "expected": 3,
      "tags": ["minimum-value", "maximum-value", "whole-tree"]
    },
    {
      "id": "trial-left-skewed",
      "name": "left-skewed tree is entirely a BST",
      "kind": "trial",
      "visible": true,
      "input": {
        "root": [5, 4, null, 3, null, 2, null, 1]
      },
      "expected": 5,
      "tags": ["skewed", "whole-tree"]
    },
    {
      "id": "trial-negative-balanced",
      "name": "balanced BST crosses zero",
      "kind": "trial",
      "visible": true,
      "input": {
        "root": [0, -2, 2, -3, -1, 1, 3]
      },
      "expected": 7,
      "tags": ["negative", "balanced", "whole-tree"]
    },
    {
      "id": "trial-complete-subtree",
      "name": "a rooted subtree must retain every descendant",
      "kind": "trial",
      "visible": true,
      "input": {
        "root": [10, 5, 15, 1, 12, null, 20]
      },
      "expected": 3,
      "tags": ["complete-subtree", "global-boundary", "largest-descendant"]
    },
    {
      "id": "trial-all-duplicates",
      "name": "equal parent and children leave only singleton BSTs",
      "kind": "trial",
      "visible": true,
      "input": {
        "root": [2, 2, 2]
      },
      "expected": 1,
      "tags": ["duplicates", "strict-ordering"]
    }
  ]
}
