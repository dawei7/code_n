{
  "schema_version": 1,
  "challenge_id": "lc_1098",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: old books with low recent sales",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Books": [
            {"book_id": 1, "name": "Kalila And Demna", "available_from": "2010-01-01"},
            {"book_id": 2, "name": "28 Letters", "available_from": "2012-05-12"},
            {"book_id": 3, "name": "The Hobbit", "available_from": "2019-06-10"},
            {"book_id": 4, "name": "13 Reasons Why", "available_from": "2019-06-01"},
            {"book_id": 5, "name": "The Hunger Games", "available_from": "2008-09-21"}
          ],
          "Orders": [
            {"order_id": 1, "book_id": 1, "quantity": 2, "dispatch_date": "2018-07-26"},
            {"order_id": 2, "book_id": 1, "quantity": 1, "dispatch_date": "2018-11-05"},
            {"order_id": 3, "book_id": 3, "quantity": 8, "dispatch_date": "2019-06-11"},
            {"order_id": 4, "book_id": 4, "quantity": 6, "dispatch_date": "2019-06-05"},
            {"order_id": 5, "book_id": 4, "quantity": 5, "dispatch_date": "2019-06-20"},
            {"order_id": 6, "book_id": 5, "quantity": 9, "dispatch_date": "2009-02-02"},
            {"order_id": 7, "book_id": 5, "quantity": 8, "dispatch_date": "2010-04-13"}
          ]
        }
      },
      "expected": {
        "columns": ["book_id", "name"],
        "rows": [[1, "Kalila And Demna"], [2, "28 Letters"], [5, "The Hunger Games"]]
      },
      "tags": ["sample", "date-window"]
    },
    {
      "id": "trial-no-orders",
      "name": "an eligible book with no orders has zero sales",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Books": [
            {"book_id": 1, "name": "Quiet", "available_from": "2010-01-01"}
          ],
          "Orders": {
            "columns": ["order_id", "book_id", "quantity", "dispatch_date"],
            "rows": []
          }
        }
      },
      "expected": {
        "columns": ["book_id", "name"],
        "rows": [[1, "Quiet"]]
      },
      "tags": ["trial", "left-join", "zero-sales", "empty-orders"]
    },
    {
      "id": "trial-order-endpoints",
      "name": "both endpoints of the last-year window count",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Books": [
            {"book_id": 7, "name": "Edges", "available_from": "2018-01-01"}
          ],
          "Orders": [
            {"order_id": 1, "book_id": 7, "quantity": 4, "dispatch_date": "2018-06-23"},
            {"order_id": 2, "book_id": 7, "quantity": 6, "dispatch_date": "2019-06-23"}
          ]
        }
      },
      "expected": {
        "columns": ["book_id", "name"],
        "rows": []
      },
      "tags": ["trial", "window-boundaries", "exact-ten"]
    },
    {
      "id": "trial-quantity-sum",
      "name": "popularity uses summed quantity rather than order count",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Books": [
            {"book_id": 10, "name": "Same Name", "available_from": "2010-01-01"},
            {"book_id": 11, "name": "Same Name", "available_from": "2010-01-01"}
          ],
          "Orders": [
            {"order_id": 1, "book_id": 10, "quantity": 3, "dispatch_date": "2018-07-01"},
            {"order_id": 2, "book_id": 10, "quantity": 3, "dispatch_date": "2019-01-01"},
            {"order_id": 3, "book_id": 10, "quantity": 3, "dispatch_date": "2019-06-01"},
            {"order_id": 4, "book_id": 11, "quantity": 10, "dispatch_date": "2019-01-01"}
          ]
        }
      },
      "expected": {
        "columns": ["book_id", "name"],
        "rows": [[10, "Same Name"]]
      },
      "tags": ["trial", "quantity-sum", "duplicate-names", "strict-threshold"]
    },
    {
      "id": "trial-empty-books",
      "name": "empty book and order tables produce no result",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Books": {
            "columns": ["book_id", "name", "available_from"],
            "rows": []
          },
          "Orders": {
            "columns": ["order_id", "book_id", "quantity", "dispatch_date"],
            "rows": []
          }
        }
      },
      "expected": {
        "columns": ["book_id", "name"],
        "rows": []
      },
      "tags": ["trial", "empty-input", "empty-output"]
    }
  ]
}
