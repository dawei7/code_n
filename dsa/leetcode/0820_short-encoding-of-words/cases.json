      "visible": true,
      "input": {
        "words": [
          "a",
          "aa",
          "aaa",
          "baaa"
        ]
      },
      "expected": 5,
      "tags": [
        "nested-suffixes"
      ]
    },
    {
      "id": "trial-ext-3",
      "name": "duplicates across two leaf branches",
