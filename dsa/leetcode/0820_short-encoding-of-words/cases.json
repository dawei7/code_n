      },
      "expected": 8,
      "tags": [
        "trial",
        "suffix-chain"
      ]
    },
    {
      "id": "trial-3",
      "name": "trial: shared suffix with two leaves",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "time",
          "lime",
          "me"
        ]
      },
      "expected": 10,
      "tags": [
        "trial",
        "branching"
      ]
    },
    {
      "id": "trial-ext-1",
      "name": "longer word added after its suffixes",
