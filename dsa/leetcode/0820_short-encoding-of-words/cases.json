          "t"
        ]
      },
      "expected": 2,
      "tags": [
        "sample",
        "single"
      ]
    },
    {
      "id": "sample-3",
      "name": "sample: duplicate and suffix share one segment",
      "kind": "sample",
      "visible": true,
      "input": {
        "words": [
          "time",
          "time",
          "me"
        ]
      },
      "expected": 5,
      "tags": [
        "sample",
        "duplicate"
      ]
    },
    {
      "id": "trial-1",
      "name": "trial: no suffix relationships",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "a",
          "b",
          "c"
        ]
      },
      "expected": 6,
      "tags": [
        "trial",
