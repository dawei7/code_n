    {
      "id": "example-two-removals",
      "name": "sample: two removals preserve the requested subsequence",
      "kind": "sample",
      "visible": true,
      "input": {
        "s": "abcacb",
        "p": "ab",
        "removable": [
          3,
          1,
          0
        ]
      },
      "expected": 2,
      "tags": [
        "sample",
        "interior-answer"
      ]
    },
    {
