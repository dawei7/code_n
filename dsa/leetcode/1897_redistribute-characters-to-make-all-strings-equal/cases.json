      "visible": true,
      "input": {
        "words": [
          "abc",
          "abc",
          "abc"
        ]
      },
      "expected": true,
      "tags": [
        "already-equal"
      ]
    },
    {
      "id": "real-balanced-mixed",
      "name": "mixed source words have enough of each letter for four equal targets",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "aa",
          "bb",
          "ab",
          "ab"
        ]
      },
      "expected": true,
      "tags": [
        "multiple-letters",
        "four-words"
      ]
    },
    {
      "id": "real-total-length-not-enough",
      "name": "one rare letter prevents four equal strings",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "a",
          "a",
          "a",
          "b"
        ]
      },
      "expected": false,
      "tags": [
        "rare-letter",
        "indivisible-count"
      ]
    },
    {
      "id": "real-length-divisible-character-not",
      "name": "divisible total length is insufficient when individual letter counts differ",
