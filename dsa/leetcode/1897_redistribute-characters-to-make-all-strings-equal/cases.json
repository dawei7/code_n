      "visible": true,
      "input": {
        "words": [
          "ab",
          "cd"
        ]
      },
      "expected": false,
      "tags": [
        "total-length-trap",
        "letter-counts"
      ]
    },
    {
      "id": "real-different-lengths",
      "name": "source word lengths may differ before redistribution",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "aabbcc",
          "abc",
          "abcabcabc"
        ]
      },
      "expected": true,
      "tags": [
        "length-redistribution",
        "unequal-lengths"
      ]
    },
    {
      "id": "real-many-copies",
      "name": "repeated letters distribute evenly across five targets",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "aaaaa",
          "bbbbb",
          "ccccc",
          "abcabcabcabcabc",
          "abcabcabcabcabc"
