      "visible": true,
      "input": {
        "words": [
          "ab",
          "ba"
        ]
      },
      "expected": true,
      "tags": [
        "anagrams",
        "two-words"
      ]
    },
    {
      "id": "trial-single-word",
      "name": "one word is already equal to every word in the array",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "leetcode"
        ]
      },
      "expected": true,
      "tags": [
        "single-word"
      ]
    },
    {
      "id": "real-identical",
      "name": "already identical words satisfy every divisibility condition",
