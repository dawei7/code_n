  "cases": [
    {
      "id": "sample-marker-limits",
      "name": "sample: four mentions or hashtags are invalid",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Tweets": [
            {
              "tweet_id": 1,
              "content": "Update @A @B @C @D"
            },
            {
              "tweet_id": 2,
              "content": "News #One #Two #Three"
            },
            {
              "tweet_id": 4,
              "content": "Work #A #B #C #D"
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "tweet_id"
        ],
        "rows": [
          [
            1
          ],
          [
            4
          ]
        ]
      },
      "validator": {
        "kind": "ordered_table"
      },
      "tags": [
        "sample",
        "markers"
      ]
    },
    {
