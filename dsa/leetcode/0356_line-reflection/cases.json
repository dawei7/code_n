{
  "schema_version": 1,
  "challenge_id": "lc_356",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: symmetric pair",
      "kind": "sample",
      "visible": true,
      "input": {"points": [[1, 1], [-1, 1]]},
      "expected": true,
      "tags": ["sample", "source-example", "integer-axis"]
    },
    {
      "id": "sample-2",
      "name": "sample: y-coordinates do not match",
      "kind": "sample",
      "visible": true,
      "input": {"points": [[1, 1], [-1, -1]]},
      "expected": false,
      "tags": ["sample", "source-example", "asymmetric"]
    },
    {
      "id": "trial-point-on-axis",
      "name": "a point on the reflection line maps to itself",
      "kind": "trial",
      "visible": true,
      "input": {"points": [[0, 0], [2, 0], [1, 1]]},
      "expected": true,
      "tags": ["on-axis", "integer-axis"]
    },
    {
      "id": "trial-half-axis",
      "name": "symmetry around a half-integer axis",
      "kind": "trial",
      "visible": true,
      "input": {"points": [[0, 2], [3, 2], [1, 4], [2, 4]]},
      "expected": true,
      "tags": ["half-integer-axis", "multiple-rows"]
    },
    {
      "id": "trial-all-on-line",
      "name": "every point lies on one vertical line",
      "kind": "trial",
      "visible": true,
      "input": {"points": [[5, 1], [5, 2], [5, 3]]},
      "expected": true,
      "tags": ["all-on-axis", "multiple-rows"]
    },
    {
      "id": "trial-duplicate",
      "name": "duplicate coordinates do not alter set symmetry",
      "kind": "trial",
      "visible": true,
      "input": {"points": [[-2, 0], [-2, 0], [2, 0]]},
      "expected": true,
      "tags": ["duplicate", "set-semantics"]
    },
    {
      "id": "trial-missing-mirror",
      "name": "one row lacks its required mirror",
      "kind": "trial",
      "visible": true,
      "input": {"points": [[0, 0], [4, 0], [1, 1]]},
      "expected": false,
      "tags": ["missing-mirror", "multiple-rows"]
    },
    {
      "id": "trial-negative-axis",
      "name": "symmetry around a negative x-coordinate",
      "kind": "trial",
      "visible": true,
      "input": {"points": [[-5, 0], [-1, 0], [-4, 2], [-2, 2], [-3, 7]]},
      "expected": true,
      "tags": ["negative-axis", "on-axis"]
    },
    {
      "id": "trial-single-point",
      "name": "one boundary-valued point is symmetric with itself",
      "kind": "trial",
      "visible": true,
      "input": {"points": [[100000000, -100000000]]},
      "expected": true,
      "tags": ["minimum-n", "coordinate-boundaries", "on-axis"]
    },
    {
      "id": "trial-coordinate-extremes",
      "name": "both coordinate bounds reflect without overflow or precision loss",
      "kind": "trial",
      "visible": true,
      "input": {"points": [[-100000000, -100000000], [100000000, -100000000], [0, 100000000]]},
      "expected": true,
      "tags": ["coordinate-boundaries", "integer-arithmetic", "on-axis"]
    },
    {
      "id": "trial-conflicting-row-axes",
      "name": "individually symmetric rows require one shared global axis",
      "kind": "trial",
      "visible": true,
      "input": {"points": [[-2, 0], [2, 0], [-1, 1], [3, 1]]},
      "expected": false,
      "tags": ["global-axis", "multiple-rows", "asymmetric"]
    }
  ]
}
