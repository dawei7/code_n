{
  "schema_version": 1,
  "challenge_id": "lc_2411",
  "cases": [
    {
      "id": "sample-suffix-bits",
      "name": "sample: suffix bits determine each endpoint",
      "kind": "sample",
      "visible": true,
      "input": {
        "nums": [
          1,
          0,
          2,
          1,
          3
        ]
      },
      "expected": [
        3,
        3,
        2,
        2,
        1
      ],
      "tags": [
        "sample",
        "bitwise-or"
      ]
    },
    {
      "id": "sample-two-values",
      "name": "sample: second value contributes a new bit",
      "kind": "sample",
      "visible": true,
      "input": {
        "nums": [
          1,
          2
        ]
      },
      "expected": [
        2,
        1
      ],
      "tags": [
        "sample"
      ]
    },
    {
      "id": "trial-all-zero",
      "name": "zero suffixes reach their maximum immediately",
      "kind": "trial",
      "visible": true,
      "input": {
        "nums": [
          0,
          0,
          0
        ]
      },
      "expected": [
        1,
        1,
        1
      ],
      "tags": [
        "zero"
      ]
    },
    {
      "id": "trial-complete-immediately",
      "name": "each repeated value already contains the suffix bits",
      "kind": "trial",
      "visible": true,
      "input": {
        "nums": [
          7,
          7
        ]
      },
      "expected": [
        1,
        1
      ],
      "tags": [
        "duplicates"
      ]
    },
    {
      "id": "trial-mixed-overlap",
      "name": "different starts require different final bits",
      "kind": "trial",
      "visible": true,
      "input": {
        "nums": [
          5,
          2,
          1
        ]
      },
      "expected": [
        2,
        2,
        1
      ],
      "tags": [
        "nearest-bit"
      ]
    },
    {
      "id": "real-final-bit",
      "name": "final value supplies a required bit",
      "kind": "trial",
      "visible": true,
      "input": {
        "nums": [
          8,
          0,
          0,
          1
        ]
      },
      "expected": [
        4,
        3,
        2,
        1
      ],
      "tags": [
        "hidden",
        "furthest"
      ]
    },
    {
      "id": "real-multiple-bits",
      "name": "one final value supplies several suffix bits",
      "kind": "trial",
      "visible": true,
      "input": {
        "nums": [
          8,
          1,
          2,
          12
        ]
      },
      "expected": [
        4,
        3,
        2,
        1
      ],
      "tags": [
        "hidden",
        "combined-bits"
      ]
    },
    {
      "id": "real-maximum-value",
      "name": "maximum legal value as a singleton",
      "kind": "trial",
      "visible": true,
      "input": {
        "nums": [
          1000000000
        ]
      },
      "expected": [
        1
      ],
      "tags": [
        "hidden",
        "boundary"
      ]
    }
  ]
