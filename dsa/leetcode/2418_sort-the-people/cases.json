{
  "schema_version": 1,
  "challenge_id": "lc_2418",
  "cases": [
    {
      "id": "sample-three-people",
      "name": "sample: sort three people",
      "kind": "sample",
      "visible": true,
      "input": {
        "names": [
          "Mary",
          "John",
          "Emma"
        ],
        "heights": [
          180,
          165,
          170
        ]
      },
      "expected": [
        "Mary",
        "Emma",
        "John"
      ],
      "tags": [
        "sample",
        "sorting"
      ]
    },
    {
      "id": "sample-duplicate-name",
      "name": "sample: repeated name belongs to distinct people",
      "kind": "sample",
      "visible": true,
      "input": {
        "names": [
          "Alice",
          "Bob",
          "Bob"
        ],
        "heights": [
          155,
          185,
          150
        ]
      },
      "expected": [
        "Bob",
        "Alice",
        "Bob"
      ],
      "tags": [
        "sample",
        "duplicate-names"
      ]
    },
    {
      "id": "trial-single",
      "name": "single person remains unchanged",
      "kind": "trial",
      "visible": true,
      "input": {
        "names": [
          "Alex"
        ],
        "heights": [
          100
        ]
      },
      "expected": [
        "Alex"
      ],
      "tags": [
        "boundary"
      ]
    },
    {
      "id": "trial-unsorted",
      "name": "arbitrary input order is ignored",
      "kind": "trial",
      "visible": true,
      "input": {
        "names": [
          "A",
          "B",
          "C"
        ],
        "heights": [
          3,
          1,
          2
        ]
      },
      "expected": [
        "A",
        "C",
        "B"
      ],
      "tags": [
        "sorting"
      ]
    },
    {
      "id": "trial-already-descending",
      "name": "already descending heights preserve order",
      "kind": "trial",
      "visible": true,
      "input": {
        "names": [
          "Tall",
          "Mid",
          "Low"
        ],
        "heights": [
          300,
          200,
          100
        ]
      },
      "expected": [
        "Tall",
        "Mid",
        "Low"
      ],
      "tags": [
        "ordered"
      ]
    },
    {
      "id": "trial-ascending",
      "name": "ascending heights reverse all names",
      "kind": "trial",
      "visible": true,
      "input": {
        "names": [
          "A",
          "B",
          "C",
          "D"
        ],
        "heights": [
          1,
          2,
          3,
          4
        ]
      },
      "expected": [
        "D",
        "C",
        "B",
        "A"
      ],
      "tags": [
        "reverse"
      ]
    },
    {
      "id": "trial-case-sensitive",
      "name": "names are data rather than sort keys",
      "kind": "trial",
      "visible": true,
      "input": {
        "names": [
          "z",
          "A",
          "m"
        ],
        "heights": [
          20,
          30,
          10
        ]
      },
      "expected": [
        "A",
        "z",
        "m"
      ],
      "tags": [
        "case"
      ]
    },
    {
      "id": "trial-large-heights",
      "name": "boundary heights stay attached",
      "kind": "trial",
      "visible": true,
      "input": {
        "names": [
          "Min",
          "Max"
        ],
        "heights": [
          1,
          100000
        ]
      },
      "expected": [
        "Max",
        "Min"
      ],
      "tags": [
        "boundary"
      ]
    }
  ]
}