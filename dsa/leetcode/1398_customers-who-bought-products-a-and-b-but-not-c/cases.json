      "id": "trial-ordering-and-duplicate-names",
      "name": "trial: qualifying IDs are ordered and equal names stay separate",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Customers": [
            {"customer_id": 9, "customer_name": "Sam"},
            {"customer_id": 2, "customer_name": "Sam"},
            {"customer_id": 5, "customer_name": "Blocked"}
          ],
          "Orders": [
            {"order_id": 101, "customer_id": 9, "product_name": "B"},
            {"order_id": 102, "customer_id": 2, "product_name": "B"},
            {"order_id": 103, "customer_id": 5, "product_name": "A"},
            {"order_id": 104, "customer_id": 9, "product_name": "A"},
            {"order_id": 105, "customer_id": 5, "product_name": "B"},
            {"order_id": 106, "customer_id": 2, "product_name": "A"},
            {"order_id": 107, "customer_id": 5, "product_name": "C"}
          ]
        }
      },
      "expected": {
        "columns": ["customer_id", "customer_name"],
        "rows": [[2, "Sam"], [9, "Sam"]]
