    {
      "id": "sample-gaps-between-groups",
      "name": "sample: groups match with unused values before them",
      "kind": "sample",
      "visible": true,
      "input": {
        "groups": [
          [
            1,
            -1,
            -1
          ],
          [
            3,
            -2,
            0
          ]
        ],
        "nums": [
          1,
          -1,
          0,
          1,
          -1,
          -1,
          3,
          -2,
          0
        ]
      },
      "expected": true,
      "tags": [
        "sample",
        "gaps",
        "ordered-matches"
      ]
    },
    {
