    },
    {
      "id": "trial-boundary-10",
      "name": "identical elements in ideas",
      "kind": "trial",
      "visible": true,
      "input": {
        "ideas": [
          "coffee",
          "coffee"
        ]
      },
      "expected": 0,
      "tags": [
