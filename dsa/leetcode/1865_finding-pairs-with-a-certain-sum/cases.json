  "cases": [
    {
      "id": "example-updates-and-counts",
      "name": "sample: updates change later pair counts",
      "kind": "sample",
      "visible": true,
      "input": {
        "operations": [
          "FindSumPairs",
          "count",
          "add",
          "count",
          "count",
          "add",
          "add",
          "count"
        ],
        "arguments": [
          [
            [
              1,
              1,
              2,
              2,
              2,
              3
            ],
            [
              1,
              4,
              5,
              2,
              5,
              4
            ]
          ],
          [
            7
          ],
          [
            3,
            2
          ],
          [
            8
          ],
          [
            4
          ],
          [
            0,
            1
          ],
          [
            1,
            1
          ],
          [
            7
          ]
        ]
      },
      "expected": [
        null,
        8,
        null,
        2,
        1,
        null,
        null,
        11
      ],
      "validator": {
        "kind": "exact"
      },
      "tags": [
        "example",
        "stateful",
        "duplicates"
      ]
    },
