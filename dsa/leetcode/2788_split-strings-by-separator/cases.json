{
  "challenge_id": "lc_2788",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: split periods across several words",
      "kind": "sample",
      "visible": true,
      "input": {
        "words": [
          "one.two.three",
          "four.five",
          "six"
        ],
        "separator": "."
      },
      "expected": [
        "one",
        "two",
        "three",
        "four",
        "five",
        "six"
      ],
      "tags": [
        "sample",
        "multiple-words"
      ]
    },
    {
      "id": "sample-2",
      "name": "sample: discard empty edge pieces",
      "kind": "sample",
      "visible": true,
      "input": {
        "words": [
          "$easy$",
          "$problem$"
        ],
        "separator": "$"
      },
      "expected": [
        "easy",
        "problem"
      ],
      "tags": [
        "sample",
        "empty-pieces"
      ]
    },
    {
      "id": "sample-3",
      "name": "sample: separators produce no non-empty pieces",
      "kind": "sample",
      "visible": true,
      "input": {
        "words": [
          "|||"
        ],
        "separator": "|"
      },
      "expected": [],
      "tags": [
        "sample",
        "empty-result"
      ]
    },
    {
      "id": "trial-no-separator",
      "name": "trial: words without the delimiter stay whole",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "alpha",
          "beta"
        ],
        "separator": "#"
      },
      "expected": [
        "alpha",
        "beta"
      ],
      "tags": [
        "trial",
        "unchanged"
      ]
    },
    {
      "id": "trial-adjacent-separators",
      "name": "trial: ignore leading trailing and adjacent gaps",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "..a..b.",
          ".c."
        ],
        "separator": "."
      },
      "expected": [
        "a",
        "b",
        "c"
      ],
      "tags": [
        "trial",
        "adjacent-separators"
      ]
    },
    {
      "id": "trial-other-punctuation",
      "name": "trial: non-selected punctuation remains in pieces",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "a.b,c",
          "d"
        ],
        "separator": ","
      },
      "expected": [
        "a.b",
        "c",
        "d"
      ],
      "tags": [
        "trial",
        "literal-punctuation"
      ]
    },
    {
      "id": "trial-single-characters",
      "name": "preserve order of single-character words",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "z",
          "a",
          "m"
        ],
        "separator": "@"
      },
      "expected": [
        "z",
        "a",
        "m"
      ],
      "tags": [
        "order"
      ]
    },
    {
      "id": "trial-all-empty",
      "name": "several delimiter-only words flatten to empty",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "###",
          "#",
          "##"
        ],
        "separator": "#"
      },
      "expected": [],
      "tags": [
        "empty-result"
      ]
    },
    {
      "id": "trial-maximum-word-length",
      "name": "maximum-length word has no separator",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "abcdefghijklmnopqrst"
        ],
        "separator": "|"
      },
      "expected": [
        "abcdefghijklmnopqrst"
      ],
      "tags": [
        "boundary"
      ]
    },
    {
      "id": "trial-mixed-density",
      "name": "combine unsplit and densely separated words",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "a@b",
          "plain",
          "@@c@@d@@",
          "e@"
        ],
        "separator": "@"
      },
      "expected": [
        "a",
        "b",
        "plain",
        "c",
        "d",
        "e"
      ],
      "tags": [
        "mixed"
      ]
    }
  ]
}