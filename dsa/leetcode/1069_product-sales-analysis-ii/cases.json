{
  "schema_version": 1,
  "challenge_id": "lc_1069",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: aggregate repeated product",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Sales": [
            {"sale_id": 1, "product_id": 100, "year": 2008, "quantity": 10, "price": 5000},
            {"sale_id": 2, "product_id": 100, "year": 2009, "quantity": 12, "price": 5000},
            {"sale_id": 7, "product_id": 200, "year": 2011, "quantity": 15, "price": 9000}
          ],
          "Product": [
            {"product_id": 100, "product_name": "Nokia"},
            {"product_id": 200, "product_name": "Apple"},
            {"product_id": 300, "product_name": "Samsung"}
          ]
        }
      },
      "expected": {
        "columns": ["product_id", "total_quantity"],
        "rows": [[100, 22], [200, 15]]
      },
      "tags": ["sample", "grouping", "unsold-product"]
    },
    {
      "id": "trial-single-sale",
      "name": "single sale quantity is the total",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Sales": [
            {"sale_id": 4, "product_id": 9, "year": 2024, "quantity": 7, "price": 50}
          ],
          "Product": [
            {"product_id": 9, "product_name": "Item"}
          ]
        }
      },
      "expected": {
        "columns": ["product_id", "total_quantity"],
        "rows": [[9, 7]]
      },
      "tags": ["trial", "single-sale"]
    },
    {
      "id": "trial-several-products",
      "name": "separate product groups across shared years",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Sales": [
            {"sale_id": 1, "product_id": 1, "year": 2020, "quantity": 2, "price": 10},
            {"sale_id": 2, "product_id": 2, "year": 2020, "quantity": 3, "price": 10},
            {"sale_id": 3, "product_id": 1, "year": 2021, "quantity": 5, "price": 20}
          ],
          "Product": [
            {"product_id": 1, "product_name": "One"},
            {"product_id": 2, "product_name": "Two"}
          ]
        }
      },
      "expected": {
        "columns": ["product_id", "total_quantity"],
        "rows": [[1, 7], [2, 3]]
      },
      "tags": ["trial", "multiple-groups", "shared-year"]
    },
    {
      "id": "trial-composite-key",
      "name": "same sale identifier in different years",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Sales": [
            {"sale_id": 8, "product_id": 4, "year": 2018, "quantity": 4, "price": 1},
            {"sale_id": 8, "product_id": 4, "year": 2019, "quantity": 6, "price": 2}
          ],
          "Product": [
            {"product_id": 4, "product_name": "Four"}
          ]
        }
      },
      "expected": {
        "columns": ["product_id", "total_quantity"],
        "rows": [[4, 10]]
      },
      "tags": ["trial", "composite-key", "multiple-years"]
    },
    {
      "id": "trial-price-irrelevant",
      "name": "price does not affect quantity totals",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Sales": [
            {"sale_id": 1, "product_id": 5, "year": 2020, "quantity": 1, "price": 1000},
            {"sale_id": 2, "product_id": 5, "year": 2021, "quantity": 9, "price": 1}
          ],
          "Product": [
            {"product_id": 5, "product_name": "Five"}
          ]
        }
      },
      "expected": {
        "columns": ["product_id", "total_quantity"],
        "rows": [[5, 10]]
      },
      "tags": ["trial", "price-irrelevant"]
    },
    {
      "id": "trial-unordered-product-ids",
      "name": "unsorted sales still form independent product groups",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Sales": [
            {"sale_id": 1, "product_id": 9, "year": 2020, "quantity": 4, "price": 1},
            {"sale_id": 2, "product_id": 2, "year": 2020, "quantity": 8, "price": 1},
            {"sale_id": 3, "product_id": 7, "year": 2020, "quantity": 3, "price": 1}
          ],
          "Product": [
            {"product_id": 2, "product_name": "Two"},
            {"product_id": 7, "product_name": "Seven"},
            {"product_id": 9, "product_name": "Nine"}
          ]
        }
      },
      "expected": {
        "columns": ["product_id", "total_quantity"],
        "rows": [[2, 8], [7, 3], [9, 4]]
      },
      "tags": ["trial", "input-order", "multiple-groups"]
    },
    {
      "id": "trial-duplicate-product-names",
      "name": "duplicate product names do not merge identifiers",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Sales": [
            {"sale_id": 11, "product_id": 3, "year": 2022, "quantity": 4, "price": 20},
            {"sale_id": 12, "product_id": 8, "year": 2022, "quantity": 6, "price": 20},
            {"sale_id": 13, "product_id": 3, "year": 2023, "quantity": 5, "price": 25}
          ],
          "Product": [
            {"product_id": 3, "product_name": "Shared"},
            {"product_id": 8, "product_name": "Shared"}
          ]
        }
      },
      "expected": {
        "columns": ["product_id", "total_quantity"],
        "rows": [[3, 9], [8, 6]]
      },
      "tags": ["trial", "duplicate-name", "grouping-key"]
    },
    {
      "id": "trial-no-sales",
      "name": "products without sales produce no rows",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Sales": {
            "columns": ["sale_id", "product_id", "year", "quantity", "price"],
            "rows": []
          },
          "Product": [
            {"product_id": 42, "product_name": "Unsold"}
          ]
        }
      },
      "expected": {
        "columns": ["product_id", "total_quantity"],
        "rows": []
      },
      "tags": ["trial", "empty-sales", "unsold-product"]
    }
  ]
}
