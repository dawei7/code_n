{
  "schema_version": 1,
  "challenge_id": "lc_758",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: overlapping matches merge",
      "kind": "sample",
      "visible": true,
      "input": {"words": ["ab", "bc"], "s": "aabcd"},
      "expected": "a<b>abc</b>d",
      "tags": ["sample", "overlap", "minimum-tags"]
    },
    {
      "id": "sample-2",
      "name": "sample: one dictionary word matches",
      "kind": "sample",
      "visible": true,
      "input": {"words": ["ab", "cb"], "s": "aabcd"},
      "expected": "a<b>ab</b>cd",
      "tags": ["sample", "single-match"]
    },
    {
      "id": "trial-1",
      "name": "trial: adjacent matches share one tag pair",
      "kind": "trial",
      "visible": true,
      "input": {"words": ["ab", "cd"], "s": "abcd"},
      "expected": "<b>abcd</b>",
      "tags": ["trial", "adjacent", "minimum-tags"]
    },
    {
      "id": "trial-2",
      "name": "trial: unmatched words leave the source unchanged",
      "kind": "trial",
      "visible": true,
      "input": {"words": ["xy", "z"], "s": "abc"},
      "expected": "abc",
      "tags": ["trial", "no-match"]
    },
    {
      "id": "trial-3",
      "name": "trial: repeated overlapping occurrences form one range",
      "kind": "trial",
      "visible": true,
      "input": {"words": ["aa"], "s": "aaaa"},
      "expected": "<b>aaaa</b>",
      "tags": ["trial", "repeated", "overlap"]
    },
    {
      "id": "trial-4",
      "name": "trial: close a bold range after the final character",
      "kind": "trial",
      "visible": true,
      "input": {"words": ["end"], "s": "theend"},
      "expected": "the<b>end</b>",
      "tags": ["trial", "suffix", "final-character"]
    },
    {
      "id": "trial-5",
      "name": "trial: separated occurrences retain separate tag pairs",
      "kind": "trial",
      "visible": true,
      "input": {"words": ["ab"], "s": "abxxab"},
      "expected": "<b>ab</b>xx<b>ab</b>",
      "tags": ["trial", "separate-ranges", "prefix", "suffix"]
    },
    {
      "id": "trial-6",
      "name": "trial: a shorter nested match does not split a longer range",
      "kind": "trial",
      "visible": true,
      "input": {"words": ["bc", "abcd"], "s": "zabcdz"},
      "expected": "z<b>abcd</b>z",
      "tags": ["trial", "nested-match", "shared-start-region"]
    },
    {
      "id": "trial-7",
      "name": "trial: an empty dictionary adds no tags",
      "kind": "trial",
      "visible": true,
      "input": {"words": [], "s": "abc"},
      "expected": "abc",
      "tags": ["trial", "empty-dictionary", "minimum-word-count"]
    },
    {
      "id": "trial-8",
      "name": "trial: minimum source and word lengths",
      "kind": "trial",
      "visible": true,
      "input": {"words": ["a"], "s": "a"},
      "expected": "<b>a</b>",
      "tags": ["trial", "single-character", "minimum-lengths", "full-coverage"]
    },
    {
      "id": "trial-9",
      "name": "trial: duplicate keywords do not duplicate tags",
      "kind": "trial",
      "visible": true,
      "input": {"words": ["abc", "abc"], "s": "abc"},
      "expected": "<b>abc</b>",
      "tags": ["trial", "duplicate-words", "minimum-tags"]
    },
    {
      "id": "trial-10",
      "name": "trial: maximum-length keyword contains a nested match",
      "kind": "trial",
      "visible": true,
      "input": {"words": ["abcdefghij", "bc"], "s": "xabcdefghijy"},
      "expected": "x<b>abcdefghij</b>y",
      "tags": ["trial", "maximum-word-length", "nested-match"]
    }
  ]
}
