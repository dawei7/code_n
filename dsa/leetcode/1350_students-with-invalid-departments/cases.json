{
  "schema_version": 1,
  "challenge_id": "lc_1350",
  "cases": [
    {
      "id": "sample-source-example",
      "name": "sample: source example with valid and invalid departments",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Departments": [
            {"id": 1, "name": "Electrical Engineering"},
            {"id": 7, "name": "Computer Engineering"},
            {"id": 13, "name": "Bussiness Administration"}
          ],
          "Students": [
            {"id": 23, "name": "Alice", "department_id": 1},
            {"id": 1, "name": "Bob", "department_id": 7},
            {"id": 5, "name": "Jennifer", "department_id": 13},
            {"id": 2, "name": "John", "department_id": 14},
            {"id": 4, "name": "Jasmine", "department_id": 77},
            {"id": 3, "name": "Steve", "department_id": 74},
            {"id": 6, "name": "Luis", "department_id": 1},
            {"id": 8, "name": "Jonathan", "department_id": 7},
            {"id": 7, "name": "Daiana", "department_id": 33},
            {"id": 11, "name": "Madelynn", "department_id": 1}
          ]
        }
      },
      "expected": {
        "columns": ["id", "name"],
        "rows": [[2, "John"], [7, "Daiana"], [4, "Jasmine"], [3, "Steve"]]
      },
      "tags": ["sample", "source-exact", "anti-join"],
      "validator": {"kind": "unordered_table"}
    },
    {
      "id": "trial-all-valid",
      "name": "trial: every recorded department exists",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Departments": [{"id": 1, "name": "A"}, {"id": 2, "name": "B"}],
          "Students": [
            {"id": 1, "name": "One", "department_id": 1},
            {"id": 2, "name": "Two", "department_id": 2}
          ]
        }
      },
      "expected": {"columns": ["id", "name"], "rows": []},
      "tags": ["trial", "empty-result", "all-valid"],
      "validator": {"kind": "unordered_table"}
    },
    {
      "id": "trial-no-departments",
      "name": "trial: every student refers to an absent department",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Departments": {"columns": ["id", "name"], "rows": []},
          "Students": [
            {"id": 2, "name": "Beta", "department_id": 8},
            {"id": 1, "name": "Alpha", "department_id": 9}
          ]
        }
      },
      "expected": {"columns": ["id", "name"], "rows": [[1, "Alpha"], [2, "Beta"]]},
      "tags": ["trial", "empty-departments", "all-invalid"],
      "validator": {"kind": "unordered_table"}
    },
    {
      "id": "trial-no-students",
      "name": "trial: no students",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Departments": [{"id": 5, "name": "Existing"}],
          "Students": {"columns": ["id", "name", "department_id"], "rows": []}
        }
      },
      "expected": {"columns": ["id", "name"], "rows": []},
      "tags": ["trial", "empty-students", "empty-result"],
      "validator": {"kind": "unordered_table"}
    },
    {
      "id": "trial-one-invalid",
      "name": "trial: a single invalid student",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Departments": [{"id": 10, "name": "Known"}],
          "Students": [{"id": 7, "name": "Lost", "department_id": 11}]
        }
      },
      "expected": {"columns": ["id", "name"], "rows": [[7, "Lost"]]},
      "tags": ["trial", "single-row", "invalid-reference"],
      "validator": {"kind": "unordered_table"}
    },
    {
      "id": "trial-duplicate-names",
      "name": "trial: equal names remain distinct student rows",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Departments": [{"id": 1, "name": "Valid"}],
          "Students": [
            {"id": 4, "name": "Sam", "department_id": 9},
            {"id": 2, "name": "Sam", "department_id": 8},
            {"id": 3, "name": "Sam", "department_id": 1}
          ]
        }
      },
      "expected": {"columns": ["id", "name"], "rows": [[2, "Sam"], [4, "Sam"]]},
      "tags": ["trial", "duplicate-names", "student-identity"],
      "validator": {"kind": "unordered_table"}
    },
    {
      "id": "trial-input-order-independent",
      "name": "trial: input order does not define result order",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Departments": [{"id": 5, "name": "Five"}],
          "Students": [
            {"id": 30, "name": "Thirty", "department_id": 2},
            {"id": 10, "name": "Ten", "department_id": 5},
            {"id": 20, "name": "Twenty", "department_id": 3}
          ]
        }
      },
      "expected": {"columns": ["id", "name"], "rows": [[20, "Twenty"], [30, "Thirty"]]},
      "tags": ["trial", "unordered-result", "mixed-validity"],
      "validator": {"kind": "unordered_table"}
    }
  ]
}
