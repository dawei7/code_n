  "cases": [
    {
      "id": "sample-two-drivers",
      "name": "sample: one driver was a passenger twice and one never was",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Rides": [
            {
              "ride_id": 1,
              "driver_id": 7,
              "passenger_id": 1
            },
            {
              "ride_id": 2,
              "driver_id": 7,
              "passenger_id": 2
            },
            {
              "ride_id": 3,
              "driver_id": 11,
              "passenger_id": 1
            },
            {
              "ride_id": 4,
              "driver_id": 11,
              "passenger_id": 7
            },
            {
              "ride_id": 5,
              "driver_id": 11,
              "passenger_id": 7
            },
            {
              "ride_id": 6,
              "driver_id": 11,
              "passenger_id": 3
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "driver_id",
          "cnt"
        ],
        "rows": [
          [
            7,
            2
          ],
          [
            11,
            0
          ]
        ]
      },
      "validator": {
        "kind": "unordered_table"
      },
      "tags": [
        "sample",
        "zero-count"
      ]
    },
