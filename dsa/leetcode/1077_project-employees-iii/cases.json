{
  "schema_version": 1,
  "challenge_id": "lc_1077",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: tied winner in the first project",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Project": [
            {"project_id": 1, "employee_id": 1},
            {"project_id": 1, "employee_id": 2},
            {"project_id": 1, "employee_id": 3},
            {"project_id": 2, "employee_id": 1},
            {"project_id": 2, "employee_id": 4}
          ],
          "Employee": [
            {"employee_id": 1, "name": "Khaled", "experience_years": 3},
            {"employee_id": 2, "name": "Ali", "experience_years": 2},
            {"employee_id": 3, "name": "John", "experience_years": 3},
            {"employee_id": 4, "name": "Doe", "experience_years": 2}
          ]
        }
      },
      "expected": {
        "columns": ["project_id", "employee_id"],
        "rows": [[1, 1], [1, 3], [2, 1]]
      },
      "tags": ["sample", "source-example", "ties", "multiple-projects"]
    },
    {
      "id": "trial-tied-experience",
      "name": "all employees tied at one project's maximum",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Project": [
            {"project_id": 3, "employee_id": 1},
            {"project_id": 3, "employee_id": 2},
            {"project_id": 3, "employee_id": 3}
          ],
          "Employee": [
            {"employee_id": 1, "name": "One", "experience_years": 8},
            {"employee_id": 2, "name": "Two", "experience_years": 8},
            {"employee_id": 3, "name": "Three", "experience_years": 4}
          ]
        }
      },
      "expected": {
        "columns": ["project_id", "employee_id"],
        "rows": [[3, 1], [3, 2]]
      },
      "tags": ["trial", "ties", "lower-experience"]
    },
    {
      "id": "trial-single-assignment",
      "name": "single assignment with zero experience and an unassigned employee",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Project": [
            {"project_id": 8, "employee_id": 4}
          ],
          "Employee": [
            {"employee_id": 4, "name": "Solo", "experience_years": 0},
            {"employee_id": 9, "name": "Unassigned", "experience_years": 30}
          ]
        }
      },
      "expected": {
        "columns": ["project_id", "employee_id"],
        "rows": [[8, 4]]
      },
      "tags": ["trial", "single", "zero-experience", "unassigned-employee"]
    },
    {
      "id": "trial-independent-projects",
      "name": "shared employee is ranked independently in each project",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Project": [
            {"project_id": 1, "employee_id": 1},
            {"project_id": 1, "employee_id": 2},
            {"project_id": 2, "employee_id": 1},
            {"project_id": 2, "employee_id": 3}
          ],
          "Employee": [
            {"employee_id": 1, "name": "Shared", "experience_years": 5},
            {"employee_id": 2, "name": "Senior", "experience_years": 9},
            {"employee_id": 3, "name": "Junior", "experience_years": 1}
          ]
        }
      },
      "expected": {
        "columns": ["project_id", "employee_id"],
        "rows": [[1, 2], [2, 1]]
      },
      "tags": ["trial", "shared-employee", "partition-boundary"]
    },
    {
      "id": "trial-all-tied",
      "name": "every assignment is maximal within its project",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Project": [
            {"project_id": 7, "employee_id": 5},
            {"project_id": 7, "employee_id": 2},
            {"project_id": 9, "employee_id": 4}
          ],
          "Employee": [
            {"employee_id": 2, "name": "Two", "experience_years": 6},
            {"employee_id": 4, "name": "Four", "experience_years": 6},
            {"employee_id": 5, "name": "Five", "experience_years": 6}
          ]
        }
      },
      "expected": {
        "columns": ["project_id", "employee_id"],
        "rows": [[7, 2], [7, 5], [9, 4]]
      },
      "tags": ["trial", "all-tied", "multiple-projects", "ordering"]
    },
    {
      "id": "trial-name-irrelevant",
      "name": "duplicate names do not affect experience ranking",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Project": [
            {"project_id": 6, "employee_id": 10},
            {"project_id": 6, "employee_id": 11}
          ],
          "Employee": [
            {"employee_id": 10, "name": "Same", "experience_years": 2},
            {"employee_id": 11, "name": "Same", "experience_years": 12}
          ]
        }
      },
      "expected": {
        "columns": ["project_id", "employee_id"],
        "rows": [[6, 11]]
      },
      "tags": ["trial", "irrelevant-name", "unique-maximum"]
    },
    {
      "id": "trial-no-project-assignments",
      "name": "empty Project table produces no result rows",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Project": {
            "columns": ["project_id", "employee_id"],
            "rows": []
          },
          "Employee": [
            {"employee_id": 42, "name": "Available", "experience_years": 15}
          ]
        }
      },
      "expected": {
        "columns": ["project_id", "employee_id"],
        "rows": []
      },
      "tags": ["trial", "empty-project", "unassigned-employee"]
    }
  ]
}
