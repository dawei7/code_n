      "tags": ["sample", "overlap", "two-sided-removal"]
    },
    {
      "id": "sample-right-trim",
      "name": "sample: overlapping inputs merge before right-side removal",
      "kind": "sample",
      "visible": true,
      "input": {"occupiedIntervals": [[1, 5], [2, 3]], "freeStart": 3, "freeEnd": 8},
      "expected": [[1, 2]],
      "tags": ["sample", "overlap", "right-trim"]
    },
    {
      "id": "trial-free-before-single-interval",
