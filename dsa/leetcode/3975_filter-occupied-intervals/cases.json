      "visible": true,
      "input": {"occupiedIntervals": [[1, 1], [3, 3]], "freeStart": 10, "freeEnd": 10},
      "expected": [[1, 1], [3, 3]],
      "tags": ["trial", "non-touching", "singleton"]
