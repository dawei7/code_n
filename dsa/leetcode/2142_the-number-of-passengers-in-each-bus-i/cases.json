{
  "schema_version": 1,
  "challenge_id": "lc_2142",
  "cases": [
    {
      "id": "sample-three-buses",
      "name": "sample: middle bus receives no passengers",
      "kind": "sample",
      "visible": true,
      "input": {"tables": {"Buses": [{"bus_id": 1, "arrival_time": 2}, {"bus_id": 2, "arrival_time": 4}, {"bus_id": 3, "arrival_time": 7}], "Passengers": [{"passenger_id": 11, "arrival_time": 1}, {"passenger_id": 12, "arrival_time": 5}, {"passenger_id": 13, "arrival_time": 6}, {"passenger_id": 14, "arrival_time": 7}]}},
      "expected": {"columns": ["bus_id", "passengers_cnt"], "rows": [[1,1],[2,0],[3,3]]},
      "tags": ["sample", "empty-bus", "equal-arrival"]
    },
    {
      "id": "trial-bus-id-order-differs",
      "name": "result order follows bus id rather than arrival time",
      "kind": "trial",
      "visible": true,
      "input": {"tables": {"Buses": [{"bus_id": 10, "arrival_time": 5}, {"bus_id": 2, "arrival_time": 2}], "Passengers": [{"passenger_id": 1, "arrival_time": 1}, {"passenger_id": 2, "arrival_time": 2}, {"passenger_id": 3, "arrival_time": 3}, {"passenger_id": 4, "arrival_time": 5}]}},
      "expected": {"columns": ["bus_id", "passengers_cnt"], "rows": [[2,2],[10,2]]},
      "tags": ["ordering", "equal-arrival"]
    },
    {
      "id": "trial-passenger-after-final-bus",
      "name": "passengers arriving after the final bus remain unassigned",
      "kind": "trial",
      "visible": true,
      "input": {"tables": {"Buses": [{"bus_id": 4, "arrival_time": 3}, {"bus_id": 5, "arrival_time": 8}], "Passengers": [{"passenger_id": 20, "arrival_time": 1}, {"passenger_id": 21, "arrival_time": 9}]}},
      "expected": {"columns": ["bus_id", "passengers_cnt"], "rows": [[4,1],[5,0]]},
      "tags": ["unassigned-passenger", "empty-bus"]
    },
    {
      "id": "real-shared-arrival-time",
      "name": "hidden: several passengers arrive with the same bus",
      "kind": "real",
      "visible": false,
      "input": {"tables": {"Buses": [{"bus_id": 1, "arrival_time": 5}, {"bus_id": 2, "arrival_time": 10}], "Passengers": [{"passenger_id": 1, "arrival_time": 5}, {"passenger_id": 2, "arrival_time": 5}, {"passenger_id": 3, "arrival_time": 10}, {"passenger_id": 4, "arrival_time": 10}]}},
      "expected": {"columns": ["bus_id", "passengers_cnt"], "rows": [[1,2],[2,2]]},
      "tags": ["hidden", "duplicate-passenger-time", "equal-arrival"]
    },
    {
      "id": "real-consecutive-empty-buses",
      "name": "hidden: consecutive buses can both be empty",
      "kind": "real",
      "visible": false,
      "input": {"tables": {"Buses": [{"bus_id": 7, "arrival_time": 2}, {"bus_id": 8, "arrival_time": 4}, {"bus_id": 9, "arrival_time": 6}], "Passengers": [{"passenger_id": 30, "arrival_time": 1}, {"passenger_id": 31, "arrival_time": 8}]}},
      "expected": {"columns": ["bus_id", "passengers_cnt"], "rows": [[7,1],[8,0],[9,0]]},
      "tags": ["hidden", "consecutive-empty"]
    },
    {
      "id": "real-nonmonotone-identifiers",
      "name": "hidden: passenger assignment follows time only",
      "kind": "real",
      "visible": false,
      "input": {"tables": {"Buses": [{"bus_id": 30, "arrival_time": 4}, {"bus_id": 10, "arrival_time": 9}, {"bus_id": 20, "arrival_time": 6}], "Passengers": [{"passenger_id": 100, "arrival_time": 3}, {"passenger_id": 50, "arrival_time": 4}, {"passenger_id": 70, "arrival_time": 5}, {"passenger_id": 60, "arrival_time": 7}]}},
      "expected": {"columns": ["bus_id", "passengers_cnt"], "rows": [[10,1],[20,1],[30,2]]},
      "tags": ["hidden", "identifier-order"]
    }
  ]
}
