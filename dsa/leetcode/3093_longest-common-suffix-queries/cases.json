{
  "schema_version": 1,
  "challenge_id": "lc_3093",
  "cases": [
    {
      "id": "sample-shared-bcd",
      "name": "sample: shortest word wins equal longest suffixes",
      "kind": "sample",
      "visible": true,
      "input": {
        "wordsContainer": [
          "abcd",
          "bcd",
          "xbcd"
        ],
        "wordsQuery": [
          "cd",
          "bcd",
          "xyz"
        ]
      },
      "expected": [
        1,
        1,
        1
      ],
      "tags": [
        "sample",
        "empty-suffix",
        "shortest-tie"
      ]
    },
    {
      "id": "sample-longer-match-priority",
      "name": "sample: longer suffix outranks a shorter word",
      "kind": "sample",
      "visible": true,
      "input": {
        "wordsContainer": [
          "abcdefgh",
          "poiuygh",
          "ghghgh"
        ],
        "wordsQuery": [
          "gh",
          "acbfgh",
          "acbfegh"
        ]
      },
      "expected": [
        2,
        0,
        2
      ],
      "tags": [
        "sample",
        "suffix-priority"
      ]
    },
    {
      "id": "trial-earliest-index",
      "name": "trial: equal lengths use earliest index",
      "kind": "trial",
      "visible": true,
      "input": {
        "wordsContainer": [
          "za",
          "ya",
          "b"
        ],
        "wordsQuery": [
          "qa",
          "x"
        ]
      },
      "expected": [
        0,
        2
      ],
      "tags": [
        "trial",
        "index-tie",
        "empty-suffix"
      ]
    },
    {
      "id": "trial-duplicate-words",
      "name": "trial: duplicate words choose their first occurrence",
      "kind": "trial",
      "visible": true,
      "input": {
        "wordsContainer": [
          "test",
          "test",
          "best"
        ],
        "wordsQuery": [
          "atest",
          "test"
        ]
      },
      "expected": [
        0,
        0
      ],
      "tags": [
        "trial",
        "duplicates"
      ]
    },
    {
      "id": "real-query-is-shorter",
      "name": "hidden: a full query may be a suffix of longer words",
      "kind": "real",
      "visible": false,
      "input": {
        "wordsContainer": [
          "ending",
          "ping",
          "ring"
        ],
        "wordsQuery": [
          "ing",
          "g"
        ]
      },
      "expected": [
        1,
        1
      ],
      "tags": [
        "short-query",
        "shortest-tie"
      ]
    },
    {
      "id": "real-container-word-ends-early",
      "name": "hidden: terminal word remains best at an internal path",
      "kind": "real",
      "visible": false,
      "input": {
        "wordsContainer": [
          "a",
          "ba",
          "cba"
        ],
        "wordsQuery": [
          "zzba",
          "qa"
        ]
      },
      "expected": [
        1,
        0
      ],
      "tags": [
        "internal-node",
        "terminal"
      ]
    },
    {
      "id": "real-no-match-shortest-index",
      "name": "hidden: empty suffix uses shortest then earliest",
      "kind": "real",
      "visible": false,
      "input": {
        "wordsContainer": [
          "long",
          "x",
          "y",
          "wide"
        ],
        "wordsQuery": [
          "abc",
          "qq"
        ]
      },
      "expected": [
        1,
        1
      ],
      "tags": [
        "empty-suffix",
        "global-fallback"
      ]
    },
    {
      "id": "real-mixed-branches",
      "name": "hidden: queries stop at different trie depths",
