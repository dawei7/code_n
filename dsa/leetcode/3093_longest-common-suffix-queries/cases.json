          "motion",
          "station",
          "nation",
          "cat"
        ],
        "wordsQuery": [
          "ration",
          "option",
          "hat",
          "z"
        ]
      },
      "expected": [
        2,
        0,
        3,
        3
      ],
      "tags": [
        "mixed-depths",
        "branches"
      ]
    }
  ]
