{
  "schema_version": 1,
  "challenge_id": "lc_1421",
  "cases": [
    {
      "id": "sample-source-example",
      "name": "sample: exact source stored and missing values",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "NPV": [
            {"id": 1, "year": 2018, "npv": 100},
            {"id": 7, "year": 2020, "npv": 30},
            {"id": 13, "year": 2019, "npv": 40},
            {"id": 1, "year": 2019, "npv": 113},
            {"id": 2, "year": 2008, "npv": 121},
            {"id": 3, "year": 2009, "npv": 12},
            {"id": 11, "year": 2020, "npv": 99},
            {"id": 7, "year": 2019, "npv": 0}
          ],
          "Queries": [
            {"id": 1, "year": 2019},
            {"id": 2, "year": 2008},
            {"id": 3, "year": 2009},
            {"id": 7, "year": 2018},
            {"id": 7, "year": 2019},
            {"id": 7, "year": 2020},
            {"id": 13, "year": 2019}
          ]
        }
      },
      "expected": {
        "columns": ["id", "year", "npv"],
        "rows": [[1, 2019, 113], [2, 2008, 121], [3, 2009, 12], [7, 2018, 0], [7, 2019, 0], [7, 2020, 30], [13, 2019, 40]]
      },
      "validator": {"kind": "unordered_table"},
      "tags": ["sample", "source-example", "missing"]
    },
    {
      "id": "trial-all-matched",
      "name": "trial: every query is stored",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "NPV": [
            {"id": 2, "year": 2008, "npv": 121},
            {"id": 3, "year": 2009, "npv": 12}
          ],
          "Queries": [
            {"id": 3, "year": 2009},
            {"id": 2, "year": 2008}
          ]
        }
      },
      "expected": {
        "columns": ["id", "year", "npv"],
        "rows": [[2, 2008, 121], [3, 2009, 12]]
      },
      "validator": {"kind": "unordered_table"},
      "tags": ["trial", "all-matched", "unordered-result"]
    },
    {
      "id": "trial-all-missing-with-unrelated-value",
      "name": "trial: every query is missing while an unrelated value exists",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "NPV": [
            {"id": 99, "year": 1999, "npv": 1}
          ],
          "Queries": [
            {"id": 4, "year": 2020},
            {"id": 5, "year": 2021}
          ]
        }
      },
      "expected": {
        "columns": ["id", "year", "npv"],
        "rows": [[4, 2020, 0], [5, 2021, 0]]
      },
      "validator": {"kind": "unordered_table"},
      "tags": ["trial", "all-missing", "unrequested-value"]
    },
    {
      "id": "trial-same-id-years",
      "name": "trial: the same identifier uses year in the key",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "NPV": [
            {"id": 9, "year": 2019, "npv": 10},
            {"id": 9, "year": 2020, "npv": 20}
          ],
          "Queries": [
            {"id": 9, "year": 2020}
          ]
        }
      },
      "expected": {
        "columns": ["id", "year", "npv"],
        "rows": [[9, 2020, 20]]
      },
      "validator": {"kind": "unordered_table"},
      "tags": ["trial", "composite-key"]
    },
    {
      "id": "trial-stored-zero",
      "name": "trial: a stored zero remains zero",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "NPV": [
            {"id": 1, "year": 2000, "npv": 0}
          ],
          "Queries": [
            {"id": 1, "year": 2000}
          ]
        }
      },
      "expected": {
        "columns": ["id", "year", "npv"],
        "rows": [[1, 2000, 0]]
      },
      "validator": {"kind": "unordered_table"},
      "tags": ["trial", "stored-zero"]
    },
    {
      "id": "trial-unqueried-values",
      "name": "trial: unrequested NPV rows are omitted",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "NPV": [
            {"id": 1, "year": 2000, "npv": 5},
            {"id": 2, "year": 2000, "npv": 6}
          ],
          "Queries": [
            {"id": 2, "year": 2000}
          ]
        }
      },
      "expected": {
        "columns": ["id", "year", "npv"],
        "rows": [[2, 2000, 6]]
      },
      "validator": {"kind": "unordered_table"},
      "tags": ["trial", "queries-drive-result"]
    },
    {
      "id": "trial-empty-npv",
      "name": "trial: an empty NPV table yields zero for every query",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "NPV": {
            "columns": [
              "id",
              "year",
              "npv"
            ],
            "rows": []
          },
          "Queries": [
            {"id": 4, "year": 2018},
            {"id": 4, "year": 2019}
          ]
        }
      },
      "expected": {
        "columns": ["id", "year", "npv"],
        "rows": [[4, 2018, 0], [4, 2019, 0]]
      },
      "validator": {"kind": "unordered_table"},
      "tags": ["trial", "empty-npv", "all-missing"]
    },
    {
      "id": "trial-empty-queries",
      "name": "trial: an empty Queries table yields no rows",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "NPV": [
            {"id": 8, "year": 2020, "npv": 55}
          ],
          "Queries": {
            "columns": [
              "id",
              "year"
            ],
            "rows": []
          }
        }
      },
      "expected": {
        "columns": ["id", "year", "npv"],
        "rows": []
      },
      "validator": {"kind": "unordered_table"},
      "tags": ["trial", "empty-queries"]
    }
  ]
}
