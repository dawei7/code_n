{
  "schema_version": 1,
  "challenge_id": "lc_2047",
  "cases": [
    {
      "id": "sample-three-plain-words",
      "name": "sample: multiple spaces separate three valid words",
      "kind": "sample",
      "visible": true,
      "input": {
        "sentence": "cat and  dog"
      },
      "expected": 3,
      "tags": [
        "sample",
        "multiple-spaces"
      ]
    },
    {
      "id": "sample-all-invalid",
      "name": "sample: punctuation placement and digits reject every token",
      "kind": "sample",
      "visible": true,
      "input": {
        "sentence": "!this  1-s b8d!"
      },
      "expected": 0,
      "tags": [
        "sample",
        "digits",
        "misplaced-punctuation"
      ]
    },
    {
      "id": "sample-five-valid-prefixes",
      "name": "sample: a digit invalidates only the final token",
      "kind": "sample",
      "visible": true,
      "input": {
        "sentence": "alice and  bob are playing stone-game10"
      },
      "expected": 5,
      "tags": [
        "sample",
        "mixed-validity"
      ]
    },
    {
      "id": "trial-punctuation-only",
      "name": "a punctuation mark alone is a valid word",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence": "!"
      },
      "expected": 1,
      "tags": [
        "punctuation-only"
      ]
    },
    {
      "id": "trial-hyphen-and-punctuation",
      "name": "an internal hyphen and final punctuation may coexist",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence": "a-b."
      },
      "expected": 1,
      "tags": [
        "hyphen",
        "final-punctuation"
      ]
    },
    {
      "id": "trial-hyphen-boundaries",
      "name": "only the internally surrounded hyphen is valid",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence": "-ab ab- a-b"
      },
      "expected": 1,
      "tags": [
        "hyphen-boundary"
      ]
    },
    {
      "id": "trial-multiple-restricted-marks",
      "name": "repeated hyphens and punctuation are invalid",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence": "a-b-c c., plain"
      },
      "expected": 1,
      "tags": [
        "multiple-hyphens",
        "multiple-punctuation"
      ]
    },
    {
      "id": "trial-punctuation-position",
      "name": "punctuation must occur only at the final index",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence": "a!b valid! ,"
      },
      "expected": 2,
      "tags": [
        "punctuation-position"
      ]
    },
    {
      "id": "trial-spaces-and-valid-forms",
      "name": "leading and repeated spaces do not create tokens",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence": "   well-formed,   ok   .   "
      },
      "expected": 3,
      "tags": [
        "spaces",
        "valid-forms"
      ]
    },
    {
      "id": "trial-boundary-10",
      "name": "single character in sentence",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence": "c"
      },
      "expected": 1,
      "tags": [
        "boundary",
        "single-char"
      ]
    },
    {
      "id": "trial-boundary-11",
      "name": "repeated character in sentence",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence": "ccc"
      },
      "expected": 1,
      "tags": [
        "boundary",
        "repeated"
      ]
    }
  ]
}