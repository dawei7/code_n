{
    "schema_version": 1,
    "challenge_id": "lc_1236",
    "cases": [
        {
            "id": "sample-yahoo",
            "name": "sample: crawl reachable pages on the Yahoo hostname",
            "kind": "sample",
            "visible": true,
            "input": {
                "startUrl": "http://news.yahoo.com/news/topics/",
                "htmlParser": {
                    "urls": [
                        "http://news.yahoo.com",
                        "http://news.yahoo.com/news",
                        "http://news.yahoo.com/news/topics/",
                        "http://news.google.com",
                        "http://news.yahoo.com/us"
                    ],
                    "edges": [
                        [
                            2,
                            0
                        ],
                        [
                            2,
                            1
                        ],
                        [
                            3,
                            2
                        ],
                        [
                            3,
                            1
                        ],
                        [
                            0,
                            4
                        ]
                    ]
                }
            },
            "expected": [
                "http://news.yahoo.com",
                "http://news.yahoo.com/news",
                "http://news.yahoo.com/news/topics/",
                "http://news.yahoo.com/us"
            ],
            "validator": {
                "kind": "unordered_list"
            },
            "tags": [
                "sample",
                "hostname-filter"
            ]
        },
        {
            "id": "sample-google",
            "name": "sample: reject every outgoing cross-host link",
            "kind": "sample",
            "visible": true,
            "input": {
                "startUrl": "http://news.google.com",
                "htmlParser": {
                    "urls": [
                        "http://news.yahoo.com",
                        "http://news.yahoo.com/news",
                        "http://news.yahoo.com/news/topics/",
                        "http://news.google.com"
                    ],
                    "edges": [
                        [
                            0,
                            2
                        ],
                        [
                            2,
                            1
                        ],
                        [
                            3,
                            2
                        ],
                        [
                            3,
                            1
                        ],
                        [
                            3,
                            0
                        ]
                    ]
                }
            },
            "expected": [
                "http://news.google.com"
            ],
            "validator": {
                "kind": "unordered_list"
            },
            "tags": [
                "sample",
                "cross-host"
            ]
        },
        {
            "id": "trial-cycle",
            "name": "cycle visits every same-host page exactly once",
            "kind": "trial",
            "visible": true,
            "input": {
                "startUrl": "http://a.com",
                "htmlParser": {
                    "urls": [
                        "http://a.com",
                        "http://a.com/x",
                        "http://a.com/y"
                    ],
                    "edges": [
                        [
                            0,
                            1
                        ],
                        [
                            1,
                            2
                        ],
                        [
                            2,
                            0
                        ]
                    ]
                }
            },
            "expected": [
                "http://a.com",
                "http://a.com/x",
                "http://a.com/y"
            ],
            "validator": {
                "kind": "unordered_list"
            },
            "tags": [
                "cycle"
            ]
        },
        {
            "id": "trial-no-links",
            "name": "one maximum-length URL with no links is returned alone",
            "kind": "trial",
            "visible": true,
            "input": {
                "startUrl": "http://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "htmlParser": {
                    "urls": [
                        "http://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                    ],
                    "edges": []
                }
            },
            "expected": [
                "http://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
            ],
            "validator": {
                "kind": "unordered_list"
            },
            "tags": [
                "no-links",
                "minimum-url-count",
                "maximum-url-length",
                "maximum-hostname-label"
            ]
        },
        {
            "id": "trial-duplicate-edges",
            "name": "duplicate links do not duplicate results",
            "kind": "trial",
            "visible": true,
            "input": {
                "startUrl": "http://a.com",
                "htmlParser": {
                    "urls": [
                        "http://a.com",
                        "http://a.com/x"
                    ],
                    "edges": [
                        [
                            0,
                            1
                        ],
                        [
                            0,
                            1
                        ],
                        [
                            1,
                            0
                        ]
                    ]
                }
            },
            "expected": [
                "http://a.com",
                "http://a.com/x"
            ],
            "validator": {
                "kind": "unordered_list"
            },
            "tags": [
                "duplicate-links"
            ]
        },
        {
            "id": "trial-lookalike-host",
            "name": "hostname lookalike is not accepted",
            "kind": "trial",
            "visible": true,
            "input": {
                "startUrl": "http://a.com",
                "htmlParser": {
                    "urls": [
                        "http://a.com",
                        "http://a.com.evil/x",
                        "http://a.com/good"
                    ],
                    "edges": [
                        [
                            0,
                            1
                        ],
                        [
                            0,
                            2
                        ],
                        [
                            1,
                            2
                        ]
                    ]
                }
            },
            "expected": [
                "http://a.com",
                "http://a.com/good"
            ],
            "validator": {
                "kind": "unordered_list"
            },
            "tags": [
                "hostname-boundary"
            ]
        },
        {
            "id": "trial-off-host-bridge",
            "name": "traversal cannot cross another host and return",
            "kind": "trial",
            "visible": true,
            "input": {
                "startUrl": "http://a.com",
                "htmlParser": {
                    "urls": [
                        "http://a.com",
                        "http://b.com/x",
                        "http://a.com/hidden"
                    ],
                    "edges": [
                        [
                            0,
                            1
                        ],
                        [
                            1,
                            2
                        ]
                    ]
                }
            },
            "expected": [
                "http://a.com"
            ],
            "validator": {
                "kind": "unordered_list"
            },
            "tags": [
                "off-host-bridge"
            ]
        },
        {
            "id": "trial-trailing-slash",
            "name": "trailing slash distinguishes two same-host URLs",
            "kind": "trial",
            "visible": true,
            "input": {
                "startUrl": "http://slash.com",
                "htmlParser": {
                    "urls": [
                        "http://slash.com",
                        "http://slash.com/",
                        "http://slash.com/path"
                    ],
                    "edges": [
                        [
                            0,
                            1
                        ],
                        [
                            1,
                            2
                        ],
                        [
                            2,
                            0
                        ]
                    ]
                }
            },
            "expected": [
                "http://slash.com",
                "http://slash.com/",
                "http://slash.com/path"
            ],
            "validator": {
                "kind": "unordered_list"
            },
            "tags": [
                "trailing-slash",
                "distinct-urls",
                "cycle"
            ]
        }
    ]
}
