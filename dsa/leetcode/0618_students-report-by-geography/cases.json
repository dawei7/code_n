    {
      "id": "sample-1",
      "name": "sample: source unequal geography counts",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Student": [
            {
              "name": "Jane",
              "continent": "America"
            },
            {
              "name": "Pascal",
              "continent": "Europe"
            },
            {
              "name": "Xi",
              "continent": "Asia"
            },
            {
              "name": "Jack",
              "continent": "America"
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "America",
          "Asia",
          "Europe"
        ],
        "rows": [
          [
            "Jack",
            "Xi",
            "Pascal"
          ],
          [
            "Jane",
            null,
            null
          ]
        ]
      },
      "tags": [
        "sample",
        "source-example",
        "unbalanced"
      ]
    },
