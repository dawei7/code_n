{
  "schema_version": 1,
  "challenge_id": "lc_1369",
  "cases": [
    {
      "id": "sample-source-example",
      "name": "sample: exact source example with multiple and single-activity users",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "UserActivity": [
            {"username": "Alice", "activity": "Travel", "startDate": "2020-02-12", "endDate": "2020-02-20"},
            {"username": "Alice", "activity": "Dancing", "startDate": "2020-02-21", "endDate": "2020-02-23"},
            {"username": "Alice", "activity": "Travel", "startDate": "2020-02-24", "endDate": "2020-02-28"},
            {"username": "Bob", "activity": "Travel", "startDate": "2020-02-11", "endDate": "2020-02-18"}
          ]
        }
      },
      "expected": {
        "columns": ["username", "activity", "startDate", "endDate"],
        "rows": [
          ["Alice", "Dancing", "2020-02-21", "2020-02-23"],
          ["Bob", "Travel", "2020-02-11", "2020-02-18"]
        ]
      },
      "tags": ["sample", "source-exact", "single-activity-fallback"],
      "validator": {"kind": "unordered_table"}
    },
    {
      "id": "trial-exactly-two",
      "name": "trial: exactly two activities returns the older period",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "UserActivity": [
            {"username": "Cara", "activity": "New", "startDate": "2022-06-10", "endDate": "2022-06-11"},
            {"username": "Cara", "activity": "Old", "startDate": "2021-05-01", "endDate": "2021-05-02"}
          ]
        }
      },
      "expected": {"columns": ["username", "activity", "startDate", "endDate"], "rows": [["Cara", "Old", "2021-05-01", "2021-05-02"]]},
      "tags": ["trial", "two-activities", "older-period"],
      "validator": {"kind": "unordered_table"}
    },
    {
      "id": "trial-single",
      "name": "trial: one activity is returned unchanged",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {"UserActivity": [{"username": "Dan", "activity": "Chess", "startDate": "2019-08-08", "endDate": "2019-08-09"}]}
      },
      "expected": {"columns": ["username", "activity", "startDate", "endDate"], "rows": [["Dan", "Chess", "2019-08-08", "2019-08-09"]]},
      "tags": ["trial", "single-activity", "fallback"],
      "validator": {"kind": "unordered_table"}
    },
    {
      "id": "trial-scrambled-input",
      "name": "trial: physical input order is irrelevant",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "UserActivity": [
            {"username": "Eve", "activity": "Latest", "startDate": "2023-12-01", "endDate": "2023-12-02"},
            {"username": "Eve", "activity": "Earliest", "startDate": "2021-01-01", "endDate": "2021-01-02"},
            {"username": "Eve", "activity": "Middle", "startDate": "2022-07-01", "endDate": "2022-07-02"}
          ]
        }
      },
      "expected": {"columns": ["username", "activity", "startDate", "endDate"], "rows": [["Eve", "Middle", "2022-07-01", "2022-07-02"]]},
      "tags": ["trial", "scrambled-input", "chronological-order"],
      "validator": {"kind": "unordered_table"}
    },
    {
      "id": "trial-two-users",
      "name": "trial: user partitions rank independently",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "UserActivity": [
            {"username": "A", "activity": "A1", "startDate": "2020-01-01", "endDate": "2020-01-02"},
            {"username": "A", "activity": "A2", "startDate": "2020-02-01", "endDate": "2020-02-02"},
            {"username": "B", "activity": "B1", "startDate": "2018-01-01", "endDate": "2018-01-02"},
            {"username": "B", "activity": "B2", "startDate": "2019-01-01", "endDate": "2019-01-02"},
            {"username": "B", "activity": "B3", "startDate": "2020-01-01", "endDate": "2020-01-02"}
          ]
        }
      },
      "expected": {
        "columns": ["username", "activity", "startDate", "endDate"],
        "rows": [["A", "A1", "2020-01-01", "2020-01-02"], ["B", "B2", "2019-01-01", "2019-01-02"]]
      },
      "tags": ["trial", "multiple-users", "independent-partitions"],
      "validator": {"kind": "unordered_table"}
    },
    {
      "id": "trial-four-activities",
      "name": "trial: choose the second newest among four periods",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "UserActivity": [
            {"username": "Fay", "activity": "One", "startDate": "2020-01-01", "endDate": "2020-01-02"},
            {"username": "Fay", "activity": "Four", "startDate": "2020-04-01", "endDate": "2020-04-02"},
            {"username": "Fay", "activity": "Two", "startDate": "2020-02-01", "endDate": "2020-02-02"},
            {"username": "Fay", "activity": "Three", "startDate": "2020-03-01", "endDate": "2020-03-02"}
          ]
        }
      },
      "expected": {"columns": ["username", "activity", "startDate", "endDate"], "rows": [["Fay", "Three", "2020-03-01", "2020-03-02"]]},
      "tags": ["trial", "four-activities", "second-newest"],
      "validator": {"kind": "unordered_table"}
    },
    {
      "id": "trial-unrestricted-output-order",
      "name": "trial: result order is unrestricted across users",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "UserActivity": [
            {"username": "Zoe", "activity": "Z only", "startDate": "2020-01-01", "endDate": "2020-01-02"},
            {"username": "Amy", "activity": "A old", "startDate": "2020-01-01", "endDate": "2020-01-02"},
            {"username": "Amy", "activity": "A new", "startDate": "2020-02-01", "endDate": "2020-02-02"}
          ]
        }
      },
      "expected": {
        "columns": ["username", "activity", "startDate", "endDate"],
        "rows": [["Amy", "A old", "2020-01-01", "2020-01-02"], ["Zoe", "Z only", "2020-01-01", "2020-01-02"]]
      },
      "tags": ["trial", "multiple-users", "unordered-result"],
      "validator": {"kind": "unordered_table"}
    },
    {
      "id": "trial-duplicate-newest-row",
      "name": "trial: duplicate newest storage rows do not change recency",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "UserActivity": [
            {"username": "Gus", "activity": "Newest", "startDate": "2024-03-01", "endDate": "2024-03-02"},
            {"username": "Gus", "activity": "Middle", "startDate": "2024-02-01", "endDate": "2024-02-02"},
            {"username": "Gus", "activity": "Newest", "startDate": "2024-03-01", "endDate": "2024-03-02"},
            {"username": "Gus", "activity": "Oldest", "startDate": "2024-01-01", "endDate": "2024-01-02"}
          ]
        }
      },
      "expected": {"columns": ["username", "activity", "startDate", "endDate"], "rows": [["Gus", "Middle", "2024-02-01", "2024-02-02"]]},
      "tags": ["trial", "duplicate-rows", "logical-periods"],
      "validator": {"kind": "unordered_table"}
    }
  ]
}
