{
  "schema_version": 1,
  "challenge_id": "lc_2700",
  "cases": [
    {
      "id": "sample-added-keys-ignored",
      "name": "sample: keys present only in the second object are ignored",
      "kind": "sample",
      "visible": true,
      "input": {
        "obj1": {},
        "obj2": {
          "a": 1,
          "b": 2
        }
      },
      "expected": {},
      "tags": [
        "sample",
        "key-intersection"
      ]
    },
    {
      "id": "sample-nested-object",
      "name": "sample: primitive changes inside a nested object",
      "kind": "sample",
      "visible": true,
      "input": {
        "obj1": {
          "a": 1,
          "v": 3,
          "x": [],
          "z": {
            "a": null
          }
        },
        "obj2": {
          "a": 2,
          "v": 4,
          "x": [],
          "z": {
            "a": 2
          }
        }
      },
      "expected": {
        "a": [
          1,
          2
        ],
        "v": [
          3,
          4
        ],
        "z": {
          "a": [
            null,
            2
          ]
        }
      },
      "tags": [
        "sample",
        "nested-object"
      ]
    },
    {
      "id": "sample-nested-arrays",
      "name": "sample: array indices are object keys",
      "kind": "sample",
      "visible": true,
      "input": {
        "obj1": {
          "a": 5,
          "v": 6,
          "z": [
            1,
            2,
            4,
            [
              2,
              5,
              7
            ]
          ]
        },
        "obj2": {
          "a": 5,
          "v": 7,
          "z": [
            1,
            2,
            3,
            [
              1
            ]
          ]
        }
      },
      "expected": {
        "v": [
          6,
          7
        ],
        "z": {
          "2": [
            4,
            3
          ],
          "3": {
            "0": [
              2,
              1
            ]
          }
        }
      },
      "tags": [
        "sample",
        "arrays",
        "removed-indices"
      ]
    },
    {
      "id": "sample-container-mismatch",
      "name": "sample: object and array values have different types",
      "kind": "sample",
      "visible": true,
      "input": {
        "obj1": {
          "a": {
            "b": 1
          }
        },
        "obj2": {
          "a": [
            5
          ]
        }
      },
      "expected": {
        "a": [
          {
            "b": 1
          },
          [
            5
          ]
        ]
      },
      "tags": [
        "sample",
        "type-mismatch"
      ]
    },
    {
      "id": "sample-key-order",
      "name": "sample: object key order does not create a difference",
      "kind": "sample",
      "visible": true,
      "input": {
        "obj1": {
          "a": [
            1,
            2,
            {}
          ],
          "b": false
        },
        "obj2": {
          "b": false,
          "a": [
            1,
            2,
            {}
          ]
        }
      },
      "expected": {},
      "tags": [
        "sample",
        "key-order"
      ]
    },
    {
      "id": "trial-root-arrays",
      "name": "trial: root arrays compare their common indices",
      "kind": "trial",
      "visible": true,
      "input": {
        "obj1": [
          1,
          2,
          3
        ],
        "obj2": [
          1,
          4
        ]
      },
      "expected": {
        "1": [
          2,
          4
        ]
      },
      "tags": [
        "arrays",
        "common-indices"
      ]
    },
    {
      "id": "trial-null-object",
      "name": "trial: null and an object form a leaf difference",
      "kind": "trial",
      "visible": true,
      "input": {
        "obj1": {
          "value": null
        },
        "obj2": {
          "value": {}
        }
      },
      "expected": {
        "value": [
          null,
          {}
        ]
      },
      "tags": [
        "null",
        "type-mismatch"
      ]
    },
    {
      "id": "real-disjoint-keys",
      "name": "added and removed keys are both omitted",
      "kind": "trial",
      "visible": true,
      "input": {
        "obj1": {
          "left": 1,
          "shared": {
            "x": 2
          },
          "old": 3
        },
        "obj2": {
          "right": 4,
          "shared": {
            "x": 2
          },
          "fresh": 5
        }
      },
      "expected": {},
      "tags": [
        "disjoint-keys"
      ]
    },
    {
      "id": "real-primitive-types",
      "name": "equal-looking primitive values keep their JSON types",
      "kind": "trial",
      "visible": true,
      "input": {
        "obj1": {
          "value": 1,
          "flag": true
        },
        "obj2": {
          "value": "1",
          "flag": false
        }
      },
      "expected": {
        "value": [
          1,
          "1"
        ],
        "flag": [
          true,
          false
        ]
      },
      "tags": [
        "primitive-types"
      ]
    },
    {
      "id": "real-extra-array-tail",
      "name": "removed array suffixes are ignored while shared indices recurse",
      "kind": "trial",
      "visible": true,
      "input": {
        "obj1": {
          "items": [
            {
              "x": 1
            },
            {
              "y": 2
            },
            9
          ]
        },
        "obj2": {
          "items": [
            {
              "x": 1
            },
            {
              "y": 3
            }
          ]
        }
      },
      "expected": {
        "items": {
          "1": {
            "y": [
              2,
              3
            ]
          }
        }
      },
      "tags": [
        "array-tail",
        "nested"
      ]
    }
  ]
}