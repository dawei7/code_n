{
  "schema_version": 1,
  "challenge_id": "lc_2329",
  "cases": [
    {
      "id": "sample-users",
      "name": "sample: two users tie below the highest spender",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Sales": [
            {
              "sale_id": 1,
              "product_id": 1,
              "user_id": 101,
              "quantity": 10
            },
            {
              "sale_id": 2,
              "product_id": 2,
              "user_id": 101,
              "quantity": 1
            },
            {
              "sale_id": 3,
              "product_id": 3,
              "user_id": 102,
              "quantity": 3
            },
            {
              "sale_id": 4,
              "product_id": 3,
              "user_id": 102,
              "quantity": 2
            },
            {
              "sale_id": 5,
              "product_id": 2,
              "user_id": 103,
              "quantity": 3
            }
          ],
          "Product": [
            {
              "product_id": 1,
              "price": 10
            },
            {
              "product_id": 2,
              "price": 25
            },
            {
              "product_id": 3,
              "price": 15
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "user_id",
          "spending"
        ],
        "rows": [
          [
            101,
            125
          ],
          [
            102,
            75
          ],
          [
            103,
            75
          ]
        ]
      },
      "validator": {
        "kind": "ordered_table"
      },
      "tags": [
        "sample",
        "tie-order"
      ]
    },
    {
