{
  "schema_version": 1,
  "challenge_id": "lc_2496",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: mixed alphanumeric and numeric strings",
      "kind": "sample",
      "visible": true,
      "input": {
        "strs": [
          "alic3",
          "bob",
          "3",
          "4",
          "00000"
        ]
      },
      "expected": 5,
      "tags": [
        "sample",
        "mixed",
        "leading-zeroes"
      ]
    },
    {
      "id": "sample-2",
      "name": "sample: equal numeric values with leading zeroes",
      "kind": "sample",
      "visible": true,
      "input": {
        "strs": [
          "1",
          "01",
          "001",
          "0001"
        ]
      },
      "expected": 1,
      "tags": [
        "sample",
        "numeric",
        "leading-zeroes"
      ]
    },
    {
      "id": "trial-large-numeric-value",
      "name": "trial: numeric value exceeds every text length",
      "kind": "trial",
      "visible": true,
      "input": {
        "strs": [
          "abcde",
          "999",
          "12x"
        ]
      },
      "expected": 999,
      "tags": [
        "trial",
        "numeric-maximum"
      ]
    },
    {
      "id": "trial-longest-text",
      "name": "trial: a text length is the maximum",
      "kind": "trial",
      "visible": true,
      "input": {
        "strs": [
          "000",
          "abcdefghi",
          "7z"
        ]
      },
      "expected": 9,
      "tags": [
        "trial",
        "length-maximum"
      ]
    },
    {
      "id": "real-single-letter",
      "name": "one alphabetic character",
      "kind": "trial",
      "visible": true,
      "input": {
        "strs": [
          "a"
        ]
      },
      "expected": 1,
      "tags": [
        "singleton",
        "text"
      ]
    },
    {
      "id": "real-single-zero",
      "name": "one zero digit has numeric value zero",
      "kind": "trial",
      "visible": true,
      "input": {
        "strs": [
          "0"
        ]
      },
      "expected": 0,
      "tags": [
        "singleton",
        "zero"
      ]
    },
    {
      "id": "real-all-zeroes",
      "name": "many leading zeroes still represent zero",
      "kind": "trial",
      "visible": true,
      "input": {
        "strs": [
          "000000000",
          "000",
          "00"
        ]
      },
      "expected": 0,
      "tags": [
        "leading-zeroes",
        "zero"
      ]
    },
    {
      "id": "real-maximum-numeric",
      "name": "a nine-digit numeric string",
      "kind": "trial",
      "visible": true,
      "input": {
        "strs": [
          "999999999",
          "abcdefgh",
          "12345678x"
        ]
      },
      "expected": 999999999,
      "tags": [
        "boundary",
        "numeric"
      ]
    },
    {
      "id": "real-letter-anywhere",
      "name": "any letter selects the full string length",
      "kind": "trial",
      "visible": true,
      "input": {
        "strs": [
          "1a2345678",
          "1234567b",
          "c123456"
        ]
      },
      "expected": 9,
      "tags": [
        "mixed",
        "classification"
      ]
    }
  ]
}