{
  "schema_version": 1,
  "challenge_id": "lc_1211",
  "cases": [
    {
      "id": "sample-two-names",
      "name": "sample: quality and poor percentage for two names",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Queries": [
            {
              "query_name": "Dog",
              "result": "Golden Retriever",
              "position": 1,
              "rating": 5
            },
            {
              "query_name": "Dog",
              "result": "German Shepherd",
              "position": 2,
              "rating": 5
            },
            {
              "query_name": "Dog",
              "result": "Mule",
              "position": 200,
              "rating": 1
            },
            {
              "query_name": "Cat",
              "result": "Shirazi",
              "position": 5,
              "rating": 2
            },
            {
              "query_name": "Cat",
              "result": "Siamese",
              "position": 3,
              "rating": 3
            },
            {
              "query_name": "Cat",
              "result": "Sphynx",
              "position": 7,
              "rating": 4
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "query_name",
          "quality",
          "poor_query_percentage"
        ],
        "rows": [
          [
            "Cat",
            0.66,
            33.33
          ],
          [
            "Dog",
            2.5,
            33.33
          ]
        ]
      },
      "tags": [
        "sample",
        "aggregation"
      ]
    },
    {
      "id": "trial-no-poor",
      "name": "group with no poor rows has zero percentage",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Queries": [
            {
              "query_name": "Safe",
              "result": "A",
              "position": 2,
              "rating": 4
            },
            {
              "query_name": "Safe",
              "result": "B",
              "position": 4,
              "rating": 3
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "query_name",
          "quality",
          "poor_query_percentage"
        ],
        "rows": [
          [
            "Safe",
            1.38,
            0.0
          ]
        ]
      },
      "tags": [
        "no-poor",
        "rounding"
      ]
    },
    {
