{
  "schema_version": 1,
  "challenge_id": "lc_588",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: source create, list, and read sequence",
      "kind": "sample",
      "visible": true,
      "input": {
        "operations": [
          [
            "ls",
            "/"
          ],
          [
            "mkdir",
            "/a/b/c"
          ],
          [
            "addContentToFile",
            "/a/b/c/d",
            "hello"
          ],
          [
            "ls",
            "/"
          ],
          [
            "readContentFromFile",
            "/a/b/c/d"
          ]
        ]
      },
      "expected": [
        [],
        [
          "a"
        ],
        "hello"
      ],
      "tags": [
        "sample",
        "source-example",
        "adapter-workflow"
      ]
    },
    {
      "id": "trial-append-content",
      "name": "trial: append file content and list the file",
      "kind": "trial",
      "visible": true,
      "input": {
        "operations": [
          [
            "mkdir",
            "/x"
          ],
          [
            "addContentToFile",
            "/x/file",
            "ab"
          ],
          [
            "addContentToFile",
            "/x/file",
            "cd"
          ],
          [
            "readContentFromFile",
            "/x/file"
          ],
          [
            "ls",
            "/x/file"
          ]
        ]
      },
      "expected": [
        "abcd",
        [
          "file"
        ]
      ],
      "tags": [
        "trial",
        "append",
        "file-listing"
      ]
    },
    {
      "id": "trial-lexicographic-listing",
      "name": "trial: directory listing is lexicographic",
      "kind": "trial",
      "visible": true,
      "input": {
        "operations": [
          [
            "mkdir",
            "/b"
          ],
          [
            "mkdir",
            "/a"
          ],
          [
            "mkdir",
            "/c"
          ],
          [
            "ls",
            "/"
          ]
        ]
      },
      "expected": [
        [
          "a",
          "b",
          "c"
        ]
      ],
      "tags": [
        "trial",
        "sorting",
        "root"
      ]
    },
    {
      "id": "trial-recursive-mkdir",
      "name": "trial: mkdir creates missing ancestors",
      "kind": "trial",
      "visible": true,
      "input": {
        "operations": [
          [
            "mkdir",
            "/a/b/c"
          ],
          [
            "ls",
            "/a"
          ],
          [
            "ls",
            "/a/b"
          ],
          [
            "ls",
            "/a/b/c"
          ]
        ]
      },
      "expected": [
        [
          "b"
        ],
        [
          "c"
        ],
        []
      ],
      "tags": [
        "trial",
        "recursive-mkdir",
        "empty-directory"
      ]
    },
    {
      "id": "trial-mixed-children",
      "name": "trial: directories and files are siblings",
      "kind": "trial",
      "visible": true,
      "input": {
        "operations": [
          [
            "mkdir",
            "/root/folder"
          ],
          [
            "addContentToFile",
            "/root/zfile",
            "z"
          ],
          [
            "addContentToFile",
            "/root/afile",
            "a"
          ],
          [
            "ls",
            "/root"
          ],
          [
            "readContentFromFile",
            "/root/afile"
          ]
        ]
      },
      "expected": [
        [
          "afile",
          "folder",
          "zfile"
        ],
        "a"
      ],
      "tags": [
        "trial",
        "mixed-children",
        "sorting"
      ]
    },
    {
      "id": "trial-root-file",
      "name": "trial: file directly under root",
      "kind": "trial",
      "visible": true,
      "input": {
        "operations": [
          [
            "addContentToFile",
            "/note",
            "one"
          ],
          [
            "addContentToFile",
            "/note",
            " two"
          ],
          [
            "ls",
            "/note"
          ],
          [
            "readContentFromFile",
            "/note"
          ],
          [
            "ls",
            "/"
          ]
        ]
      },
      "expected": [
        [
          "note"
        ],
        "one two",
        [
          "note"
        ]
      ],
      "tags": [
        "trial",
        "root-file",
        "append"
      ]
    },
    {
      "id": "trial-shared-prefixes",
      "name": "trial: shared path prefixes remain independent",
      "kind": "trial",
      "visible": true,
      "input": {
        "operations": [
          [
            "mkdir",
            "/team/alpha"
          ],
          [
            "mkdir",
            "/team/alpine"
          ],
          [
            "addContentToFile",
            "/team/alpha/log",
            "A"
          ],
          [
            "addContentToFile",
            "/team/alpine/log",
            "B"
          ],
          [
            "ls",
            "/team"
          ],
          [
            "readContentFromFile",
            "/team/alpha/log"
          ],
          [
            "readContentFromFile",
            "/team/alpine/log"
          ]
        ]
      },
      "expected": [
        [
          "alpha",
          "alpine"
        ],
        "A",
        "B"
      ],
      "tags": [
        "trial",
        "shared-prefix",
        "independent-content"
      ]
    },
    {
      "id": "trial-maximum-path-and-content",
