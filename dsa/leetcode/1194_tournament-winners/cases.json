{
  "schema_version": 1,
  "challenge_id": "lc_1194",
  "cases": [
    {
      "id": "sample-three-groups",
      "name": "source example: winners across three groups",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Players": [
            {"player_id": 15, "group_id": 1},
            {"player_id": 25, "group_id": 1},
            {"player_id": 30, "group_id": 1},
            {"player_id": 45, "group_id": 1},
            {"player_id": 10, "group_id": 2},
            {"player_id": 35, "group_id": 2},
            {"player_id": 50, "group_id": 2},
            {"player_id": 20, "group_id": 3},
            {"player_id": 40, "group_id": 3}
          ],
          "Matches": [
            {"match_id": 1, "first_player": 15, "second_player": 45, "first_score": 3, "second_score": 0},
            {"match_id": 2, "first_player": 30, "second_player": 25, "first_score": 1, "second_score": 2},
            {"match_id": 3, "first_player": 30, "second_player": 15, "first_score": 2, "second_score": 0},
            {"match_id": 4, "first_player": 40, "second_player": 20, "first_score": 5, "second_score": 2},
            {"match_id": 5, "first_player": 35, "second_player": 50, "first_score": 1, "second_score": 1}
          ]
        }
      },
      "expected": {"columns": ["group_id", "player_id"], "rows": [[1, 15], [2, 35], [3, 40]]},
      "validator": {"kind": "unordered_table"},
      "tags": ["sample", "aggregation", "tie-break", "multiple-groups"]
    },
    {
      "id": "trial-two-player-tie",
      "name": "smaller identifier wins an exact tie",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Players": [{"player_id": 5, "group_id": 1}, {"player_id": 2, "group_id": 1}],
          "Matches": [{"match_id": 1, "first_player": 5, "second_player": 2, "first_score": 4, "second_score": 4}]
        }
      },
      "expected": {"columns": ["group_id", "player_id"], "rows": [[1, 2]]},
      "validator": {"kind": "unordered_table"},
      "tags": ["trial", "tie", "minimum-id"]
    },
    {
      "id": "trial-both-roles",
      "name": "scores accumulate from both match roles",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Players": [{"player_id": 1, "group_id": 7}, {"player_id": 2, "group_id": 7}, {"player_id": 3, "group_id": 7}],
          "Matches": [
            {"match_id": 1, "first_player": 1, "second_player": 2, "first_score": 2, "second_score": 4},
            {"match_id": 2, "first_player": 3, "second_player": 1, "first_score": 3, "second_score": 5}
          ]
        }
      },
      "expected": {"columns": ["group_id", "player_id"], "rows": [[7, 1]]},
      "validator": {"kind": "unordered_table"},
      "tags": ["trial", "first-player", "second-player", "role-normalization"]
    },
    {
      "id": "trial-repeated-opponents",
      "name": "repeated matches each contribute to the totals",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Players": [{"player_id": 10, "group_id": 1}, {"player_id": 20, "group_id": 1}],
          "Matches": [
            {"match_id": 1, "first_player": 10, "second_player": 20, "first_score": 1, "second_score": 3},
            {"match_id": 2, "first_player": 20, "second_player": 10, "first_score": 1, "second_score": 5}
          ]
        }
      },
      "expected": {"columns": ["group_id", "player_id"], "rows": [[1, 10]]},
      "validator": {"kind": "unordered_table"},
      "tags": ["trial", "repeated-opponents", "accumulation"]
    },
    {
      "id": "trial-zero-score-tie",
      "name": "zero-score tie uses the smallest identifier",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Players": [{"player_id": 8, "group_id": 2}, {"player_id": 4, "group_id": 2}],
          "Matches": [{"match_id": 1, "first_player": 8, "second_player": 4, "first_score": 0, "second_score": 0}]
        }
      },
      "expected": {"columns": ["group_id", "player_id"], "rows": [[2, 4]]},
      "validator": {"kind": "unordered_table"},
      "tags": ["trial", "zero-score", "tie"]
    },
    {
      "id": "trial-independent-groups",
      "name": "groups are ranked independently",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Players": [
            {"player_id": 1, "group_id": 1},
            {"player_id": 2, "group_id": 1},
            {"player_id": 3, "group_id": 2},
            {"player_id": 4, "group_id": 2}
          ],
          "Matches": [
            {"match_id": 1, "first_player": 1, "second_player": 2, "first_score": 2, "second_score": 1},
            {"match_id": 2, "first_player": 3, "second_player": 4, "first_score": 1, "second_score": 9}
          ]
        }
      },
      "expected": {"columns": ["group_id", "player_id"], "rows": [[1, 1], [2, 4]]},
      "validator": {"kind": "unordered_table"},
      "tags": ["trial", "multiple-groups", "group-isolation"]
    },
    {
      "id": "trial-no-matches",
      "name": "groups without matches choose their smallest player identifier",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Players": [
            {"player_id": 12, "group_id": 4},
            {"player_id": 3, "group_id": 4},
            {"player_id": 40, "group_id": 9},
            {"player_id": 25, "group_id": 9}
          ],
          "Matches": {
            "columns": ["match_id", "first_player", "second_player", "first_score", "second_score"],
            "rows": []
          }
        }
      },
      "expected": {"columns": ["group_id", "player_id"], "rows": [[4, 3], [9, 25]]},
      "validator": {"kind": "unordered_table"},
      "tags": ["trial", "empty-matches", "zero-total", "left-join"]
    },
    {
      "id": "trial-unmatched-player-wins-zero-tie",
