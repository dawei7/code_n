      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Weather": [
            {
              "city_id": 4,
              "day": "2022-12-30",
              "degree": 20
            },
            {
              "city_id": 4,
              "day": "2022-01-02",
              "degree": 20
            },
            {
              "city_id": 4,
              "day": "2022-06-15",
              "degree": 20
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "city_id",
          "day",
          "degree"
        ],
        "rows": [
          [
            4,
            "2022-01-02",
            20
          ]
        ]
      },
      "validator": {
        "kind": "ordered_table"
      },
      "tags": [
        "tie",
        "earliest-day"
      ]
    },
