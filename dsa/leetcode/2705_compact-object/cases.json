          "text": "x",
          "zero": 0,
          "empty": ""
        }
      },
      "expected": {
        "negative": -1,
        "positive": 2,
        "text": "x"
      },
      "tags": [
        "truthiness",
        "primitives"
      ]
    },
    {
      "id": "real-deep-object",
