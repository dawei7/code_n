      "input": {
        "obj": {
          "a": null,
          "b": [
            false,
            1
          ]
        }
      },
      "expected": {
        "b": [
          1
        ]
      },
      "tags": [
        "sample",
        "object"
      ]
    },
    {
      "id": "sample-empty-containers",
