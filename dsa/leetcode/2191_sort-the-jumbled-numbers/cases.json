    {
      "id": "sample-leading-zero-tie",
      "name": "sample: mapped leading zeros create a stable tie",
      "kind": "sample",
      "visible": true,
      "input": {
        "mapping": [
          8,
          9,
          4,
          0,
          2,
          1,
          3,
          5,
          7,
          6
        ],
        "nums": [
          991,
          338,
          38
        ]
      },
      "expected": [
        338,
        38,
        991
      ],
      "tags": [
        "sample",
        "leading-zero",
        "stable-tie"
      ]
    },
