      "expected": [
        -1000000,
        -5,
        0,
        0,
        1000000,
        7
      ],
      "tags": [
        "value-bounds",
        "stability"
      ]
    },
    {
      "id": "real-no-greater-values",
      "name": "the greater-than group may be empty",
