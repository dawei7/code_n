      "visible": true,
      "input": {
        "nums": [
          5
        ],
        "pivot": 5
      },
      "expected": [
        5
      ],
      "tags": [
        "minimum-length"
      ]
    },
    {
      "id": "trial-all-equal",
      "name": "all values equal the pivot",
