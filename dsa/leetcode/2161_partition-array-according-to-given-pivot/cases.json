{
  "schema_version": 1,
  "challenge_id": "lc_2161",
  "cases": [
    {
      "id": "sample-multiple-pivots",
      "name": "sample: stable groups around repeated pivot",
      "kind": "sample",
      "visible": true,
      "input": {
        "nums": [
          9,
          12,
          5,
          10,
          14,
          3,
          10
        ],
        "pivot": 10
      },
      "expected": [
        9,
        5,
        3,
        10,
        10,
        12,
        14
      ],
      "tags": [
        "sample",
        "stability",
        "duplicate-pivot"
      ]
    },
    {
      "id": "sample-negative-smaller",
      "name": "sample: greater values preserve descending encounter order",
      "kind": "sample",
      "visible": true,
      "input": {
        "nums": [
          -3,
          4,
          3,
          2
        ],
        "pivot": 2
      },
      "expected": [
        -3,
        2,
        4,
        3
      ],
      "tags": [
        "sample",
        "negative",
        "stability"
      ]
    },
    {
      "id": "trial-single-pivot",
