            {
              "log_id": 3,
              "ip": "1.2.3.4.5",
              "status_code": 400
            },
            {
              "log_id": 4,
              "ip": "1.2.3.",
              "status_code": 200
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "ip",
          "invalid_count"
        ],
        "rows": [
          [
            "1.2.3.4.5",
            1
          ],
          [
            "1.2.3",
            1
          ]
        ]
      },
      "tags": [
        "trial",
        "octet-count",
        "empty-octet"
      ]
    },
