  "cases": [
    {
      "id": "sample-official",
      "name": "sample: official access logs",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "logs": [
            {
              "log_id": 1,
              "ip": "192.168.1.1",
              "status_code": 200
            },
            {
              "log_id": 2,
              "ip": "256.1.2.3",
              "status_code": 404
            },
            {
              "log_id": 3,
              "ip": "192.168.001.1",
              "status_code": 200
            },
            {
              "log_id": 4,
              "ip": "192.168.1.1",
              "status_code": 200
            },
            {
              "log_id": 5,
              "ip": "192.168.1",
              "status_code": 500
            },
            {
              "log_id": 6,
              "ip": "256.1.2.3",
              "status_code": 404
            },
            {
              "log_id": 7,
              "ip": "192.168.001.1",
              "status_code": 200
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "ip",
          "invalid_count"
        ],
        "rows": [
          [
            "256.1.2.3",
            2
          ],
          [
            "192.168.001.1",
            2
          ],
          [
            "192.168.1",
            1
          ]
        ]
      },
      "tags": [
        "sample",
        "grouping"
      ]
    },
    {
      "id": "trial-value-and-zero-boundaries",
      "name": "trial: 255 and single zero are valid boundaries",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "logs": [
            {
              "log_id": 1,
              "ip": "255.255.255.255",
              "status_code": 200
            },
            {
              "log_id": 2,
              "ip": "255.255.255.256",
              "status_code": 400
            },
            {
              "log_id": 3,
              "ip": "0.1.2.3",
              "status_code": 200
            },
            {
              "log_id": 4,
              "ip": "00.1.2.3",
              "status_code": 400
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "ip",
          "invalid_count"
        ],
        "rows": [
          [
            "255.255.255.256",
            1
          ],
          [
            "00.1.2.3",
            1
          ]
        ]
      },
      "tags": [
        "trial",
        "numeric-boundary",
        "leading-zero"
      ]
    },
    {
      "id": "trial-octet-count-semantics",
