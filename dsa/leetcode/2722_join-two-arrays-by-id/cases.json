        {
          "id": 3,
          "x": 5
        }
      ],
      "tags": [
        "sample",
        "disjoint"
      ]
    },
    {
      "id": "sample-overrides",
      "name": "sample: second array overrides shared keys",
      "kind": "sample",
      "visible": true,
      "input": {
        "arr1": [
          {
            "id": 1,
            "x": 2,
            "y": 3
          },
          {
            "id": 2,
            "x": 3,
            "y": 6
          }
        ],
        "arr2": [
          {
            "id": 2,
            "x": 10,
            "y": 20
          },
          {
            "id": 3,
            "x": 0,
            "y": 0
          }
        ]
      },
      "expected": [
        {
          "id": 1,
          "x": 2,
          "y": 3
        },
        {
          "id": 2,
          "x": 10,
          "y": 20
        },
        {
          "id": 3,
          "x": 0,
          "y": 0
        }
      ],
      "tags": [
        "sample",
        "override"
      ]
    },
    {
      "id": "sample-shallow",
      "name": "sample: nested values are replaced",
      "kind": "sample",
      "visible": true,
      "input": {
        "arr1": [
          {
            "id": 1,
            "b": {
              "b": 94
            },
            "v": [
              4,
              3
            ],
            "y": 48
          }
        ],
        "arr2": [
          {
            "id": 1,
            "b": {
              "c": 84
            },
            "v": [
              1,
              3
            ]
          }
        ]
      },
      "expected": [
        {
          "id": 1,
          "b": {
            "c": 84
          },
          "v": [
            1,
            3
          ],
          "y": 48
        }
      ],
      "tags": [
        "sample",
        "shallow-merge"
      ]
    },
