        ],
        "arr2": [
          {
            "id": 3,
            "x": 3
          }
        ]
      },
      "expected": [
        {
          "id": -2,
          "x": 2
        },
        {
          "id": 3,
          "x": 3
        },
        {
          "id": 10,
          "x": 1
