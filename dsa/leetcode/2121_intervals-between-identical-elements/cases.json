        2,
        7,
        2,
        4,
        4,
        5
      ],
      "tags": [
        "sample",
        "multiple-groups"
      ]
    },
    {
      "id": "sample-one-unique",
      "name": "sample: one value occurs once among repetitions",
      "kind": "sample",
      "visible": true,
      "input": {
        "arr": [
          10,
          5,
          10,
          10
        ]
      },
      "expected": [
        5,
        0,
        3,
        4
      ],
      "tags": [
        "sample",
        "singleton-group"
      ]
    },
