        "sample",
        "email",
        "mixed-case"
      ]
    },
    {
      "id": "sample-2",
      "name": "sample: two-letter email name",
      "kind": "sample",
      "visible": true,
      "input": {
        "s": "AB@qq.com"
      },
      "expected": "a*****b@qq.com",
      "tags": [
        "sample",
        "email",
        "minimum-name"
      ]
    },
    {
      "id": "sample-3",
      "name": "sample: local phone with separators",
      "kind": "sample",
      "visible": true,
      "input": {
        "s": "1(234)567-890"
      },
      "expected": "***-***-7890",
