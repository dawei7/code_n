      "visible": true,
      "input": {
        "s": "algorithm",
        "dictionary": [
          "algorithm",
          "algo",
          "rhythm"
        ]
      },
      "expected": 0,
      "tags": [
        "whole-string"
      ]
    },
    {
      "id": "real-overlap-choice",
      "name": "optimal choice resolves overlapping words",
      "kind": "trial",
      "visible": true,
      "input": {
        "s": "abcde",
        "dictionary": [
          "abc",
          "bcd",
          "de"
        ]
      },
      "expected": 0,
      "tags": [
        "overlap"
      ]
    },
    {
      "id": "real-interior-extras",
