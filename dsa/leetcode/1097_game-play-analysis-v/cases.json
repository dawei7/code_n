{
  "schema_version": 1,
  "challenge_id": "lc_1097",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: shared install cohort with one retained player",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Activity": [
            {"player_id": 1, "device_id": 2, "event_date": "2016-03-01", "games_played": 5},
            {"player_id": 1, "device_id": 2, "event_date": "2016-03-02", "games_played": 6},
            {"player_id": 2, "device_id": 3, "event_date": "2017-06-25", "games_played": 1},
            {"player_id": 3, "device_id": 1, "event_date": "2016-03-01", "games_played": 0},
            {"player_id": 3, "device_id": 4, "event_date": "2016-07-03", "games_played": 5}
          ]
        }
      },
      "expected": {
        "columns": ["install_dt", "installs", "Day1_retention"],
        "rows": [["2016-03-01", 2, 0.5], ["2017-06-25", 1, 0.0]]
      },
      "tags": ["sample", "cohorts"]
    },
    {
      "id": "trial-all-retained",
      "name": "every player returns the next day despite device and game-count changes",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Activity": [
            {"player_id": 1, "device_id": 1, "event_date": "2020-01-01", "games_played": 0},
            {"player_id": 1, "device_id": 2, "event_date": "2020-01-02", "games_played": 0},
            {"player_id": 2, "device_id": 3, "event_date": "2020-01-01", "games_played": 4},
            {"player_id": 2, "device_id": 4, "event_date": "2020-01-02", "games_played": 5}
          ]
        }
      },
      "expected": {
        "columns": ["install_dt", "installs", "Day1_retention"],
        "rows": [["2020-01-01", 2, 1.0]]
      },
      "tags": ["trial", "full-retention", "zero-games", "device-independent"]
    },
    {
      "id": "trial-day-two-only",
      "name": "a return after two days is not day-one retention",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Activity": [
            {"player_id": 7, "device_id": 1, "event_date": "2021-05-10", "games_played": 1},
            {"player_id": 7, "device_id": 1, "event_date": "2021-05-12", "games_played": 2}
          ]
        }
      },
      "expected": {
        "columns": ["install_dt", "installs", "Day1_retention"],
        "rows": [["2021-05-10", 1, 0.0]]
      },
      "tags": ["trial", "exact-next-day", "later-return"]
    },
    {
      "id": "trial-rounded-rate",
      "name": "one of three retained players rounds to two decimal places",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Activity": [
            {"player_id": 1, "device_id": 1, "event_date": "2022-02-01", "games_played": 1},
            {"player_id": 1, "device_id": 1, "event_date": "2022-02-02", "games_played": 1},
            {"player_id": 2, "device_id": 1, "event_date": "2022-02-01", "games_played": 1},
            {"player_id": 2, "device_id": 1, "event_date": "2022-02-03", "games_played": 1},
            {"player_id": 3, "device_id": 1, "event_date": "2022-02-01", "games_played": 1}
          ]
        }
      },
      "expected": {
        "columns": ["install_dt", "installs", "Day1_retention"],
        "rows": [["2022-02-01", 3, 0.33]]
      },
      "tags": ["trial", "rounding", "partial-retention"]
    },
    {
      "id": "trial-independent-cohorts",
      "name": "separate install dates have independent counts and rates",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Activity": [
            {"player_id": 10, "device_id": 1, "event_date": "2023-01-01", "games_played": 1},
            {"player_id": 11, "device_id": 1, "event_date": "2023-01-02", "games_played": 1},
            {"player_id": 11, "device_id": 1, "event_date": "2023-01-03", "games_played": 1},
            {"player_id": 12, "device_id": 1, "event_date": "2023-01-02", "games_played": 1}
          ]
        }
      },
      "expected": {
        "columns": ["install_dt", "installs", "Day1_retention"],
        "rows": [["2023-01-01", 1, 0.0], ["2023-01-02", 2, 0.5]]
      },
      "tags": ["trial", "multiple-cohorts", "single-login"]
    },
    {
      "id": "trial-calendar-rollovers",
      "name": "next-day matching crosses year and leap-day boundaries",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Activity": [
            {"player_id": 20, "device_id": 1, "event_date": "2019-12-31", "games_played": 0},
            {"player_id": 20, "device_id": 2, "event_date": "2020-01-01", "games_played": 3},
            {"player_id": 21, "device_id": 3, "event_date": "2019-12-31", "games_played": 2},
            {"player_id": 21, "device_id": 3, "event_date": "2020-01-02", "games_played": 2},
            {"player_id": 22, "device_id": 4, "event_date": "2020-02-28", "games_played": 1},
            {"player_id": 22, "device_id": 4, "event_date": "2020-02-29", "games_played": 1},
            {"player_id": 23, "device_id": 5, "event_date": "2020-02-29", "games_played": 1},
            {"player_id": 23, "device_id": 6, "event_date": "2020-03-01", "games_played": 0}
          ]
        }
      },
      "expected": {
        "columns": ["install_dt", "installs", "Day1_retention"],
        "rows": [["2019-12-31", 2, 0.5], ["2020-02-28", 1, 1.0], ["2020-02-29", 1, 1.0]]
      },
      "tags": ["trial", "calendar-boundary", "leap-day", "year-rollover"]
    },
    {
      "id": "trial-empty-activity",
      "name": "an empty activity table produces no cohorts",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Activity": {
            "columns": ["player_id", "device_id", "event_date", "games_played"],
            "rows": []
          }
        }
      },
      "expected": {
        "columns": ["install_dt", "installs", "Day1_retention"],
        "rows": []
      },
      "tags": ["trial", "empty-input", "empty-output"]
    }
  ]
}
