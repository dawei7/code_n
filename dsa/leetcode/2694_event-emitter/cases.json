    {
      "id": "sample-empty-then-two-listeners",
      "name": "sample: empty emission followed by two ordered listeners",
      "kind": "sample",
      "visible": true,
      "input": {
        "actions": [
          "EventEmitter",
          "emit",
          "subscribe",
          "subscribe",
          "emit"
        ],
        "values": [
          [],
          [
            "firstEvent"
          ],
          [
            "firstEvent",
            {
              "type": "constant",
              "value": 5
            }
          ],
          [
            "firstEvent",
            {
              "type": "constant",
              "value": 6
            }
          ],
          [
            "firstEvent"
          ]
        ]
      },
      "expected": [
        [],
        [
          "emitted",
          []
        ],
        [
          "subscribed"
        ],
        [
          "subscribed"
        ],
        [
          "emitted",
          [
            5,
            6
          ]
        ]
      ],
      "tags": [
        "sample",
        "order",
        "empty-event"
      ]
    },
    {
