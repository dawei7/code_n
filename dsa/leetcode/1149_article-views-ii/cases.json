{
  "schema_version": 1,
  "challenge_id": "lc_1149",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: two viewers qualify on one date",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Views": [
            {"article_id": 1, "author_id": 3, "viewer_id": 5, "view_date": "2019-08-01"},
            {"article_id": 3, "author_id": 4, "viewer_id": 5, "view_date": "2019-08-01"},
            {"article_id": 1, "author_id": 3, "viewer_id": 6, "view_date": "2019-08-02"},
            {"article_id": 2, "author_id": 7, "viewer_id": 7, "view_date": "2019-08-01"},
            {"article_id": 2, "author_id": 7, "viewer_id": 6, "view_date": "2019-08-02"},
            {"article_id": 4, "author_id": 7, "viewer_id": 1, "view_date": "2019-07-22"},
            {"article_id": 3, "author_id": 4, "viewer_id": 4, "view_date": "2019-07-21"},
            {"article_id": 3, "author_id": 4, "viewer_id": 4, "view_date": "2019-07-21"}
          ]
        }
      },
      "expected": {"columns": ["id"], "rows": [[5], [6]]},
      "tags": ["sample", "same-date", "duplicate-row"]
    },
    {
      "id": "trial-duplicate-one-article",
      "name": "duplicate views of one article do not qualify",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Views": [
            {"article_id": 1, "author_id": 2, "viewer_id": 9, "view_date": "2020-01-01"},
            {"article_id": 1, "author_id": 2, "viewer_id": 9, "view_date": "2020-01-01"}
          ]
        }
      },
      "expected": {"columns": ["id"], "rows": []},
      "tags": ["trial", "duplicates", "distinct-article"]
    },
    {
      "id": "trial-different-dates",
      "name": "different articles on different dates do not combine",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Views": [
            {"article_id": 1, "author_id": 2, "viewer_id": 8, "view_date": "2020-01-01"},
            {"article_id": 2, "author_id": 3, "viewer_id": 8, "view_date": "2020-01-02"}
          ]
        }
      },
      "expected": {"columns": ["id"], "rows": []},
      "tags": ["trial", "date-boundary"]
    },
    {
      "id": "trial-multiple-qualifying-days",
      "name": "one viewer qualifying on several dates appears once",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Views": [
            {"article_id": 1, "author_id": 1, "viewer_id": 4, "view_date": "2021-02-01"},
            {"article_id": 2, "author_id": 2, "viewer_id": 4, "view_date": "2021-02-01"},
            {"article_id": 3, "author_id": 3, "viewer_id": 4, "view_date": "2021-02-02"},
            {"article_id": 4, "author_id": 5, "viewer_id": 4, "view_date": "2021-02-02"}
          ]
        }
      },
      "expected": {"columns": ["id"], "rows": [[4]]},
      "tags": ["trial", "distinct-viewer", "multiple-dates"]
    },
    {
      "id": "trial-sorted",
      "name": "several qualifying viewers are sorted by id",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Views": [
            {"article_id": 1, "author_id": 1, "viewer_id": 12, "view_date": "2022-03-03"},
            {"article_id": 2, "author_id": 2, "viewer_id": 12, "view_date": "2022-03-03"},
            {"article_id": 3, "author_id": 3, "viewer_id": 2, "view_date": "2022-03-04"},
            {"article_id": 4, "author_id": 4, "viewer_id": 2, "view_date": "2022-03-04"}
          ]
        }
      },
      "expected": {"columns": ["id"], "rows": [[2], [12]]},
      "tags": ["trial", "ordering", "multiple-viewers"]
    },
    {
      "id": "trial-author-irrelevant",
      "name": "own and other authors' articles count equally",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Views": [
            {"article_id": 5, "author_id": 7, "viewer_id": 7, "view_date": "2023-06-01"},
            {"article_id": 6, "author_id": 8, "viewer_id": 7, "view_date": "2023-06-01"}
          ]
        }
      },
      "expected": {"columns": ["id"], "rows": [[7]]},
      "tags": ["trial", "author-irrelevant", "same-person"]
    },
    {
      "id": "trial-empty-views",
      "name": "an empty Views table returns no people",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Views": {
            "columns": ["article_id", "author_id", "viewer_id", "view_date"],
            "rows": []
          }
        }
      },
      "expected": {"columns": ["id"], "rows": []},
      "tags": ["trial", "empty-table"]
    }
  ]
}
