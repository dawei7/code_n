    {
      "id": "real-uneven-groups",
      "name": "real: states may contain different city counts",
      "kind": "real",
      "visible": false,
      "input": {
        "tables": {
          "cities": [
            {
              "state": "Gamma",
              "city": "C"
            },
            {
              "state": "Alpha",
              "city": "A"
            },
            {
              "state": "Gamma",
              "city": "A"
            },
            {
              "state": "Gamma",
              "city": "B"
            },
            {
              "state": "Beta",
              "city": "A"
            },
            {
              "state": "Beta",
              "city": "B"
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "state",
          "cities"
        ],
        "rows": [
          [
            "Alpha",
            "A"
          ],
          [
            "Beta",
            "A, B"
          ],
          [
            "Gamma",
            "A, B, C"
          ]
        ]
      },
      "validator": {
        "kind": "ordered_table"
      },
      "tags": [
        "uneven-groups"
      ]
    },
    {
      "id": "real-reverse-input",
      "name": "real: reverse-sorted input is fully reordered",
      "kind": "real",
      "visible": false,
      "input": {
        "tables": {
          "cities": [
            {
              "state": "Zulu",
              "city": "Zed"
            },
            {
              "state": "Zulu",
              "city": "Able"
            },
            {
              "state": "Echo",
              "city": "Zulu"
            },
            {
              "state": "Echo",
              "city": "Echo"
            },
            {
              "state": "Echo",
              "city": "Able"
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "state",
          "cities"
        ],
        "rows": [
          [
            "Echo",
            "Able, Echo, Zulu"
          ],
          [
            "Zulu",
            "Able, Zed"
          ]
        ]
      },
      "validator": {
        "kind": "ordered_table"
      },
      "tags": [
        "reverse-input"
      ]
    },
