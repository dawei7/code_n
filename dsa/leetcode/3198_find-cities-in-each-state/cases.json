    {
      "id": "trial-shared-city",
      "name": "trial: the same city name may belong to different states",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "cities": [
            {
              "state": "Oregon",
              "city": "Springfield"
            },
