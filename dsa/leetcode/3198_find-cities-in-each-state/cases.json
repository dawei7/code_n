      "expected": {
        "columns": [
          "state",
          "cities"
        ],
        "rows": [
          [
            "Illinois",
            "Springfield"
          ],
          [
            "Oregon",
            "Salem, Springfield"
          ]
        ]
      },
      "validator": {
        "kind": "ordered_table"
      },
      "tags": [
        "composite-key"
      ]
    },
