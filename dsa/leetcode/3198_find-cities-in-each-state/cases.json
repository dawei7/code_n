{
  "schema_version": 1,
  "challenge_id": "lc_3198",
  "cases": [
    {
      "id": "sample-three-states",
      "name": "sample: city lists and state rows are both sorted",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "cities": [
            {
              "state": "California",
              "city": "Los Angeles"
            },
            {
              "state": "California",
              "city": "San Francisco"
            },
            {
              "state": "California",
              "city": "San Diego"
            },
            {
              "state": "Texas",
              "city": "Houston"
            },
            {
              "state": "Texas",
              "city": "Austin"
            },
            {
              "state": "Texas",
              "city": "Dallas"
            },
            {
              "state": "New York",
              "city": "New York City"
            },
            {
              "state": "New York",
              "city": "Buffalo"
            },
            {
              "state": "New York",
              "city": "Rochester"
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "state",
          "cities"
        ],
        "rows": [
          [
            "California",
            "Los Angeles, San Diego, San Francisco"
          ],
          [
            "New York",
            "Buffalo, New York City, Rochester"
          ],
          [
            "Texas",
            "Austin, Dallas, Houston"
          ]
        ]
      },
      "validator": {
        "kind": "ordered_table"
      },
      "tags": [
        "sample",
        "ordering",
        "aggregation"
      ]
    },
    {
