      ]
    },
    {
      "id": "trial-null-is-leaf",
      "name": "null is passed to the leaf predicate",
      "kind": "trial",
      "visible": true,
      "input": {
        "obj": {
          "a": null,
          "b": [
            null,
            0
          ],
          "c": false,
          "d": {
            "e": null,
            "f": "ok"
          }
        },
        "predicate": "nonNull"
      },
      "expected": {
        "defined": true,
        "value": {
          "b": [
            0
          ],
          "c": false,
          "d": {
            "f": "ok"
          }
        }
      },
      "tags": [
        "null",
        "leaf-semantics"
      ]
    },
    {
      "id": "trial-truthy-mixed",
      "name": "truthy filtering prunes empty branches",
      "kind": "trial",
      "visible": true,
      "input": {
        "obj": {
          "a": 0,
          "b": false,
          "c": "",
          "d": null,
          "e": 1,
          "f": "x",
          "g": [
            0,
            {
              "h": 2,
              "i": ""
            }
          ],
          "j": {
            "k": false
          }
        },
        "predicate": "truthy"
      },
      "expected": {
        "defined": true,
        "value": {
          "e": 1,
          "f": "x",
          "g": [
            {
              "h": 2
            }
          ]
        }
      },
      "tags": [
        "truthiness",
        "mixed-containers"
      ]
    },
