    {
      "id": "trial-special-object-keys",
      "name": "special JSON keys remain own properties",
      "kind": "trial",
      "visible": true,
      "input": {
        "obj": {
          "__proto__": {
            "keep": 1,
            "drop": -1
          },
          "constructor": {
            "nested": [
              "yes",
              ""
            ]
          },
          "empty": {
            "drop": 0
          }
        },
        "predicate": "truthy"
      },
      "expected": {
        "defined": true,
        "value": {
          "__proto__": {
            "keep": 1,
            "drop": -1
          },
          "constructor": {
            "nested": [
              "yes"
            ]
          }
        }
      },
      "tags": [
        "special-keys"
      ]
    },
    {
      "id": "trial-even-numbers",
      "name": "even numeric leaves survive across containers",
      "kind": "trial",
      "visible": true,
      "input": {
        "obj": {
          "a": [
            1,
            2,
            {
              "b": 3,
              "c": 4
            }
          ],
          "d": {
            "e": 5,
            "f": [
              6,
              7
            ]
          },
          "g": "8"
        },
        "predicate": "evenNumber"
      },
      "expected": {
        "defined": true,
        "value": {
          "a": [
            2,
            {
              "c": 4
            }
          ],
          "d": {
            "f": [
              6
            ]
          }
        }
      },
      "tags": [
        "type-sensitive",
        "nested"
      ]
    },
