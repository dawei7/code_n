          1
        ]
      },
      "tags": [
        "sample",
        "array"
      ]
    },
    {
      "id": "sample-string-object",
      "name": "sample: retain string leaves and prune empty object",
      "kind": "sample",
      "visible": true,
      "input": {
        "obj": {
          "a": 1,
          "b": "2",
          "c": 3,
          "d": "4",
          "e": 5,
          "f": 6,
          "g": {
            "a": 1
          }
        },
        "predicate": "string"
      },
      "expected": {
        "defined": true,
        "value": {
          "b": "2",
          "d": "4"
        }
      },
      "tags": [
        "sample",
        "object",
        "empty-pruning"
      ]
    },
    {
      "id": "sample-nested-arrays",
      "name": "sample: compact nested arrays after positive filtering",
      "kind": "sample",
      "visible": true,
      "input": {
        "obj": [
          -1,
          [
            -1,
            -1,
            5,
            -1,
            10
          ],
          -1,
          [
            -1
          ],
          [
            -5
          ]
        ],
        "predicate": "positive"
      },
      "expected": {
        "defined": true,
        "value": [
          [
            5,
            10
          ]
        ]
      },
      "tags": [
        "sample",
        "nested-arrays",
        "compaction"
      ]
    },
    {
