{
  "schema_version": 1,
  "challenge_id": "lc_2504",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: all six professions in descending id order",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Person": [
            {
              "person_id": 1,
              "name": "Alex",
              "profession": "Singer"
            },
            {
              "person_id": 3,
              "name": "Alice",
              "profession": "Actor"
            },
            {
              "person_id": 2,
              "name": "Bob",
              "profession": "Player"
            },
            {
              "person_id": 4,
              "name": "Messi",
              "profession": "Doctor"
            },
            {
              "person_id": 6,
              "name": "Tyson",
              "profession": "Engineer"
            },
            {
              "person_id": 5,
              "name": "Meir",
              "profession": "Lawyer"
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "person_id",
          "name"
        ],
        "rows": [
          [
            6,
            "Tyson(E)"
          ],
          [
            5,
            "Meir(L)"
          ],
          [
            4,
            "Messi(D)"
          ],
          [
            3,
            "Alice(A)"
          ],
          [
            2,
            "Bob(P)"
          ],
          [
            1,
            "Alex(S)"
          ]
        ]
      },
      "tags": [
        "sample",
        "formatting",
        "ordering"
      ]
    },
