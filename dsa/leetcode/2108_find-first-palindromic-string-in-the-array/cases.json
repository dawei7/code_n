{
  "schema_version": 1,
  "challenge_id": "lc_2108",
  "cases": [
    {
      "id": "sample-first-of-two",
      "name": "sample: return the earlier of two palindromes",
      "kind": "sample",
      "visible": true,
      "input": {"words": ["abc", "car", "ada", "racecar", "cool"]},
      "expected": "ada",
      "tags": ["sample", "first-match"]
    },
    {
      "id": "sample-second-word",
      "name": "sample: palindrome after one rejection",
      "kind": "sample",
      "visible": true,
      "input": {"words": ["notapalindrome", "racecar"]},
      "expected": "racecar",
      "tags": ["sample", "later-match"]
    },
    {
      "id": "sample-none",
      "name": "sample: no palindromic string",
      "kind": "sample",
      "visible": true,
      "input": {"words": ["def", "ghi"]},
      "expected": "",
      "tags": ["sample", "no-match"]
    },
    {
      "id": "trial-single-character",
      "name": "one character is a palindrome",
      "kind": "trial",
      "visible": true,
      "input": {"words": ["z", "aa"]},
      "expected": "z",
      "tags": ["minimum-length", "first-match"]
    },
    {
      "id": "trial-even-palindrome",
      "name": "even-length palindrome",
      "kind": "trial",
      "visible": true,
      "input": {"words": ["abca", "abba", "cc"]},
      "expected": "abba",
      "tags": ["even-length", "later-match"]
    },
    {
      "id": "real-near-center-mismatch",
      "name": "hidden: reject only after matching outer pairs",
      "kind": "real",
      "visible": false,
      "input": {"words": ["abcddxba", "level"]},
      "expected": "level",
      "tags": ["hidden", "late-mismatch"]
    },
    {
      "id": "real-repeated-letters-not-enough",
      "name": "hidden: repeated letters do not imply a palindrome",
      "kind": "real",
      "visible": false,
      "input": {"words": ["aabaaa", "bbbb", "aba"]},
      "expected": "bbbb",
      "tags": ["hidden", "duplicates", "first-match"]
    }
  ]
}
