      "visible": true,
      "input": {
        "tables": {
          "products": [
            {
              "product_id": 3,
              "product_name": "Punctuation",
              "description": "Code (SN1111-2222), ready"
            },
            {
              "product_id": 1,
              "product_name": "Beginning",
              "description": "SN0000-9999 is first"
            },
            {
              "product_id": 2,
              "product_name": "Ending",
              "description": "Ends with SN2468-1357"
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "product_id",
          "product_name",
          "description"
        ],
        "rows": [
          [
            1,
            "Beginning",
            "SN0000-9999 is first"
          ],
          [
            2,
            "Ending",
            "Ends with SN2468-1357"
          ],
          [
            3,
            "Punctuation",
            "Code (SN1111-2222), ready"
          ]
        ]
      },
      "tags": [
        "trial",
        "positions",
        "punctuation"
      ]
    },
    {
      "id": "trial-case-sensitive-prefix",
      "name": "trial: SN prefix is case-sensitive",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "products": [
            {
              "product_id": 1,
              "product_name": "Lower",
              "description": "Code sn1234-5678"
            },
            {
              "product_id": 2,
              "product_name": "Mixed One",
              "description": "Code Sn1234-5678"
            },
            {
              "product_id": 3,
              "product_name": "Mixed Two",
              "description": "Code sN1234-5678"
            },
            {
              "product_id": 4,
              "product_name": "Upper",
              "description": "Code SN1234-5678"
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "product_id",
          "product_name",
          "description"
        ],
        "rows": [
          [
            4,
            "Upper",
            "Code SN1234-5678"
          ]
        ]
      },
      "tags": [
        "trial",
        "case-sensitive"
      ]
    },
    {
