      "input": {
        "tables": {
          "products": [
            {
              "product_id": 1,
              "product_name": "Short Left",
              "description": "SN123-5678"
            },
            {
              "product_id": 2,
              "product_name": "Long Left",
              "description": "SN12345-5678"
            },
            {
              "product_id": 3,
              "product_name": "Short Right",
              "description": "SN1234-567"
            },
            {
              "product_id": 4,
              "product_name": "Long Right",
              "description": "SN1234-56789"
            },
            {
              "product_id": 5,
              "product_name": "Exact",
              "description": "SN1234-5678"
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "product_id",
          "product_name",
          "description"
