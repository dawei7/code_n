    {
      "id": "real-word-boundaries",
      "name": "token cannot be embedded in a larger word",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "products": [
            {
              "product_id": 1,
              "product_name": "Letter Prefix",
              "description": "ASN1234-5678"
            },
            {
              "product_id": 2,
              "product_name": "Letter Suffix",
              "description": "SN1234-5678Z"
            },
            {
              "product_id": 3,
              "product_name": "Underscore Prefix",
              "description": "_SN1234-5678"
            },
            {
              "product_id": 4,
              "product_name": "Underscore Suffix",
              "description": "SN1234-5678_"
            },
            {
              "product_id": 5,
              "product_name": "Separated",
              "description": "[SN1234-5678]"
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "product_id",
          "product_name",
          "description"
        ],
        "rows": [
          [
            5,
            "Separated",
            "[SN1234-5678]"
          ]
        ]
      },
      "tags": [
        "word-boundary"
      ]
    },
    {
      "id": "real-multiple-candidates",
      "name": "any valid occurrence qualifies a product once",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "products": [
            {
              "product_id": 2,
              "product_name": "Only Invalid",
              "description": "SN123-5678 and SN1234-56789"
            },
            {
              "product_id": 1,
              "product_name": "Later Valid",
              "description": "SN123-5678 then SN2222-3333"
            },
            {
              "product_id": 3,
              "product_name": "Two Valid",
              "description": "SN0000-0000 / SN9999-9999"
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "product_id",
          "product_name",
          "description"
        ],
        "rows": [
          [
            1,
            "Later Valid",
            "SN123-5678 then SN2222-3333"
          ],
          [
            3,
            "Two Valid",
            "SN0000-0000 / SN9999-9999"
          ]
        ]
      },
      "tags": [
        "multiple-occurrences"
      ]
    },
    {
      "id": "real-separator-and-prefix-traps",
      "name": "exact hyphen and adjacent digit rules",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "products": [
            {
              "product_id": 1,
              "product_name": "Space",
              "description": "SN1234 5678"
            },
            {
              "product_id": 2,
              "product_name": "Double Hyphen",
              "description": "SN1234--5678"
            },
            {
              "product_id": 3,
              "product_name": "Extra Prefix Digit",
              "description": "9SN1234-5678"
            },
            {
              "product_id": 4,
              "product_name": "Exact",
              "description": "serial:SN4444-5555."
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "product_id",
          "product_name",
          "description"
        ],
        "rows": [
          [
            4,
            "Exact",
            "serial:SN4444-5555."
          ]
        ]
      },
      "tags": [
        "separator"
      ]
    },
