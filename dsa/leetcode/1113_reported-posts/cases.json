    },
    {
      "id": "trial-multiple-reasons",
      "name": "independent reasons receive independent distinct-post counts",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Actions": [
            {"user_id": 1, "post_id": 70, "action_date": "2019-07-04", "action": "report", "extra": "spam"},
            {"user_id": 2, "post_id": 71, "action_date": "2019-07-04", "action": "report", "extra": "spam"},
            {"user_id": 3, "post_id": 72, "action_date": "2019-07-04", "action": "report", "extra": "abuse"},
            {"user_id": 4, "post_id": 73, "action_date": "2019-07-04", "action": "report", "extra": "copyright"},
            {"user_id": 5, "post_id": 74, "action_date": "2019-07-04", "action": "report", "extra": "copyright"},
            {"user_id": 6, "post_id": 75, "action_date": "2019-07-04", "action": "report", "extra": "copyright"}
          ]
        }
      },
      "expected": {
        "columns": ["report_reason", "report_count"],
