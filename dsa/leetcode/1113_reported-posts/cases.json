      "visible": true,
      "input": {
        "tables": {
          "Actions": [
            {"user_id": 1, "post_id": 60, "action_date": "2019-07-04", "action": "report", "extra": null},
            {"user_id": 2, "post_id": 60, "action_date": "2019-07-04", "action": "report", "extra": null},
            {"user_id": 3, "post_id": 61, "action_date": "2019-07-04", "action": "report", "extra": null}
          ]
        }
      },
      "expected": {
        "columns": ["report_reason", "report_count"],
        "rows": [[null, 2]]
      },
      "validator": {"kind": "unordered_table"},
