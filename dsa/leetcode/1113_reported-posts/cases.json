{
  "schema_version": 1,
  "challenge_id": "lc_1113",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: repeated reporters and two reasons",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Actions": [
            {"user_id": 1, "post_id": 1, "action_date": "2019-07-01", "action": "view", "extra": null},
            {"user_id": 1, "post_id": 1, "action_date": "2019-07-01", "action": "like", "extra": null},
            {"user_id": 1, "post_id": 1, "action_date": "2019-07-01", "action": "share", "extra": null},
            {"user_id": 2, "post_id": 4, "action_date": "2019-07-04", "action": "view", "extra": null},
            {"user_id": 2, "post_id": 4, "action_date": "2019-07-04", "action": "report", "extra": "spam"},
            {"user_id": 3, "post_id": 4, "action_date": "2019-07-04", "action": "view", "extra": null},
            {"user_id": 3, "post_id": 4, "action_date": "2019-07-04", "action": "report", "extra": "spam"},
            {"user_id": 4, "post_id": 3, "action_date": "2019-07-02", "action": "view", "extra": null},
            {"user_id": 4, "post_id": 3, "action_date": "2019-07-02", "action": "report", "extra": "spam"},
            {"user_id": 5, "post_id": 2, "action_date": "2019-07-04", "action": "view", "extra": null},
            {"user_id": 5, "post_id": 2, "action_date": "2019-07-04", "action": "report", "extra": "racism"},
            {"user_id": 5, "post_id": 5, "action_date": "2019-07-04", "action": "view", "extra": null},
            {"user_id": 5, "post_id": 5, "action_date": "2019-07-04", "action": "report", "extra": "racism"}
          ]
        }
      },
      "expected": {
        "columns": ["report_reason", "report_count"],
        "rows": [["spam", 1], ["racism", 2]]
      },
      "validator": {"kind": "unordered_table"},
      "tags": ["sample", "distinct-posts", "source-exact"]
    },
    {
      "id": "trial-one-report",
      "name": "one report produces one reason with one post",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Actions": [
            {"user_id": 7, "post_id": 11, "action_date": "2019-07-04", "action": "report", "extra": "other"}
          ]
        }
      },
      "expected": {
        "columns": ["report_reason", "report_count"],
        "rows": [["other", 1]]
      },
      "validator": {"kind": "unordered_table"},
      "tags": ["single-report", "single-group"]
    },
    {
      "id": "trial-same-post-different-reasons",
      "name": "one post contributes once to each different reason",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Actions": [
            {"user_id": 1, "post_id": 20, "action_date": "2019-07-04", "action": "report", "extra": "spam"},
            {"user_id": 2, "post_id": 20, "action_date": "2019-07-04", "action": "report", "extra": "abuse"}
          ]
        }
      },
      "expected": {
        "columns": ["report_reason", "report_count"],
        "rows": [["spam", 1], ["abuse", 1]]
      },
      "validator": {"kind": "unordered_table"},
      "tags": ["reason-groups", "same-post"]
    },
    {
      "id": "trial-duplicate-reporters",
      "name": "duplicate rows and multiple reporters count one post once",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Actions": [
            {"user_id": 1, "post_id": 30, "action_date": "2019-07-04", "action": "report", "extra": "spam"},
            {"user_id": 1, "post_id": 30, "action_date": "2019-07-04", "action": "report", "extra": "spam"},
            {"user_id": 2, "post_id": 30, "action_date": "2019-07-04", "action": "report", "extra": "spam"},
            {"user_id": 3, "post_id": 31, "action_date": "2019-07-04", "action": "report", "extra": "spam"}
          ]
        }
      },
      "expected": {
        "columns": ["report_reason", "report_count"],
        "rows": [["spam", 2]]
      },
      "validator": {"kind": "unordered_table"},
      "tags": ["duplicate-rows", "distinct-posts", "multiple-reporters"]
    },
    {
      "id": "trial-ignore-nonreports",
      "name": "all five non-report actions on the target date are ignored",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Actions": [
            {"user_id": 1, "post_id": 40, "action_date": "2019-07-04", "action": "view", "extra": "spam"},
            {"user_id": 2, "post_id": 41, "action_date": "2019-07-04", "action": "like", "extra": "spam"},
            {"user_id": 3, "post_id": 42, "action_date": "2019-07-04", "action": "reaction", "extra": "wow"},
            {"user_id": 4, "post_id": 43, "action_date": "2019-07-04", "action": "comment", "extra": "spam"},
            {"user_id": 5, "post_id": 44, "action_date": "2019-07-04", "action": "share", "extra": "spam"},
            {"user_id": 6, "post_id": 45, "action_date": "2019-07-04", "action": "report", "extra": "valid"}
          ]
        }
      },
      "expected": {
        "columns": ["report_reason", "report_count"],
        "rows": [["valid", 1]]
      },
      "validator": {"kind": "unordered_table"},
      "tags": ["action-filter", "enum-domain"]
    },
    {
      "id": "trial-ignore-other-days",
      "name": "reports immediately before and after yesterday are ignored",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Actions": [
            {"user_id": 1, "post_id": 50, "action_date": "2019-07-03", "action": "report", "extra": "spam"},
            {"user_id": 2, "post_id": 51, "action_date": "2019-07-04", "action": "report", "extra": "spam"},
            {"user_id": 3, "post_id": 52, "action_date": "2019-07-05", "action": "report", "extra": "spam"}
          ]
        }
      },
      "expected": {
        "columns": ["report_reason", "report_count"],
        "rows": [["spam", 1]]
      },
      "validator": {"kind": "unordered_table"},
      "tags": ["date-filter", "adjacent-dates", "yesterday"]
    },
    {
      "id": "trial-optional-extra",
      "name": "a null optional extra value forms its own report group",
