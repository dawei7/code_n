{
  "schema_version": 1,
  "challenge_id": "lc_2372",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: multiple customers and salesperson without customers",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Salesperson": [
            {"salesperson_id": 1, "name": "Alice"},
            {"salesperson_id": 2, "name": "Bob"},
            {"salesperson_id": 3, "name": "Jerry"}
          ],
          "Customer": [
            {"customer_id": 1, "salesperson_id": 1},
            {"customer_id": 2, "salesperson_id": 1},
            {"customer_id": 3, "salesperson_id": 2}
          ],
          "Sales": [
            {"sale_id": 1, "customer_id": 2, "price": 892},
            {"sale_id": 2, "customer_id": 1, "price": 354},
            {"sale_id": 3, "customer_id": 3, "price": 988},
            {"sale_id": 4, "customer_id": 3, "price": 856}
          ]
        }
      },
      "expected": {
        "columns": ["salesperson_id", "name", "total"],
        "rows": [[1, "Alice", 1246], [2, "Bob", 1844], [3, "Jerry", 0]]
      },
      "tags": ["sample", "aggregation"]
    },
    {
      "id": "trial-no-customers",
      "name": "salesperson without customers has zero influence",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Salesperson": [
            {"salesperson_id": 7, "name": "Noah"},
            {"salesperson_id": 8, "name": "Ava"}
          ],
          "Customer": [{"customer_id": 1, "salesperson_id": 8}],
          "Sales": [{"sale_id": 1, "customer_id": 1, "price": 5}]
        }
      },
      "expected": {
        "columns": ["salesperson_id", "name", "total"],
        "rows": [[7, "Noah", 0], [8, "Ava", 5]]
      },
      "tags": ["empty", "left-join"]
    },
    {
