      }},
      "expected": {"columns": ["employee_id", "name", "improvement_score"], "rows": []},
      "validator": {"kind": "ordered_table"},
      "tags": ["trial", "insufficient-history", "empty-output"]
    },
    {
      "id": "real-older-decline-ignored",
