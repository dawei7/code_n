{
  "schema_version": 1,
  "challenge_id": "lc_2217",
  "cases": [
    {
      "id": "sample-odd-length",
      "name": "sample: ranked three-digit palindromes",
      "kind": "sample",
      "visible": true,
      "input": {
        "queries": [
          1,
          2,
          3,
          4,
          5,
          90
        ],
        "intLength": 3
      },
      "expected": [
        101,
        111,
        121,
        131,
        141,
        999
      ],
      "tags": [
        "sample",
        "odd-length"
      ]
    },
    {
      "id": "sample-even-length",
      "name": "sample: ranked four-digit palindromes",
      "kind": "sample",
      "visible": true,
      "input": {
        "queries": [
          2,
          4,
          6
        ],
        "intLength": 4
      },
      "expected": [
        1111,
        1331,
        1551
      ],
      "tags": [
        "sample",
        "even-length"
      ]
    },
    {
      "id": "trial-one-digit-boundary",
      "name": "single-digit ranks stop after nine",
      "kind": "trial",
      "visible": true,
      "input": {
        "queries": [
          1,
          9,
          10
        ],
        "intLength": 1
      },
      "expected": [
        1,
        9,
        -1
      ],
      "tags": [
        "one-digit",
        "out-of-range"
      ]
    },
    {
      "id": "trial-two-digits",
      "name": "two-digit palindromes mirror one digit",
      "kind": "trial",
      "visible": true,
      "input": {
        "queries": [
          1,
          5,
          9,
          10
        ],
        "intLength": 2
      },
      "expected": [
        11,
        55,
        99,
        -1
      ],
      "tags": [
        "even-length",
        "boundary"
      ]
    },
    {
      "id": "trial-last-and-overflow",
      "name": "final legal prefix and next rank",
      "kind": "trial",
      "visible": true,
      "input": {
        "queries": [
          900,
          901
        ],
        "intLength": 5
      },
      "expected": [
        99999,
        -1
      ],
      "tags": [
        "range-boundary"
      ]
    },
    {
      "id": "trial-query-order",
      "name": "answers preserve arbitrary query order",
      "kind": "trial",
      "visible": true,
      "input": {
        "queries": [
          10,
          1,
          3,
          10
        ],
        "intLength": 3
      },
      "expected": [
        191,
        101,
        121,
        191
      ],
      "tags": [
        "query-order"
      ]
    },
    {
      "id": "trial-large-length",
      "name": "fifteen-digit construction stays exact",
      "kind": "trial",
      "visible": true,
      "input": {
        "queries": [
          1,
          2
        ],
        "intLength": 15
      },
      "expected": [
        100000000000001,
        100000010000001
      ],
      "tags": [
        "large-length"
      ]
    },
    {
      "id": "trial-huge-rank",
      "name": "a huge rank can be rejected directly",
      "kind": "trial",
      "visible": true,
      "input": {
        "queries": [
          1000000000
        ],
        "intLength": 7
      },
      "expected": [
        -1
      ],
      "tags": [
        "large-query"
      ]
    }
  ]
}