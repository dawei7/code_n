{
  "schema_version": 1,
  "challenge_id": "lc_2416",
  "cases": [
    {
      "id": "sample-shared-prefixes",
      "name": "sample: shared abc and b prefixes",
      "kind": "sample",
      "visible": true,
      "input": {
        "words": [
          "abc",
          "ab",
          "bc",
          "b"
        ]
      },
      "expected": [
        5,
        4,
        3,
        2
      ],
      "tags": [
        "sample",
        "trie"
      ]
    },
    {
      "id": "sample-single-word",
      "name": "sample: every prefix occurs once",
      "kind": "sample",
      "visible": true,
      "input": {
        "words": [
          "abcd"
        ]
      },
      "expected": [
        4
      ],
      "tags": [
        "sample"
      ]
    },
    {
      "id": "trial-nested-prefixes",
      "name": "nested words share increasingly few prefixes",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "a",
          "aa",
          "aaa"
        ]
      },
      "expected": [
        3,
        5,
        6
      ],
      "tags": [
        "nested"
      ]
    },
    {
      "id": "trial-disjoint",
      "name": "disjoint first letters share no prefix",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "z",
          "x",
          "y"
        ]
      },
      "expected": [
        1,
        1,
        1
      ],
      "tags": [
        "disjoint"
      ]
    },
    {
      "id": "trial-duplicates",
      "name": "duplicate words count as separate entries",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "abc",
          "abc"
        ]
      },
      "expected": [
        6,
        6
      ],
      "tags": [
        "duplicates"
      ]
    },
    {
      "id": "real-branching",
      "name": "words branch after a shared prefix",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "apple",
          "ape",
          "april"
        ]
      },
      "expected": [
        9,
        7,
        9
      ],
      "tags": [
        "branching"
      ]
    },
    {
      "id": "real-one-letter-duplicates",
      "name": "duplicate one-letter words",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "a",
          "a",
          "b"
        ]
      },
      "expected": [
        2,
        2,
        1
      ],
      "tags": [
        "duplicates"
      ]
    },
    {
      "id": "real-late-branch",
      "name": "words differ only at the final character",
      "kind": "trial",
      "visible": true,
      "input": {
        "words": [
          "aaaa",
          "aaab"
        ]
      },
      "expected": [
        7,
        7
      ],
      "tags": [
        "late-branch"
      ]
    }
  ]
}