{
  "schema_version": 1,
  "challenge_id": "lc_339",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: sibling lists around an integer",
      "kind": "sample",
      "visible": true,
      "input": {"nestedList": [[1, 1], 2, [1, 1]]},
      "expected": 10,
      "tags": ["sample", "source-example"]
    },
    {
      "id": "sample-2",
      "name": "sample: three distinct depths",
      "kind": "sample",
      "visible": true,
      "input": {"nestedList": [1, [4, [6]]]},
      "expected": 27,
      "tags": ["sample", "source-example", "depth"]
    },
    {
      "id": "sample-3",
      "name": "sample: zero",
      "kind": "sample",
      "visible": true,
      "input": {"nestedList": [0]},
      "expected": 0,
      "tags": ["sample", "source-example", "zero", "minimum-length"]
    },
    {
      "id": "trial-negative",
      "name": "negative values retain their sign at every depth",
      "kind": "trial",
      "visible": true,
      "input": {"nestedList": [-1, [2, [-3]]]},
      "expected": -6,
      "tags": ["negative", "mixed-sign", "depth"]
    },
    {
      "id": "trial-empty-branches",
      "name": "empty nested lists contribute nothing",
      "kind": "trial",
      "visible": true,
      "input": {"nestedList": [[], [[]], 5]},
      "expected": 5,
      "tags": ["empty-nested-list", "mixed"]
    },
    {
      "id": "trial-mixed-branches",
      "name": "values across several branches use their own depths",
      "kind": "trial",
      "visible": true,
      "input": {"nestedList": [5, [1, 1], [[2]], 3]},
      "expected": 18,
      "tags": ["mixed-branches", "depth"]
    },
    {
      "id": "trial-deep-zero",
      "name": "zero between nonzero depths does not stop traversal",
      "kind": "trial",
      "visible": true,
      "input": {"nestedList": [1, [0, [2]]]},
      "expected": 7,
      "tags": ["zero", "depth"]
    },
    {
      "id": "trial-maximum-outer-length",
      "name": "maximum outer length alternates both integer bounds",
      "kind": "trial",
      "visible": true,
      "input": {
        "nestedList": [100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100]
      },
      "expected": 0,
      "tags": ["maximum-length", "minimum-value", "maximum-value"]
    },
    {
      "id": "trial-maximum-depth",
      "name": "minimum integer at maximum depth",
      "kind": "trial",
      "visible": true,
      "input": {
        "nestedList": [[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[-100]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]
      },
      "expected": -5000,
      "tags": ["maximum-depth", "minimum-value", "deeply-nested"]
    }
  ]
