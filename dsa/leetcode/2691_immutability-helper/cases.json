{
  "schema_version": 1,
  "challenge_id": "lc_2691",
  "cases": [
    {
      "id": "sample-independent",
      "name": "sample: produce calls start from the same original",
      "kind": "sample",
      "visible": true,
      "input": {
        "obj": {
          "val": 10
        },
        "mutations": [
          [
            {
              "path": [
                "val"
              ],
              "value": 11
            }
          ],
          [
            {
              "path": [
                "val"
              ],
              "value": 9
            }
          ]
        ]
      },
      "expected": [
        {
          "val": 11
        },
        {
          "val": 9
        }
      ],
      "tags": [
        "sample",
        "independent-calls"
      ]
    },
    {
      "id": "sample-array-and-key",
      "name": "sample: nested array edit and new root key",
      "kind": "sample",
      "visible": true,
      "input": {
        "obj": {
          "arr": [
            1,
            2,
            3
          ]
        },
        "mutations": [
          [
            {
              "path": [
                "arr",
                0
              ],
              "value": 5
            },
            {
              "path": [
                "newVal"
              ],
              "value": 7
            }
          ]
        ]
      },
      "expected": [
        {
          "arr": [
            5,
            2,
            3
          ],
          "newVal": 7
        }
      ],
      "tags": [
        "sample",
        "array",
        "new-key"
      ]
    },
    {
      "id": "sample-swap-values",
      "name": "sample: two nested primitive assignments",
      "kind": "sample",
      "visible": true,
      "input": {
        "obj": {
          "obj": {
            "val": {
              "x": 10,
              "y": 20
            }
          }
        },
        "mutations": [
          [
            {
              "path": [
                "obj",
                "val",
                "x"
              ],
              "value": 20
            },
            {
              "path": [
                "obj",
                "val",
                "y"
              ],
              "value": 10
            }
          ]
        ]
      },
      "expected": [
        {
          "obj": {
            "val": {
              "x": 20,
              "y": 10
            }
          }
        }
      ],
      "tags": [
        "sample",
        "deep"
      ]
    },
    {
      "id": "trial-no-op",
      "name": "trial: empty mutator preserves the value",
      "kind": "trial",
      "visible": true,
      "input": {
        "obj": {
          "a": 1,
          "nested": {
            "b": 2
          }
        },
        "mutations": [
          []
        ]
      },
      "expected": [
        {
          "a": 1,
          "nested": {
            "b": 2
          }
        }
      ],
      "tags": [
        "no-op"
      ]
    },
    {
      "id": "trial-array-root",
      "name": "trial: root array is shallow-copied on edit",
      "kind": "trial",
      "visible": true,
      "input": {
        "obj": [
          1,
          {
            "x": 2
          },
          3
        ],
        "mutations": [
          [
            {
              "path": [
                1,
                "x"
              ],
              "value": 8
            }
          ]
        ]
      },
      "expected": [
        [
          1,
          {
            "x": 8
          },
          3
        ]
      ],
      "tags": [
        "array-root"
      ]
    },
    {
      "id": "real-sibling-sharing",
      "name": "deep edit preserves sibling values",
      "kind": "trial",
      "visible": true,
      "input": {
        "obj": {
          "left": {
            "deep": {
              "value": 1
            },
            "sibling": "keep"
          },
          "right": {
            "large": [
              1,
              2,
              3,
              4
            ]
          }
        },
        "mutations": [
          [
            {
              "path": [
                "left",
                "deep",
                "value"
              ],
              "value": 99
            }
          ]
        ]
      },
      "expected": [
        {
          "left": {
            "deep": {
              "value": 99
            },
            "sibling": "keep"
          },
          "right": {
            "large": [
              1,
              2,
              3,
              4
            ]
          }
        }
      ],
      "tags": [
        "structural-sharing"
      ]
    },
    {
      "id": "real-repeated-path",
      "name": "later assignment in one batch wins",
      "kind": "trial",
      "visible": true,
      "input": {
        "obj": {
          "a": {
            "b": 1
          }
        },
        "mutations": [
          [
            {
              "path": [
                "a",
                "b"
              ],
              "value": 2
            },
            {
              "path": [
                "a",
                "b"
              ],
              "value": 3
            }
          ]
        ]
      },
      "expected": [
        {
          "a": {
            "b": 3
          }
        }
      ],
      "tags": [
        "repeated-write"
      ]
    }
  ]
}