    {
      "id": "sample-1",
      "name": "sample: duplicate mismatched item counts once and sellers tie",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Users": [
            {
              "seller_id": 1,
              "join_date": "2019-01-01",
