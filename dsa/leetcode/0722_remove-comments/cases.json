{
  "schema_version": 1,
  "challenge_id": "lc_722",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: line comment preserves preceding spaces",
      "kind": "sample",
      "visible": true,
      "input": {
        "source": [
          "int main() {",
          "  // declaration",
          "int x = 1;",
          "}"
        ]
      },
      "expected": [
        "int main() {",
        "  ",
        "int x = 1;",
        "}"
      ],
      "tags": [
        "sample",
        "line-comment"
      ]
    },
    {
      "id": "sample-2",
      "name": "sample: block spans lines",
      "kind": "sample",
      "visible": true,
      "input": {
        "source": [
          "a/* comment",
          "continued */b"
        ]
      },
      "expected": [
        "ab"
      ],
      "tags": [
        "sample",
        "multiline-block"
      ]
    },
    {
      "id": "sample-3",
      "name": "sample: multiple blocks on one line",
      "kind": "sample",
      "visible": true,
      "input": {
        "source": [
          "x/*one*/y/*two*/z"
        ]
      },
      "expected": [
        "xyz"
      ],
      "tags": [
        "sample",
        "multiple-blocks"
      ]
    },
    {
      "id": "trial-1",
      "name": "trial: block then line comment",
      "kind": "trial",
      "visible": true,
      "input": {
        "source": [
          "a/*x*/b//ignored",
          "next"
        ]
      },
      "expected": [
        "ab",
        "next"
      ],
      "tags": [
        "trial",
        "delimiter-precedence"
      ]
    },
    {
      "id": "trial-2",
      "name": "trial: comment-only lines disappear",
      "kind": "trial",
      "visible": true,
      "input": {
        "source": [
          "// all",
          "/* block */",
          "ok"
        ]
      },
      "expected": [
        "ok"
      ],
      "tags": [
        "trial",
        "empty-lines"
      ]
    },
    {
      "id": "trial-ext-1",
      "name": "comment markers inside block are ignored",
      "kind": "trial",
      "visible": true,
      "input": {
        "source": [
          "left/* // still block",
          "more /* text */right"
        ]
      },
      "expected": [
        "leftright"
      ],
      "tags": [
        "markers-inside-block"
      ]
    },
    {
      "id": "trial-ext-2",
      "name": "separated symbols are ordinary text",
      "kind": "trial",
      "visible": true,
      "input": {
        "source": [
          "/ * not a comment * /",
          "code"
        ]
      },
      "expected": [
        "/ * not a comment * /",
        "code"
      ],
      "tags": [
        "non-delimiters"
      ]
    },
    {
      "id": "trial-3",
      "name": "block closes before line comment",
      "kind": "trial",
      "visible": true,
      "input": {
        "source": [
          "pre/*a",
          "b*/post//tail",
          "last"
        ]
      },
      "expected": [
        "prepost",
        "last"
      ],
      "tags": [
        "cross-line-buffer"
      ]
    },
    {
      "id": "trial-boundary-9",
      "name": "single element in source",
      "kind": "trial",
      "visible": true,
      "input": {
        "source": [
          "int main() {"
        ]
      },
      "expected": [
        "int main() {"
      ],
      "tags": [
        "boundary",
        "single-element"
      ]
    },
    {
      "id": "trial-boundary-10",
      "name": "identical elements in source",
      "kind": "trial",
      "visible": true,
      "input": {
        "source": [
          "int main() {",
          "int main() {"
        ]
      },
      "expected": [
        "int main() {",
        "int main() {"
      ],
      "tags": [
        "boundary",
        "duplicates"
      ]
    }
  ]
}