{
  "schema_version": 1,
  "challenge_id": "lc_1813",
  "cases": [
    {
      "id": "example-middle-insertion",
      "name": "sample: insert two words in the middle",
      "kind": "sample",
      "visible": true,
      "input": {
        "sentence1": "My name is Haley",
        "sentence2": "My Haley"
      },
      "expected": true,
      "tags": [
        "example",
        "middle-insertion"
      ]
    },
    {
      "id": "example-interior-only-match",
      "name": "sample: interior word match is insufficient",
      "kind": "sample",
      "visible": true,
      "input": {
        "sentence1": "of",
        "sentence2": "A lot of words"
      },
      "expected": false,
      "tags": [
        "example",
        "interior-match"
      ]
    },
    {
      "id": "example-end-insertion",
      "name": "sample: append words to the shorter sentence",
      "kind": "sample",
      "visible": true,
      "input": {
        "sentence1": "Eating right now",
        "sentence2": "Eating"
      },
      "expected": true,
      "tags": [
        "example",
        "end-insertion"
      ]
    },
    {
      "id": "trial-identical",
      "name": "empty insertion preserves identical sentences",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence1": "One Same Sentence",
        "sentence2": "One Same Sentence"
      },
      "expected": true,
      "tags": [
        "empty-insertion",
        "identical"
      ]
    },
    {
      "id": "trial-beginning-insertion",
      "name": "prepend words before a matching suffix",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence1": "we agree",
        "sentence2": "Today surely we agree"
      },
      "expected": true,
      "tags": [
        "beginning-insertion",
        "suffix"
      ]
    },
    {
      "id": "trial-whole-word-boundary",
      "name": "characters cannot be inserted inside a word",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence1": "Frog cool",
        "sentence2": "Frogs are cool"
      },
      "expected": false,
      "tags": [
        "word-boundary",
        "character-trap"
      ]
    },
    {
      "id": "trial-unmatched-two-regions",
      "name": "mismatches on both sides cannot form one block",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence1": "A B C",
        "sentence2": "A X C Y"
      },
      "expected": false,
      "tags": [
        "two-regions",
        "single-insertion"
      ]
    },
    {
      "id": "trial-parameter-swap",
      "name": "either input may be the shorter sentence",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence1": "Start End",
        "sentence2": "Start several new words End"
      },
      "expected": true,
      "tags": [
        "parameter-order",
        "middle-insertion"
      ]
    },
    {
      "id": "trial-repeated-overlap",
      "name": "repeated words do not double-count one position",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence1": "A B A",
        "sentence2": "A B B A"
      },
      "expected": true,
      "tags": [
        "repeated-words",
        "pointer-overlap"
      ]
    },
    {
      "id": "trial-case-sensitive",
      "name": "capitalization changes word identity",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence1": "Hello World",
        "sentence2": "hello bright World"
      },
      "expected": false,
      "tags": [
        "case-sensitive"
      ]
    },
    {
      "id": "trial-single-word-prefix",
      "name": "a single first word can anchor an appended block",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence1": "Only",
        "sentence2": "Only many more words"
      },
      "expected": true,
      "tags": [
        "single-word",
        "prefix"
      ]
    },
    {
      "id": "trial-maximum-length",
      "name": "maximum-length repeated-word sentence",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence1": "a a",
        "sentence2": "a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a"
      },
      "expected": true,
      "tags": [
        "maximum-length",
        "repeated-words"
      ]
    },
    {
      "id": "trial-boundary-13",
      "name": "single character in sentence1",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence1": "M",
        "sentence2": "My Haley"
      },
      "expected": false,
      "tags": [
        "boundary",
        "single-char"
      ]
    },
    {
      "id": "trial-boundary-14",
      "name": "repeated character in sentence1",
      "kind": "trial",
      "visible": true,
      "input": {
        "sentence1": "MMM",
        "sentence2": "My Haley"
      },
      "expected": false,
      "tags": [
        "boundary",
        "repeated"
      ]
    }
  ]
}