{
  "schema_version": 1,
  "challenge_id": "lc_2133",
  "cases": [
    {
      "id": "sample-valid-three",
      "name": "sample: every row and column is a permutation",
      "kind": "sample",
      "visible": true,
      "input": {
        "matrix": [
          [
            1,
            2,
            3
          ],
          [
            3,
            1,
            2
          ],
          [
            2,
            3,
            1
          ]
        ]
      },
      "expected": true,
      "tags": [
        "sample",
        "valid"
      ]
    },
    {
      "id": "sample-duplicates",
      "name": "sample: repeated ones invalidate rows and columns",
      "kind": "sample",
      "visible": true,
      "input": {
        "matrix": [
          [
            1,
            1,
            1
          ],
          [
            1,
            2,
            3
          ],
          [
            1,
            2,
            3
          ]
        ]
      },
      "expected": false,
      "tags": [
        "sample",
        "duplicates"
      ]
    },
    {
      "id": "trial-single-cell",
      "name": "the one-by-one matrix is valid",
      "kind": "trial",
      "visible": true,
      "input": {
        "matrix": [
          [
            1
          ]
        ]
      },
      "expected": true,
      "tags": [
        "minimum-size"
      ]
    },
    {
      "id": "trial-row-valid-column-invalid",
      "name": "valid rows can still produce duplicate columns",
      "kind": "trial",
      "visible": true,
      "input": {
        "matrix": [
          [
            1,
            2
          ],
          [
            1,
            2
          ]
        ]
      },
      "expected": false,
      "tags": [
        "column-failure"
      ]
    },
    {
      "id": "trial-column-valid-row-invalid",
      "name": "columns can be valid while rows repeat",
      "kind": "trial",
      "visible": true,
      "input": {
        "matrix": [
          [
            1,
            1
          ],
          [
            2,
            2
          ]
        ]
      },
      "expected": false,
      "tags": [
        "row-failure"
      ]
    },
    {
      "id": "trial-valid-four",
      "name": "cyclic four-by-four matrix is valid",
      "kind": "trial",
      "visible": true,
      "input": {
        "matrix": [
          [
