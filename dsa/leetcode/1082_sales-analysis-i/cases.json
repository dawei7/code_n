      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Product": [
            {"product_id": 1, "product_name": "Bulk", "unit_price": 1}
          ],
          "Sales": [
            {"seller_id": 4, "product_id": 1, "buyer_id": 1, "sale_date": "2020-02-01", "quantity": 100, "price": 10},
            {"seller_id": 7, "product_id": 1, "buyer_id": 2, "sale_date": "2020-02-02", "quantity": 1, "price": 11}
          ]
        }
      },
      "expected": {
        "columns": ["seller_id"],
        "rows": [[7]]
      },
      "tags": ["trial", "price-semantics", "quantity"]
    },
    {
      "id": "trial-three-way-tie",
      "name": "retain every seller in a three-way maximum tie",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Product": [
            {"product_id": 1, "product_name": "Same", "unit_price": 5}
