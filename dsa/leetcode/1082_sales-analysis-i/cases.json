{
  "schema_version": 1,
  "challenge_id": "lc_1082",
  "cases": [
    {
      "id": "sample-1",
      "name": "sample: two sellers tie for greatest total",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Product": [
            {"product_id": 1, "product_name": "S8", "unit_price": 1000},
            {"product_id": 2, "product_name": "G4", "unit_price": 800},
            {"product_id": 3, "product_name": "iPhone", "unit_price": 1400}
          ],
          "Sales": [
            {"seller_id": 1, "product_id": 1, "buyer_id": 1, "sale_date": "2019-01-21", "quantity": 2, "price": 2000},
            {"seller_id": 1, "product_id": 2, "buyer_id": 2, "sale_date": "2019-02-17", "quantity": 1, "price": 800},
            {"seller_id": 2, "product_id": 2, "buyer_id": 3, "sale_date": "2019-06-02", "quantity": 1, "price": 800},
            {"seller_id": 3, "product_id": 3, "buyer_id": 4, "sale_date": "2019-05-13", "quantity": 2, "price": 2800}
          ]
        }
      },
      "expected": {
        "columns": ["seller_id"],
        "rows": [[1], [3]]
      },
      "tags": ["sample", "ties"]
    },
    {
      "id": "trial-single-seller",
      "name": "single represented seller",
      "kind": "trial",
      "visible": true,
      "input": {
        "tables": {
          "Product": [
            {"product_id": 5, "product_name": "Only", "unit_price": 7}
          ],
          "Sales": [
            {"seller_id": 9, "product_id": 5, "buyer_id": 1, "sale_date": "2020-01-01", "quantity": 3, "price": 21}
          ]
        }
      },
      "expected": {
        "columns": ["seller_id"],
        "rows": [[9]]
      },
      "tags": ["trial", "single-seller"]
    },
