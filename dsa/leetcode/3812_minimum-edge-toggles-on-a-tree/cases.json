      "input": {"n": 3, "edges": [[0, 1], [1, 2]], "start": "010", "target": "100"},
      "expected": [0],
      "validator": {"kind": "exact"},
      "tags": ["sample", "one-edge", "path"]
    },
    {
      "id": "sample-three-edges",
      "name": "sample: three indexed tree edges produce the target",
