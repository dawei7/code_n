    {
      "id": "sample-1",
      "name": "sample: carry drinks across two null runs",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "CoffeeShop": [
            {
              "id": 9,
              "drink": "Rum and Coke"
            },
            {
              "id": 6,
              "drink": null
            },
            {
              "id": 7,
              "drink": null
            },
            {
              "id": 3,
              "drink": "St Germain Spritz"
            },
            {
              "id": 1,
              "drink": "Orange Margarita"
            },
            {
              "id": 2,
              "drink": null
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "id",
          "drink"
        ],
        "rows": [
          [
            9,
            "Rum and Coke"
          ],
          [
            6,
            "Rum and Coke"
          ],
          [
            7,
            "Rum and Coke"
          ],
          [
            3,
            "St Germain Spritz"
          ],
          [
            1,
            "Orange Margarita"
          ],
          [
            2,
            "Orange Margarita"
          ]
        ]
      },
      "tags": [
        "sample",
        "consecutive-nulls"
      ]
    },
