  "cases": [
    {
      "id": "sample-path-update",
      "name": "sample: an update changes a full path from valid to invalid",
      "kind": "sample",
      "visible": true,
      "input": {
        "n": 3,
        "edges": [
          [
            0,
            1
          ],
          [
            1,
            2
          ]
        ],
        "s": "aac",
        "queries": [
          "query 0 2",
          "update 1 b",
          "query 0 2"
        ]
      },
      "expected": [
        true,
        false
      ],
      "validator": {
        "kind": "exact"
      },
      "tags": [
        "sample",
        "path-query",
        "update"
      ]
    },
    {
