        ],
        "queries": [
          "a",
          "a-b"
        ]
      },
      "expected": [
        0,
        0
      ],
      "tags": [
        "trial",
        "no-words",
        "separators"
      ]
    },
    {
      "id": "trial-double-then-joiner",
      "name": "trial: a double hyphen separates before a valid joined word",
