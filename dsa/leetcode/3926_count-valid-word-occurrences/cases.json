        0
      ],
      "tags": [
        "trial",
        "chunk-boundary",
        "joiner-hyphen"
      ]
    },
    {
      "id": "trial-hyphen-right-chunk",
      "name": "trial: a leading chunk hyphen becomes a joiner",
