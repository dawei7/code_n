{
  "schema_version": 1,
  "challenge_id": "lc_3926",
  "cases": [
    {
      "id": "sample-complete-words-only",
      "name": "sample: count complete words after chunk concatenation",
      "kind": "sample",
      "visible": true,
      "input": {
        "chunks": [
          "hello wor",
          "ld hello"
        ],
        "queries": [
          "hello",
          "world",
          "wor"
        ]
      },
      "expected": [
        2,
        1,
        0
      ],
      "tags": [
        "sample",
        "chunk-concatenation",
        "substring-trap"
      ]
    },
    {
      "id": "sample-joiner-and-double-hyphens",
      "name": "sample: joiner hyphens survive while double hyphens separate",
      "kind": "sample",
      "visible": true,
      "input": {
        "chunks": [
          "a-b a--b ",
          "a-",
          "b"
        ],
        "queries": [
          "a-b",
          "a",
          "b"
        ]
      },
      "expected": [
        2,
        1,
        1
      ],
      "tags": [
        "sample",
        "joiner-hyphen",
        "consecutive-hyphens"
      ]
    },
    {
      "id": "sample-leading-and-trailing-hyphens",
      "name": "sample: edge hyphens act as separators",
      "kind": "sample",
      "visible": true,
      "input": {
        "chunks": [
          "-cat dog- mouse"
        ],
        "queries": [
          "cat",
          "dog",
          "mouse",
          "cat-dog"
        ]
      },
      "expected": [
        1,
        1,
        1,
        0
      ],
      "tags": [
        "sample",
        "edge-hyphens",
        "separators"
      ]
    },
    {
      "id": "trial-letters-join-across-chunks",
      "name": "trial: adjacent chunk letters form one word",
      "kind": "trial",
      "visible": true,
      "input": {
        "chunks": [
          "ab",
          "cd"
        ],
        "queries": [
          "abcd",
          "ab",
          "cd"
        ]
      },
      "expected": [
        1,
        0,
        0
      ],
      "tags": [
        "trial",
        "chunk-boundary",
        "maximal-word"
      ]
    },
    {
      "id": "trial-hyphen-left-chunk",
      "name": "trial: a trailing chunk hyphen becomes a joiner",
