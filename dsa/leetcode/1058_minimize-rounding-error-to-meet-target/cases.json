{
  "challenge_id": "lc_1058",
  "cases": [
    {
      "id": "sample-1",
      "name": "source example 1: mixed floor and ceiling choices",
      "kind": "sample",
      "visible": true,
      "input": {
        "prices": [
          "0.700",
          "2.800",
          "4.900"
        ],
        "target": 8
      },
      "expected": "1.000",
      "tags": [
        "sample",
        "source-example",
        "greedy"
      ]
    },
    {
      "id": "sample-2",
      "name": "source example 2: target above the ceiling sum",
      "kind": "sample",
      "visible": true,
      "input": {
        "prices": [
          "1.500",
          "2.500",
          "3.500"
        ],
        "target": 10
      },
      "expected": "-1",
      "tags": [
        "sample",
        "source-example",
        "impossible"
      ]
    },
    {
      "id": "sample-3",
      "name": "source example 3: every price rounds upward",
      "kind": "sample",
      "visible": true,
      "input": {
        "prices": [
          "1.500",
          "2.500",
          "3.500"
        ],
        "target": 9
      },
      "expected": "1.500",
      "tags": [
        "sample",
        "source-example",
        "all-ceilings"
      ]
    },
    {
      "id": "trial-all-integers",
      "name": "integral prices have zero error",
      "kind": "trial",
      "visible": true,
      "input": {
        "prices": [
          "0.000",
          "2.000",
          "1000.000"
        ],
        "target": 1002
      },
      "expected": "0.000",
      "tags": [
        "trial",
        "integer",
        "price-bounds",
        "zero-error"
      ]
    },
    {
      "id": "trial-below-floor",
      "name": "target below the floor sum",
      "kind": "trial",
      "visible": true,
      "input": {
        "prices": [
          "3.100",
          "4.200"
        ],
        "target": 6
      },
      "expected": "-1",
      "tags": [
        "trial",
        "impossible",
        "below-floor"
      ]
    },
    {
      "id": "trial-largest-fractions",
      "name": "the largest fractions are rounded upward",
      "kind": "trial",
      "visible": true,
      "input": {
        "prices": [
          "1.100",
          "1.200",
          "1.800",
          "1.900"
        ],
        "target": 6
      },
      "expected": "0.600",
      "tags": [
        "trial",
        "greedy-selection"
      ]
    },
    {
      "id": "trial-equal-fractions",
      "name": "equal fractional errors may be chosen in any order",
      "kind": "trial",
      "visible": true,
      "input": {
        "prices": [
          "0.500",
          "1.500",
          "2.500",
          "3.500"
        ],
        "target": 8
      },
      "expected": "2.000",
      "tags": [
        "trial",
        "fraction-tie"
      ]
    },
    {
      "id": "trial-thousandths-precision",
      "name": "the result preserves exact thousandths",
      "kind": "trial",
      "visible": true,
      "input": {
        "prices": [
          "0.001",
          "0.499",
          "0.500",
          "0.999"
        ],
        "target": 2
      },
      "expected": "1.001",
      "tags": [
        "trial",
        "precision",
        "formatting"
      ]
    },
    {
      "id": "trial-zero-target",
      "name": "a zero target is feasible when every price rounds down",
      "kind": "trial",
      "visible": true,
      "input": {
        "prices": [
          "0.001",
          "0.002",
          "0.003"
        ],
        "target": 0
