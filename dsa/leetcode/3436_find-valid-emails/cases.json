    {
      "id": "sample-official",
      "name": "sample: official email rows",
      "kind": "sample",
      "visible": true,
      "input": {
        "tables": {
          "Users": [
            {
              "user_id": 1,
              "email": "alice@example.com"
            },
            {
              "user_id": 2,
              "email": "bob_at_example.com"
            },
            {
              "user_id": 3,
              "email": "charlie@example.net"
            },
            {
              "user_id": 4,
              "email": "david@domain.com"
            },
            {
              "user_id": 5,
              "email": "eve@invalid"
            }
          ]
        }
      },
      "expected": {
        "columns": [
          "user_id",
          "email"
        ],
        "rows": [
          [
            1,
            "alice@example.com"
          ],
          [
            4,
            "david@domain.com"
          ]
        ]
      },
      "tags": [
        "sample"
      ]
    },
